---
// "Cómo trabajamos": qué pasa después de pedir una cotización. La claridad del proceso es de
// lo que más valora un comprador B2B cuando no hay precios publicados (NN/G, B2B usability).
import Pendiente from './Pendiente.astro';
import { ejemploProceso } from '../data/ejemplos';

interface Props {
	titulo?: string;
	compacto?: boolean;
}
const { titulo = 'Cómo trabajamos', compacto = false } = Astro.props;
---

<div class:list={['proceso', { compacto }]}>
	{!compacto && <p class="etiqueta">Proceso</p>}
	<h2>{titulo}</h2>
	<ol class="pasos">
		{
			ejemploProceso.map((p, i) => (
				<li>
					<span class="numero" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3>
						<Pendiente texto="paso del proceso (confirmar)">{p.titulo}</Pendiente>
					</h3>
					<p>
						<Pendiente texto="descripción del paso">{p.texto}</Pendiente>
					</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	h2 {
		margin-bottom: 2.5rem;
	}
	.compacto h2 {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
		margin-bottom: 1.5rem;
	}
	.pasos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		counter-reset: paso;
	}
	.compacto .pasos {
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
	}
	li {
		position: relative;
		padding-top: 1.25rem;
		border-top: 2px solid var(--lols-carbon);
	}
	.compacto li {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		column-gap: 0.75rem;
		padding: 1rem 0;
		border-top: 1px solid var(--linea);
	}
	.numero {
		display: block;
		margin-bottom: 0.75rem;
		font-family: var(--fuente-titulos);
		font-size: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--lols-verde);
	}
	.compacto .numero {
		grid-row: span 2;
		font-size: 1.25rem;
		margin: 0.1rem 0 0;
	}
	h3 {
		margin-bottom: 0.4rem;
	}
	.compacto h3 {
		font-size: 1.05rem;
		margin-bottom: 0.15rem;
	}
	li p {
		margin: 0;
		color: var(--lols-gris);
	}
	@media (max-width: 960px) {
		.pasos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
	}
	@media (max-width: 560px) {
		.pasos {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
