---
// Pictogramas LOLS: servicios y tipos de obra dibujados con la gramática del isotipo (losas
// horizontales, muro macizo, ventanas en contorno, zócalo). Solo ángulos rectos, como el logo.
// Idea tomada de BIG (un pictograma por proyecto) y de Mott MacDonald (todo el sistema gráfico
// sale de la forma del logo). Grilla de 24; macizos en `fill`, contornos con trazo de 1,5.
// Los dibujos están en src/data/pictogramas.ts (también los usa el editor visual).
import { piezasPictograma, type NombrePictograma } from '../data/pictogramas';

interface Props {
	nombre: NombrePictograma;
	class?: string;
	ed?: string; // marca del editor visual (data-ed-picto, docs/editor-visual.md): '/tipo'
}
const { nombre, class: clase, ed } = Astro.props;

const { macizos, contornos, trazo } = piezasPictograma(nombre);
---

<svg class:list={['pictograma', clase]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-ed-picto={ed}>
	<g fill="currentColor">
		{macizos.map((r) => <rect x={r.x} y={r.y} width={r.width} height={r.height} />)}
	</g>
	<g fill="none" stroke="currentColor" stroke-width="1.5">
		{contornos.map((r) => <rect x={r.x} y={r.y} width={r.width} height={r.height} />)}
		{trazo && <path d={trazo} stroke-width="2" stroke-linecap="square" />}
	</g>
</svg>
