---
// Hero de la portada: la obra en video ocupa la primera pantalla y el mensaje va encima,
// abajo a la izquierda (lo primero que se ve es la obra, no un bloque de texto). Un velo
// degradado desde abajo asegura la lectura sobre cualquier cuadro del video. Encima, los ejes
// del plano se trazan al cargar y quedan muy tenues (animaciones.css).
// El contenido (título, bajada, botones) llega por el slot desde la página. Con `centrado` va
// al medio (la portada, Marcos 20-10-2026); las páginas interiores lo dejan a la izquierda.
// Slot "pie" (la portada, 20-10-2026, patrón de Suffolk y Mortenson): una franja abajo con una
// línea fina, un dato a la izquierda y un enlace a la derecha; el mensaje queda al medio.
// Acepta video (portada, Empresa…) o imagen (páginas interiores): toda cabecera
// lleva al menos una imagen, nunca solo texto (pedido del usuario, 30-sep).
import VideoFondo from './VideoFondo.astro';
import Referencial from './Referencial.astro';
import type { ImagenReferencial, VideoReferencial } from '../data/referencia';

interface Props {
	video?: VideoReferencial;
	imagen?: ImagenReferencial | { src: string; alt: string };
	baja?: boolean; // páginas interiores: menos alto, para que el contenido asome antes
	centrado?: boolean; // título, bajada y botones al medio
}
const { video, imagen, baja = false, centrado = false } = Astro.props;
const conPie = Astro.slots.has('pie');
const verticales = [25, 50, 75];
const horizontales = [40];
---

<section class:list={['hero-obra', { baja, centrado, 'con-pie': conPie }]}>
	{video && <VideoFondo video={video} clase="fondo-hero" eager />}
	{
		!video && imagen && (
			<div class="fondo-hero marco">
				{'origen' in imagen ? <Referencial imagen={imagen} carga="eager" sizes="100vw" /> : <img src={imagen.src} alt={imagen.alt} fetchpriority="high" />}
			</div>
		)
	}
	<div class="velo" aria-hidden="true"></div>
	<div class="trazo" aria-hidden="true">
		{verticales.map((x, i) => <span class="eje-v" style={`left: ${x}%; --i: ${i}`} />)}
		{horizontales.map((y, i) => <span class="eje-h" style={`top: ${y}%; --i: ${i}`} />)}
	</div>
	<div class="contenedor contenido">
		<slot />
	</div>
	{
		conPie && (
			<div class="pie-hero">
				<div class="contenedor pie-fila">
					<slot name="pie" />
				</div>
			</div>
		)
	}
</section>

<style>
	.hero-obra {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(34rem, calc(100svh - 4.5rem), 56rem);
		overflow: hidden;
		background: var(--lols-carbon);
		color: var(--lols-blanco);
	}
	.hero-obra.baja {
		min-height: clamp(26rem, 68svh, 40rem);
	}
	.velo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(20 20 20 / 0.82) 0%, rgb(20 20 20 / 0.45) 38%, rgb(20 20 20 / 0.08) 70%),
			linear-gradient(to right, rgb(20 20 20 / 0.35), transparent 60%);
		pointer-events: none;
	}
	.trazo {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.eje-v,
	.eje-h {
		position: absolute;
		background: rgb(255 255 255 / 0.14);
	}
	.eje-v {
		top: 0;
		bottom: 0;
		width: 1px;
		transform-origin: top;
	}
	.eje-h {
		left: 0;
		right: 0;
		height: 1px;
		transform-origin: left;
	}

	.contenido {
		position: relative;
		padding-block: clamp(3rem, 8vw, 5.5rem);
	}
	.contenido :global(.display) {
		max-width: 12ch;
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 1.4rem + 6.5vw, 7.75rem);
		color: var(--lols-blanco);
		text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
	}
	/* Títulos largos (p. ej. Empresa): un escalón más chico para no tapar la obra. */
	.contenido :global(.display.largo) {
		max-width: 17ch;
		font-size: clamp(2.5rem, 1.2rem + 4.6vw, 6rem);
	}
	.contenido :global(.etiqueta) {
		color: var(--lols-blanco);
	}
	.contenido :global(.bajada) {
		max-width: 36rem;
		margin-bottom: 2rem;
		color: rgb(255 255 255 / 0.9);
	}
	.contenido :global(.acciones) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.centrado .contenido {
		text-align: center;
	}
	.centrado .contenido :global(.display),
	.centrado .contenido :global(.bajada) {
		margin-inline: auto;
	}
	.centrado .contenido :global(.acciones) {
		justify-content: center;
	}

	/* Con franja al pie: el mensaje al medio de la pantalla y la franja pegada abajo. */
	.con-pie {
		align-items: center;
	}
	.con-pie .contenido {
		padding-block: 6rem;
	}
	.pie-hero {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
	}
	.pie-fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		position: relative;
		padding-block: 1.1rem clamp(1.25rem, 3vw, 2rem);
		color: var(--lols-blanco);
	}
	/* La línea fina, del ancho del texto (no del margen del contenedor). */
	.pie-fila::before {
		content: '';
		position: absolute;
		top: 0;
		left: var(--gutter);
		right: var(--gutter);
		height: 1px;
		background: rgb(255 255 255 / 0.28);
	}
	/* En nuevo.lols.cl el aviso de propuesta va fijo abajo a la izquierda: la franja sube sobre él. */
	:global(html:has(.aviso)) .pie-fila {
		padding-bottom: 4.5rem;
	}
	.pie-hero :global(.etiqueta) {
		margin: 0;
		color: rgb(255 255 255 / 0.92);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: 0.85rem;
	}
	.pie-hero :global(.enlace-flecha) {
		color: var(--lols-blanco);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.9rem;
	}
	.pie-hero :global(.enlace-flecha:hover) {
		color: var(--lols-lima);
	}
	/* Botones sobre la obra: primario blanco, secundario con contorno blanco. */
	.contenido :global(.boton) {
		background: var(--lols-blanco);
		border-color: var(--lols-blanco);
		color: var(--lols-carbon);
	}
	.contenido :global(.boton:hover) {
		background: var(--lols-lima);
		border-color: var(--lols-lima);
	}
	.contenido :global(.boton.secundario) {
		background: transparent;
		color: var(--lols-blanco);
	}
	.contenido :global(.boton.secundario:hover) {
		background: var(--lols-blanco);
		color: var(--lols-carbon);
	}

	@media (max-width: 640px) {
		.hero-obra {
			min-height: calc(88svh - 4.5rem);
		}
		.con-pie .contenido {
			padding-block: 4rem 7rem;
		}
		.pie-fila {
			justify-content: center;
			text-align: center;
			gap: 0.6rem;
		}
		.pie-hero :global(.etiqueta) {
			font-size: 0.78rem;
		}
		.eje-v:nth-child(odd) {
			display: none;
		}
	}
</style>
