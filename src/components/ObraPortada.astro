---
// Banda de obra de la portada con el trazo del plano encima: ejes verticales y horizontales
// con sus rótulos, que se dibujan al cargar (animaciones.css) y quedan tenues. Es el único
// gesto audaz de la página (docs/estructura.md § Dirección visual).
import VideoFondo from './VideoFondo.astro';
import type { VideoReferencial } from '../data/referencia';

interface Props {
	video: VideoReferencial;
}
const { video } = Astro.props;
const verticales = [20, 40, 60, 80];
const horizontales = [33, 66];
const letras = ['A', 'B', 'C', 'D', 'E'];
---

<div class="obra">
	<VideoFondo video={video} clase="banda" eager />
	<div class="trazo" aria-hidden="true">
		{verticales.map((x, i) => <span class="eje-v" style={`left: ${x}%; --i: ${i}`} />)}
		{horizontales.map((y, i) => <span class="eje-h" style={`top: ${y}%; --i: ${i}`} />)}
		{letras.map((l, i) => <span class="rotulo-eje" style={`left: calc(${i * 20}% + 10px); --i: ${i}`}>{l}</span>)}
		{horizontales.map((y, i) => <span class="rotulo-eje fila" style={`top: calc(${y}% + 6px); --i: ${i + 5}`}>{i + 2}</span>)}
	</div>
</div>

<style>
	.obra {
		position: relative;
	}
	.trazo {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
	}
	.eje-v,
	.eje-h {
		position: absolute;
		background: rgb(255 255 255 / 0.32);
	}
	.eje-v {
		top: 0;
		bottom: 0;
		width: 1px;
		transform-origin: top;
	}
	.eje-h {
		left: 0;
		right: 0;
		height: 1px;
		transform-origin: left;
	}
	.rotulo-eje {
		position: absolute;
		top: 10px;
		padding: 0.1rem 0.35rem;
		background: rgb(20 20 20 / 0.45);
		color: rgb(255 255 255 / 0.85);
		font: 500 0.72rem/1.3 var(--fuente-datos);
	}
	.rotulo-eje.fila {
		left: 10px;
	}
	@media (max-width: 640px) {
		.rotulo-eje {
			display: none;
		}
	}
</style>
