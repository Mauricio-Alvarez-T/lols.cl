---
// Hero de la portada: la obra en video ocupa la primera pantalla y el mensaje va encima,
// abajo a la izquierda (lo primero que se ve es la obra, no un bloque de texto). Un velo
// degradado desde abajo asegura la lectura sobre cualquier cuadro del video. Encima, los ejes
// del plano se trazan al cargar y quedan muy tenues (animaciones.css).
// El contenido (título, bajada, botones) llega por el slot desde la página.
import VideoFondo from './VideoFondo.astro';
import type { VideoReferencial } from '../data/referencia';

interface Props {
	video: VideoReferencial;
}
const { video } = Astro.props;
const verticales = [25, 50, 75];
const horizontales = [40];
---

<section class="hero-obra">
	<VideoFondo video={video} clase="fondo-hero" eager />
	<div class="velo" aria-hidden="true"></div>
	<div class="trazo" aria-hidden="true">
		{verticales.map((x, i) => <span class="eje-v" style={`left: ${x}%; --i: ${i}`} />)}
		{horizontales.map((y, i) => <span class="eje-h" style={`top: ${y}%; --i: ${i}`} />)}
	</div>
	<div class="contenedor contenido">
		<slot />
	</div>
</section>

<style>
	.hero-obra {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(34rem, calc(100svh - 4.5rem), 56rem);
		overflow: hidden;
		background: var(--lols-carbon);
		color: var(--lols-blanco);
	}
	.velo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(20 20 20 / 0.82) 0%, rgb(20 20 20 / 0.45) 38%, rgb(20 20 20 / 0.08) 70%),
			linear-gradient(to right, rgb(20 20 20 / 0.35), transparent 60%);
		pointer-events: none;
	}
	.trazo {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.eje-v,
	.eje-h {
		position: absolute;
		background: rgb(255 255 255 / 0.14);
	}
	.eje-v {
		top: 0;
		bottom: 0;
		width: 1px;
		transform-origin: top;
	}
	.eje-h {
		left: 0;
		right: 0;
		height: 1px;
		transform-origin: left;
	}

	.contenido {
		position: relative;
		padding-block: clamp(3rem, 8vw, 5.5rem);
	}
	.contenido :global(.display) {
		max-width: 12ch;
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 1.4rem + 6.5vw, 7.75rem);
		color: var(--lols-blanco);
		text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
	}
	.contenido :global(.etiqueta) {
		color: var(--lols-blanco);
	}
	.contenido :global(.bajada) {
		max-width: 36rem;
		margin-bottom: 2rem;
		color: rgb(255 255 255 / 0.9);
	}
	.contenido :global(.acciones) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	/* Botones sobre la obra: primario blanco, secundario con contorno blanco. */
	.contenido :global(.boton) {
		background: var(--lols-blanco);
		border-color: var(--lols-blanco);
		color: var(--lols-carbon);
	}
	.contenido :global(.boton:hover) {
		background: var(--lols-lima);
		border-color: var(--lols-lima);
	}
	.contenido :global(.boton.secundario) {
		background: transparent;
		color: var(--lols-blanco);
	}
	.contenido :global(.boton.secundario:hover) {
		background: var(--lols-blanco);
		color: var(--lols-carbon);
	}

	@media (max-width: 640px) {
		.hero-obra {
			min-height: calc(88svh - 4.5rem);
		}
		.eje-v:nth-child(odd) {
			display: none;
		}
	}
</style>
