---
// Ficha de obra (nivel 2: aquí va todo). La usan la página de cada proyecto y el panel que
// se despliega bajo el carrusel (CarruselObras). Pirámide invertida, como Heatherwick: nombre y
// titular, el recuadro de datos, desafío / solución / resultado y la galería. La foto principal
// no va aquí: en la página es la portada y en el carrusel ya está a la vista.
// Don Luis (08-10-2026): sin plazos de obra (para no comprometerse), sin testimonios con nombre
// y sin videos ni fotos por etapa: solo el render de lo que se hará y fotos de lo terminado.
//
// En la ficha de ejemplo, lo que falta se muestra con contenido de muestra (<Pendiente>). En una
// obra real, lo que no se sabe todavía no se muestra.
//
// `muestra`: datos de una tarjeta de ejemplo (referencia.ts) que reemplazan nombre, tipo,
// comuna y superficie del ejemplo general, para que cada obra de muestra tenga los suyos.
//
// Editor visual (docs/editor-visual.md): en una obra real, la ficha lleva data-ed-item, cada fila
// del recuadro y cada paso del relato data-ed-fila, y cada valor data-ed-campo (texto que se
// escribe en el lugar) o data-ed-derivado (formateado, se cambia en el panel de la Bóveda). Las
// filas que faltan las clona el puente de /editor/moldes/. Mantener las marcas al cambiar esto.
import Pendiente from './Pendiente.astro';
import Pictograma from './Pictograma.astro';
import Referencial from './Referencial.astro';
import { plantilla, pictogramaDeTipo, type Estado, type FotoObra, type Proyecto } from '../data/proyectos';
import { conAnio as fechaEsAnio, rotuloInicio, textoAnio, textoEstado, textoServicios } from '../data/vistaObra';
import { obras2018, type EjemploTarjeta } from '../data/referencia';
import { ejemploProyecto, ejemploFichaExtra } from '../data/ejemplos';

interface Props {
	proyecto: Proyecto;
	muestra?: EjemploTarjeta;
	nivel?: 1 | 3; // 1 en la página del proyecto; 3 dentro del panel (bajo el h2 del carrusel)
}
const { proyecto: p, muestra, nivel = 1 } = Astro.props;
const Titulo = `h${nivel}` as 'h1' | 'h3';
const Sub = `h${nivel + 1}` as 'h2' | 'h4';
const compacta = nivel > 1;

const esEjemplo = p.slug === plantilla.slug;
// Marcas del editor: solo en una obra real (no en la ficha de ejemplo ni en las de muestra).
const ed = esEjemplo || muestra ? undefined : `obras/${p.slug}`;
const marca = (valor: string) => (ed ? valor : undefined);
const ej = { ...ejemploProyecto, ...muestra };
// Estado de la muestra: las terminadas traen año; las en construcción, fecha de inicio.
const estado: Estado | null = p.estado ?? (muestra ? (muestra.anio ? 'terminado' : 'en-curso') : null);
const conAnio = fechaEsAnio(estado) || (esEjemplo && !estado);
// Solo fotos propias: una imagen referencial (campo `referencia`) va sola, como portada.
const galeria = p.fotos.slice(1).filter((f): f is FotoObra => !('origen' in f));
const relato = [
	{ fila: 'desafio', titulo: 'Desafío', texto: p.desafio, pendiente: 'qué problema tenía el mandante', ejemplo: ej.desafio },
	{ fila: 'solucion', titulo: 'Solución', texto: p.solucion, pendiente: 'qué hizo LOLS y cómo', ejemplo: ej.solucion },
	{ fila: 'resultado', titulo: 'Resultado', texto: p.resultado, pendiente: 'qué se logró', ejemplo: ej.resultado },
].filter((r) => r.texto || esEjemplo);
// Datos del recuadro: fila (marca del editor), rótulo, dato real, qué falta, ejemplo y marca del
// valor (campo que se escribe en el lugar o derivado). En una obra real se omite lo que falta.
type Dato = { fila: string; rotulo: string; dato: string | null; falta: string; ejemplo: string; campo?: string; derivado?: string };
const datos = (
	[
		{ fila: 'mandante', rotulo: 'Mandante', dato: p.mandante, falta: 'mandante', ejemplo: ej.mandante, derivado: '/mandante' },
		{ fila: 'comuna', rotulo: 'Comuna', dato: p.comuna, falta: 'comuna', ejemplo: ej.comuna, campo: '/comuna' },
		{ fila: 'direccion', rotulo: 'Dirección', dato: p.direccion, falta: 'dirección (confirmar si se puede publicar)', ejemplo: ej.direccion, campo: '/direccion' },
		{ fila: 'superficie', rotulo: 'Superficie construida', dato: p.superficie, falta: 'm² construidos', ejemplo: ej.superficie, derivado: '/superficieM2' },
		conAnio
			? { fila: 'anio', rotulo: 'Año de término', dato: textoAnio(p.anio), falta: 'año', ejemplo: ej.anio, derivado: '/anio' }
			: { fila: 'inicio', rotulo: rotuloInicio(estado), dato: p.inicio, falta: 'mes y año de inicio', ejemplo: ej.inicio, campo: '/inicio' },
	] as Dato[]
).filter((d) => d.dato || esEjemplo);
---

<div class:list={['ficha-obra', { compacta }]} data-ed-item={ed}>
	<header class="cabeza">
		<p class="nombre" data-ed-campo={marca('/nombre')}>{p.nombre ?? <Pendiente texto="nombre del proyecto">{ej.nombre}</Pendiente>}</p>
		{
			(p.titular || esEjemplo) && (
				<Titulo class="titulo-ficha" tabindex={compacta ? '-1' : undefined} data-ed-campo={marca('/titular')}>
					{p.titular ?? <Pendiente texto="el resultado en una frase (no el nombre de la obra)">{ej.titular}</Pendiente>}
				</Titulo>
			)
		}
	</header>

	<dl class="datos">
		{
			(p.tipo || esEjemplo) && (
				<div data-ed-fila={marca('tipo')}>
					<dt>Tipo de obra</dt>
					<dd class="con-picto" data-ed-derivado={marca('/tipo')}>
						<Pictograma nombre={pictogramaDeTipo(p.tipo ?? ej.tipo)} ed={marca('/tipo')} />
						{p.tipo ?? <Pendiente texto="tipo de obra">{ej.tipo}</Pendiente>}
					</dd>
				</div>
			)
		}
		{datos.map((d) => <div data-ed-fila={marca(d.fila)}><dt>{d.rotulo}</dt><dd data-ed-campo={d.campo && marca(d.campo)} data-ed-derivado={d.derivado && marca(d.derivado)}>{d.dato ?? <Pendiente texto={d.falta}>{d.ejemplo}</Pendiente>}</dd></div>)}
		{esEjemplo && <div><dt>Rol de LOLS</dt><dd><Pendiente texto="contratista principal o subcontrato">{ejemploFichaExtra.rol}</Pendiente></dd></div>}
		<div data-ed-fila={marca('servicios')}><dt>Servicios</dt><dd data-ed-derivado={marca('/servicios')}>{textoServicios(p.servicios)}</dd></div>
		<div data-ed-fila={marca('estado')}><dt>Estado</dt><dd data-ed-derivado={marca('/estado')}>{textoEstado(estado) ?? <Pendiente texto="estado">{ej.estado}</Pendiente>}</dd></div>
	</dl>

	{
		relato.length > 0 && (
			<div class="relato">
				{relato.map((r) => (
					<div class="paso" data-ed-fila={marca(r.fila)}>
						<Sub>{r.titulo}</Sub>
						<p data-ed-campo={marca(`/${r.fila}`)}>{r.texto ?? <Pendiente texto={r.pendiente}>{r.ejemplo}</Pendiente>}</p>
					</div>
				))}
			</div>
		)
	}

	{
		(galeria.length > 0 || esEjemplo) && (
			<div>
				<Sub class="sr-only">Galería</Sub>
				<div class="galeria">
					{galeria.length
						? galeria.map((f) => (
								<div class="marco">
									<img src={f.src} srcset={f.srcset} sizes={f.srcset && '(max-width: 560px) 100vw, 50vw'} width={f.width} height={f.height} alt={f.alt} loading="lazy" />
								</div>
							))
						: obras2018.slice(3, 6).map((f) => (
								<div class="marco">
									<Referencial imagen={f} sizes="(max-width: 560px) 100vw, 50vw" />
								</div>
							))}
				</div>
			</div>
		)
	}

	<slot />
</div>

<style>
	.ficha-obra {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
	}
	.ficha-obra.compacta {
		gap: clamp(2rem, 4vw, 3rem);
	}
	.nombre {
		margin-bottom: 0.75rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--lols-verde-oscuro);
	}
	.titulo-ficha {
		max-width: 20ch;
		margin: 0;
		font-size: clamp(2.25rem, 5.5vw, 4.5rem);
	}
	.compacta .titulo-ficha {
		max-width: 26ch;
		font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-wrap: balance;
	}
	.titulo-ficha:focus {
		outline: none;
	}
	.con-picto {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.con-picto :global(.pictograma) {
		flex-shrink: 0;
		width: 1.35rem;
		height: 1.35rem;
		color: var(--lols-verde);
	}
	.relato {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.paso {
		padding-top: 1.25rem;
		border-top: 3px solid var(--lols-carbon);
	}
	.paso :is(h2, h4) {
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
		letter-spacing: -0.02em;
	}
	.paso p {
		margin: 0;
	}
	.galeria {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 1rem;
	}
	.galeria .marco {
		aspect-ratio: 4 / 3;
	}
	.galeria .marco:first-child {
		grid-row: span 2;
		aspect-ratio: auto;
	}
	@media (max-width: 960px) {
		.relato {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.galeria {
			grid-template-columns: minmax(0, 1fr);
		}
		.galeria .marco:first-child {
			grid-row: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>
