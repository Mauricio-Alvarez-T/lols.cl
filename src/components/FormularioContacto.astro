---
// Formulario de cotización → /api/contacto.php (public/api/). Funciona sin JavaScript
// (POST normal + redirección con ?enviado=1 o ?error=); con JavaScript envía por fetch y
// muestra el resultado sin recargar. Consentimiento sin marcar por defecto (Ley 21.719).
// Terreno, etapa, inicio y hasta 2 fotos o planos (Marcos, 09-10-2026): las opciones y los
// límites de los adjuntos están repetidos en public/api/contacto.php; cambiarlos en ambos.
import { servicios } from '../data/empresa';

const terrenos = [
	['plano', 'Plano'],
	['pendiente', 'Con pendiente'],
	['construccion-existente', 'Con una construcción existente'],
	['relleno', 'Relleno o suelo blando'],
	['no-sabe', 'No lo sé'],
];
const etapas = [
	['idea', 'Solo una idea'],
	['planos', 'Tiene planos'],
	['permisos', 'Tiene permisos'],
	['licitacion', 'Es una licitación'],
];
const inicios = [
	['pronto', 'Lo antes posible'],
	['1-3', '1 a 3 meses'],
	['3-6', '3 a 6 meses'],
	['mas-6', 'Más de 6 meses'],
	['no-sabe', 'No lo sé'],
];
const preguntas = [
	{ nombre: 'terreno', titulo: 'Tipo de terreno', opciones: terrenos },
	{ nombre: 'etapa', titulo: '¿En qué etapa está su proyecto?', opciones: etapas },
	{ nombre: 'inicio', titulo: '¿Cuándo le gustaría empezar?', opciones: inicios },
];
---

<form id="formulario" class="formulario" action="/api/contacto.php" method="post" enctype="multipart/form-data" novalidate>
	<div class="fila">
		<label for="f-nombre">
			<span>Nombre <abbr title="obligatorio">*</abbr></span>
			<input id="f-nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required />
		</label>
		<label for="f-empresa">
			<span>Empresa</span>
			<input id="f-empresa" name="empresa" type="text" autocomplete="organization" maxlength="120" />
		</label>
	</div>
	<div class="fila">
		<label for="f-correo">
			<span>Correo <abbr title="obligatorio">*</abbr></span>
			<input id="f-correo" name="correo" type="email" autocomplete="email" maxlength="160" required />
		</label>
		<label for="f-telefono">
			<span>Teléfono</span>
			<input id="f-telefono" name="telefono" type="tel" autocomplete="tel" maxlength="40" />
		</label>
	</div>
	<!-- Su proyecto (reunión con don Luis): con dirección y m² ya se puede estimar el alcance
	     y preparar la visita técnica sin una llamada previa. -->
	<fieldset class="proyecto">
		<legend>Su proyecto</legend>
		<label for="f-servicio">
			<span>Servicio</span>
			<select id="f-servicio" name="servicio">
				<option value="">Seleccione…</option>
				{servicios.map((s) => <option value={s.slug}>{s.nombre}</option>)}
				<option value="otro">Otro</option>
			</select>
		</label>
		<div class="fila">
			<label for="f-direccion">
				<span>Dirección de la propiedad</span>
				<input id="f-direccion" name="direccion" type="text" autocomplete="street-address" maxlength="200" placeholder="Calle, número y comuna" />
			</label>
			<label for="f-superficie">
				<span>Superficie aproximada (m²)</span>
				<input id="f-superficie" name="superficie" type="text" inputmode="decimal" maxlength="40" placeholder="Ej.: 1.500" />
			</label>
		</div>
		{
			preguntas.map((p) => (
				<fieldset class="opciones">
					<legend>{p.titulo}</legend>
					<div class="chips">
						{p.opciones.map(([valor, texto]) => (
							<label class="chip">
								<input type="radio" name={p.nombre} value={valor} />
								<span>{texto}</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}
		<label for="f-mensaje">
			<span>Cuéntenos su proyecto <abbr title="obligatorio">*</abbr></span>
			<textarea id="f-mensaje" name="mensaje" rows="6" maxlength="5000" required placeholder="A grandes rasgos: qué quiere construir o instalar y para qué lo usará."></textarea>
		</label>
		<label for="f-archivos">
			<span>Fotos o planos</span>
			<input id="f-archivos" name="archivos[]" type="file" multiple accept="image/*,.pdf" aria-describedby="f-archivos-ayuda" />
		</label>
		<p id="f-archivos-ayuda" class="ayuda">Hasta 2 archivos (fotos o PDF), de 5 MB cada uno, como referencia de lo que quiere.</p>
	</fieldset>

	<!-- Trampa para bots: oculto a las personas y a los lectores de pantalla. -->
	<div class="trampa" aria-hidden="true">
		<label>Sitio web <input name="sitio_web" type="text" tabindex="-1" autocomplete="off" /></label>
	</div>
	<input type="hidden" name="t" value="" />

	<label for="f-consentimiento" class="consentimiento">
		<input id="f-consentimiento" name="consentimiento" type="checkbox" value="si" required />
		<span>
			Acepto que LOLS Ingeniería use estos datos para responder mi solicitud, según su{' '}
			<a href="/privacidad/">política de privacidad</a>. <abbr title="obligatorio">*</abbr>
		</span>
	</label>

	<div class="acciones">
		<button type="submit" class="boton">Enviar solicitud</button>
		<p class="estado" role="status" aria-live="polite"></p>
	</div>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>('#formulario')!;
	const estado = form.querySelector<HTMLParagraphElement>('.estado')!;
	const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
	(form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now());

	const mensajes: Record<string, string> = {
		enviado: 'Gracias. Recibimos su solicitud y le responderemos a la brevedad.',
		datos: 'Revise los campos marcados: nombre, un correo válido y la descripción del proyecto son obligatorios.',
		archivos: 'Puede adjuntar hasta 2 archivos (fotos o PDF) de hasta 5 MB cada uno.',
		consentimiento: 'Para enviar, debe aceptar la política de privacidad.',
		limite: 'Recibimos varias solicitudes desde su conexión. Intente de nuevo en una hora.',
		'no-configurado': 'El formulario aún no está habilitado. Escríbanos directamente por correo.',
		red: 'No pudimos conectar con el servidor. Revise su conexión e intente de nuevo.',
		otro: 'No pudimos enviar la solicitud. Intente de nuevo o escríbanos directamente por correo.',
	};

	function mostrar(clave: string, ok = false) {
		estado.textContent = mensajes[clave] ?? mensajes.otro;
		estado.dataset.tipo = ok ? 'ok' : 'error';
	}

	const params = new URLSearchParams(location.search);
	// "Cotizar …" desde la ficha de un servicio (MosaicoServicios) llega con ?servicio=slug.
	const servicio = form.elements.namedItem('servicio') as HTMLSelectElement | null;
	const pedido = params.get('servicio');
	if (servicio && pedido && [...servicio.options].some((o) => o.value === pedido)) servicio.value = pedido;
	if (params.get('asunto') === 'precalificacion') {
		const mensaje = form.elements.namedItem('mensaje') as HTMLTextAreaElement;
		if (!mensaje.value) {
			mensaje.value =
				'Solicito la documentación de precalificación de LOLS Ingeniería (certificados, indicadores de la mutualidad y antecedentes de la empresa).';
		}
	}

	// Resultado del envío sin JavaScript (redirección con ?enviado / ?error).
	if (params.has('enviado')) mostrar('enviado', true);
	else if (params.has('error')) mostrar(params.get('error')!);

	// Fotos o planos: máximo 2, de 5 MB cada uno (el servidor vuelve a revisarlo).
	const archivos = form.querySelector<HTMLInputElement>('#f-archivos')!;
	const MAX_ARCHIVOS = 2;
	const MAX_BYTES = 5 * 1024 * 1024;
	const archivosValidos = () => {
		const lista = [...(archivos.files ?? [])];
		return lista.length <= MAX_ARCHIVOS && lista.every((f) => f.size <= MAX_BYTES);
	};
	archivos.addEventListener('change', () => {
		if (archivosValidos()) {
			archivos.removeAttribute('aria-invalid');
			if (estado.dataset.tipo === 'error') estado.textContent = '';
		} else {
			archivos.setAttribute('aria-invalid', 'true');
			mostrar('archivos');
		}
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		for (const campo of form.querySelectorAll<HTMLInputElement>('[required]')) campo.removeAttribute('aria-invalid');
		const invalidos = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((c) => !c.checkValidity());
		if (invalidos.length) {
			for (const c of invalidos) c.setAttribute('aria-invalid', 'true');
			mostrar(invalidos.some((c) => c.name === 'consentimiento') && invalidos.length === 1 ? 'consentimiento' : 'datos');
			invalidos[0].focus();
			return;
		}
		if (!archivosValidos()) {
			archivos.setAttribute('aria-invalid', 'true');
			mostrar('archivos');
			archivos.focus();
			return;
		}
		boton.disabled = true;
		estado.textContent = 'Enviando…';
		delete estado.dataset.tipo;
		try {
			const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
			const datos = await r.json().catch(() => ({ ok: false, error: 'otro' }));
			if (datos.ok) {
				form.reset();
				archivos.removeAttribute('aria-invalid');
				mostrar('enviado', true);
			} else {
				mostrar(datos.error ?? 'otro');
			}
		} catch {
			mostrar('red');
		} finally {
			boton.disabled = false;
		}
	});
</script>

<style>
	.formulario {
		display: grid;
		gap: 1.25rem;
	}
	.fila {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}
	label {
		display: grid;
		gap: 0.4rem;
	}
	.proyecto {
		display: grid;
		gap: 1.25rem;
		margin: 0.5rem 0 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	/* La leyenda lleva la línea de arriba (el borde del fieldset la cortaría). */
	.proyecto legend {
		width: 100%;
		margin-bottom: 1.25rem;
		padding: 1.25rem 0 0;
		border-top: 1px solid var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	label > span {
		font-family: var(--fuente-titulos);
		font-weight: 600;
		font-size: 0.95rem;
	}
	abbr {
		color: var(--lols-verde-oscuro);
		text-decoration: none;
	}
	input,
	select,
	textarea {
		width: 100%;
		min-height: 3rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid #b5b5b5;
		border-radius: 0;
		background: var(--lols-blanco);
		color: var(--lols-carbon);
		font: inherit;
	}
	textarea {
		resize: vertical;
		min-height: 9rem;
	}
	input[type='file'] {
		padding: 0.6rem 0.85rem;
		cursor: pointer;
	}
	.ayuda {
		margin: -0.75rem 0 0;
		font-size: 0.9rem;
		color: var(--lols-gris);
	}
	/* Preguntas de una opción: botones que se marcan (44 px de alto, cómodos en el celular). */
	.opciones {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	/* Sin la línea ni el tamaño de la leyenda "Su proyecto" (.proyecto legend). */
	.opciones legend {
		width: auto;
		margin-bottom: 0.6rem;
		padding: 0;
		border-top: 0;
		letter-spacing: normal;
		font-family: var(--fuente-titulos);
		font-weight: 600;
		font-size: 0.95rem;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		display: block;
		position: relative;
	}
	.chip input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		min-height: 0;
		margin: 0;
		padding: 0;
		opacity: 0;
		cursor: pointer;
	}
	.chip span {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.45rem 1rem;
		border: 1px solid #b5b5b5;
		background: var(--lols-blanco);
		font-family: var(--fuente-texto);
		font-weight: 500;
		font-size: 0.95rem;
	}
	.chip:hover span {
		border-color: var(--lols-verde-oscuro);
	}
	.chip input:checked + span {
		border-color: var(--lols-verde-oscuro);
		background: var(--lols-verde-oscuro);
		color: var(--lols-blanco);
	}
	.chip input:focus-visible + span {
		outline: 3px solid var(--lols-verde-oscuro);
		outline-offset: 2px;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 3px solid var(--lols-verde-oscuro);
		outline-offset: 0;
		border-color: var(--lols-verde-oscuro);
	}
	[aria-invalid='true'] {
		border-color: #b3261e;
		outline-color: #b3261e;
	}
	.consentimiento {
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 0.75rem;
		font-size: 0.95rem;
		color: var(--lols-gris);
	}
	.consentimiento input {
		width: 1.25rem;
		height: 1.25rem;
		min-height: 0;
		margin-top: 0.15rem;
		accent-color: var(--lols-verde-oscuro);
	}
	.consentimiento span {
		font: inherit;
	}
	.trampa {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.acciones {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	.boton:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.estado {
		margin: 0;
		font-weight: 600;
	}
	.estado[data-tipo='ok'] {
		color: var(--lols-verde-oscuro);
	}
	.estado[data-tipo='error'] {
		color: #b3261e;
	}
	@media (max-width: 560px) {
		.fila {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
