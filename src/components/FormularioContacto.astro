---
// Formulario de cotización → /api/contacto.php (public/api/). Funciona sin JavaScript
// (POST normal + redirección con ?enviado=1 o ?error=); con JavaScript envía por fetch y
// muestra el resultado sin recargar. Consentimiento sin marcar por defecto (Ley 21.719).
// Terreno, etapa, inicio y hasta 2 fotos o planos (Marcos, 09-10-2026): las opciones y los
// límites de los adjuntos están repetidos en public/api/contacto.php; cambiarlos en ambos.
//
// En tres pasos (Marcos, 20-10-2026; idea del «Stepper» de React Bits, reescrita sin React):
// 1) Qué necesita (servicio, etapa, cuándo empezar), 2) Su proyecto (dónde, cuánto, terreno,
// descripción y adjuntos) y 3) Sus datos. Primero lo fácil, que se responde con toques, y los
// datos personales al final: en el celular, una sola pantalla de 12 campos espanta. Una barra
// arriba dice en qué paso va; cada paso revisa lo suyo antes de seguir, y el botón Atrás del
// navegador (o del celular) vuelve al paso anterior. Todo sigue siendo UN solo <form>: sin
// JavaScript se ven los tres pasos seguidos, con su título, y se envía igual que antes.
import { empresa, servicios } from '../data/empresa';
import { MAX_MB, MAX_TOTAL_MB, gruposCotizacion, extCotizacion, acceptDe } from '../data/formatos';
import '../styles/formulario.css';

const necesidades = [...servicios.map((s) => [s.slug, s.nombre]), ['otro', 'Otro']];
const terrenos = [
	['plano', 'Plano'],
	['pendiente', 'Con pendiente'],
	['construccion-existente', 'Con una construcción existente'],
	['relleno', 'Relleno o suelo blando'],
	['no-sabe', 'No lo sé'],
];
const etapas = [
	['idea', 'Solo una idea'],
	['planos', 'Tiene planos'],
	['permisos', 'Tiene permisos'],
	['licitacion', 'Es una licitación'],
];
const inicios = [
	['pronto', 'Lo antes posible'],
	['1-3', '1 a 3 meses'],
	['3-6', '3 a 6 meses'],
	['mas-6', 'Más de 6 meses'],
	['no-sabe', 'No lo sé'],
];
const paso1 = [
	{ nombre: 'servicio', titulo: 'Servicio', opciones: necesidades },
	{ nombre: 'etapa', titulo: '¿En qué etapa está su proyecto?', opciones: etapas },
	{ nombre: 'inicio', titulo: '¿Cuándo le gustaría empezar?', opciones: inicios },
];
const pasos = ['Qué necesita', 'Su proyecto', 'Sus datos'];
---

<script is:inline>document.documentElement.classList.add('cotiza-js');</script>
<form id="formulario" class="formulario cotiza" action="/api/contacto.php" method="post" enctype="multipart/form-data" novalidate>
	<!-- Avance: solo con JavaScript (sin él, los tres pasos van seguidos con su título). -->
	<ol class="avance" data-avance>
		{
			pasos.map((t, i) => (
				<li data-i={i + 1}>
					<button type="button" data-ir-paso={i + 1} disabled>
						<span class="avance-n" aria-hidden="true">{i + 1}</span>
						<span class="avance-t">{t}</span>
					</button>
				</li>
			))
		}
	</ol>
	<p class="sr-only" aria-live="polite" data-anuncio></p>

	<fieldset class="paso" data-paso="1" tabindex="-1">
		<legend>Qué necesita</legend>
		{
			paso1.map((p) => (
				<fieldset class="opciones">
					<legend>{p.titulo}</legend>
					<div class="chips">
						{p.opciones.map(([valor, texto]) => (
							<label class="chip">
								<input type="radio" name={p.nombre} value={valor} />
								<span>{texto}</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}
		<p class="ayuda-paso">Elija una opción en cada pregunta. Si no lo sabe aún, puede seguir igual.</p>
	</fieldset>

	<!-- Su proyecto (reunión con don Luis): con dirección y m² ya se puede estimar el alcance
	     y preparar la visita técnica sin una llamada previa. -->
	<fieldset class="paso" data-paso="2" tabindex="-1">
		<legend>Su proyecto</legend>
		<div class="fila">
			<label for="f-direccion">
				<span>Dirección de la propiedad</span>
				<input id="f-direccion" name="direccion" type="text" autocomplete="street-address" maxlength="200" placeholder="Calle, número y comuna" />
			</label>
			<label for="f-superficie">
				<span>Superficie aproximada (m²)</span>
				<input id="f-superficie" name="superficie" type="text" inputmode="decimal" maxlength="40" placeholder="Ej.: 1.500" />
			</label>
		</div>
		<fieldset class="opciones">
			<legend>Tipo de terreno</legend>
			<div class="chips">
				{
					terrenos.map(([valor, texto]) => (
						<label class="chip">
							<input type="radio" name="terreno" value={valor} />
							<span>{texto}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<label for="f-mensaje">
			<span>Cuéntenos su proyecto <abbr title="obligatorio">*</abbr></span>
			<textarea id="f-mensaje" name="mensaje" rows="5" maxlength="5000" required placeholder="A grandes rasgos: qué quiere construir o instalar y para qué lo usará."></textarea>
		</label>
		<!-- Planos, modelos y documentos de ingeniería y arquitectura (Marcos, 11-11-2026: «que a
		     nadie quede afuera»): formatos en src/data/formatos.ts. Lo muy pesado va por enlace. -->
		<label for="f-archivos">
			<span>Planos, modelos, fotos o documentos <span class="opcional">(opcional)</span></span>
			<input id="f-archivos" name="archivos[]" type="file" multiple accept={acceptDe(extCotizacion)} aria-describedby="f-archivos-ayuda" data-correo={empresa.correo.valor} />
		</label>
		<div id="f-archivos-ayuda" class="ayuda">
			<p>
				Hasta 5 archivos de {MAX_MB} MB como máximo cada uno ({MAX_TOTAL_MB} MB entre todos): planos en PDF, DWG o DXF; modelos de Revit,
				IFC, SketchUp, Rhino o Blender; planillas y fotos. Las fotos pesadas se achican solas.
			</p>
			<details class="formatos">
				<summary>Ver todos los formatos</summary>
				<dl>
					{
						gruposCotizacion.map((g) => (
							<div>
								<dt>{g.nombre}</dt>
								<dd>{g.ext.map((e) => e.toUpperCase()).join(' · ')}</dd>
							</div>
						))
					}
				</dl>
				<p>¿Uno de otro programa? Póngalo en un ZIP. Los RAR y 7z no se pueden revisar: mándelos como enlace.</p>
			</details>
		</div>
		<label for="f-enlace">
			<span>Enlace a archivos pesados <span class="opcional">(opcional)</span></span>
			<input id="f-enlace" name="enlace" type="url" inputmode="url" maxlength="500" pattern="https?://.+" placeholder="https://drive.google.com/…" aria-describedby="f-enlace-ayuda" />
		</label>
		<p id="f-enlace-ayuda" class="ayuda">
			¿Pesan más, como un modelo de Revit o de Blender, o una nube de puntos? Súbalos a Google Drive, OneDrive, Dropbox o WeTransfer y pegue aquí el enlace.
		</p>
	</fieldset>

	<fieldset class="paso" data-paso="3" tabindex="-1">
		<legend>Sus datos</legend>
		<div class="fila">
			<label for="f-nombre">
				<span>Nombre <abbr title="obligatorio">*</abbr></span>
				<input id="f-nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required />
			</label>
			<label for="f-empresa">
				<span>Empresa</span>
				<input id="f-empresa" name="empresa" type="text" autocomplete="organization" maxlength="120" />
			</label>
		</div>
		<div class="fila">
			<label for="f-correo">
				<span>Correo <abbr title="obligatorio">*</abbr></span>
				<input id="f-correo" name="correo" type="email" autocomplete="email" maxlength="160" required />
			</label>
			<label for="f-telefono">
				<span>Teléfono</span>
				<input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
			</label>
		</div>
		<label for="f-consentimiento" class="consentimiento">
			<input id="f-consentimiento" name="consentimiento" type="checkbox" value="si" required />
			<span>
				Acepto que LOLS Ingeniería use estos datos para responder mi solicitud, según su{' '}
				<a href="/privacidad/">política de privacidad</a>. <abbr title="obligatorio">*</abbr>
			</span>
		</label>
	</fieldset>

	<!-- Trampa para bots: oculto a las personas y a los lectores de pantalla. -->
	<div class="trampa" aria-hidden="true">
		<label>Sitio web <input name="sitio_web" type="text" tabindex="-1" autocomplete="off" /></label>
	</div>
	<input type="hidden" name="t" value="" />

	<div class="acciones">
		<button type="button" class="atras" data-atras><span aria-hidden="true">←</span> Atrás</button>
		<button type="button" class="boton" data-siguiente>Siguiente <span aria-hidden="true">→</span></button>
		<button type="submit" class="boton" data-enviar>Enviar solicitud</button>
		<p class="estado" role="status" aria-live="polite"></p>
	</div>

	<div class="gracias" data-gracias hidden tabindex="-1">
		<p class="gracias-titulo">Solicitud enviada</p>
		<p>La recibimos y le responderemos a la brevedad. Si es urgente, llámenos o escríbanos por WhatsApp.</p>
		<button type="button" class="boton secundario" data-otra>Enviar otra solicitud</button>
	</div>
</form>

<script>
	import { prepararAdjuntos } from '../scripts/adjuntos';
	import { MAX_MB, extCotizacion } from '../data/formatos';

	const form = document.querySelector<HTMLFormElement>('#formulario')!;
	const estado = form.querySelector<HTMLParagraphElement>('.estado')!;
	const enviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
	const siguiente = form.querySelector<HTMLButtonElement>('[data-siguiente]')!;
	const atras = form.querySelector<HTMLButtonElement>('[data-atras]')!;
	const anuncio = form.querySelector<HTMLParagraphElement>('[data-anuncio]')!;
	const gracias = form.querySelector<HTMLDivElement>('[data-gracias]')!;
	const pasos = [...form.querySelectorAll<HTMLFieldSetElement>('.paso')];
	const marcas = [...form.querySelectorAll<HTMLLIElement>('[data-avance] li')];
	const TOTAL = pasos.length;
	(form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now());

	const mensajes: Record<string, string> = {
		enviado: 'Solicitud enviada. Gracias: le responderemos a la brevedad.',
		datos: 'Revise los campos marcados: nombre, un correo válido y la descripción del proyecto son obligatorios.',
		mensaje: 'Cuéntenos su proyecto en unas líneas para seguir.',
		personales: 'Revise los campos marcados: el nombre y un correo válido son obligatorios.',
		archivos: `Revise los archivos: hasta 5, de ${MAX_MB} MB como máximo cada uno.`,
		zip: 'Un ZIP trae adentro programas, macros u otros comprimidos, y por seguridad no los recibimos. Sáquelos del ZIP o mándenos un enlace.',
		enlace: 'Revise el enlace: debe empezar con https:// (el de Google Drive, OneDrive, Dropbox o WeTransfer).',
		consentimiento: 'Para enviar, debe aceptar la política de privacidad.',
		limite: 'Recibimos varias solicitudes desde su conexión. Intente de nuevo en una hora.',
		'no-configurado': 'El formulario aún no está habilitado. Escríbanos directamente por correo.',
		red: 'No pudimos conectar con el servidor: revise su conexión e intente de nuevo.',
		otro: 'Intente de nuevo o escríbanos directamente por correo.',
	};

	function mostrar(clave: string, ok = false) {
		estado.textContent = mensajes[clave] ?? mensajes.otro;
		estado.dataset.tipo = ok ? 'ok' : 'error';
	}
	// Si al apretar «Enviar» falta algo o el envío falla, se dice claro que la solicitud NO salió
	// (Marcos, 11-11-2026: «no me dice explícitamente si mi cotización fue o no enviada»).
	function noEnviada(clave: string, previo = 'No se envió su solicitud.') {
		mostrar(clave);
		estado.textContent = `${previo} ${estado.textContent}`;
	}
	function limpiarEstado() {
		estado.textContent = '';
		delete estado.dataset.tipo;
	}

	// ─── Pasos ───
	let actual = 1;
	const reducir = matchMedia('(prefers-reduced-motion: reduce)');

	function irA(n: number, { enfocar = true } = {}) {
		const antes = actual;
		actual = Math.min(Math.max(n, 1), TOTAL);
		pasos.forEach((p, i) => {
			const visible = i + 1 === actual;
			p.hidden = !visible;
			p.classList.remove('entra-adelante', 'entra-atras');
			// La animación dice hacia dónde se fue: el paso siguiente entra desde la derecha.
			if (visible && antes !== actual && !reducir.matches) {
				void p.offsetWidth;
				p.classList.add(actual > antes ? 'entra-adelante' : 'entra-atras');
			}
		});
		marcas.forEach((li, i) => {
			const n = i + 1;
			li.dataset.estado = n < actual ? 'hecho' : n === actual ? 'actual' : 'pendiente';
			if (n === actual) li.setAttribute('aria-current', 'step');
			else li.removeAttribute('aria-current');
			// Se puede volver a un paso ya hecho tocando su marca; no saltar hacia adelante.
			li.querySelector('button')!.disabled = n >= actual;
		});
		atras.hidden = actual === 1;
		siguiente.hidden = actual === TOTAL;
		enviar.hidden = actual !== TOTAL;
		anuncio.textContent = `Paso ${actual} de ${TOTAL}: ${pasos[actual - 1].querySelector('legend')!.textContent}`;
		if (enfocar && antes !== actual) {
			pasos[actual - 1].focus({ preventScroll: true });
			// Si el comienzo del formulario quedó arriba de la pantalla, se vuelve a él.
			if (form.getBoundingClientRect().top < 0) form.scrollIntoView({ behavior: reducir.matches ? 'auto' : 'smooth', block: 'start' });
		}
	}

	// Cada paso adelante es una entrada del historial: Atrás (navegador o celular) vuelve un paso.
	function avanzar(n: number) {
		history.pushState({ paso: n }, '');
		irA(n);
	}
	window.addEventListener('popstate', (e) => {
		const n = (e.state as { paso?: number } | null)?.paso;
		if (!gracias.hidden) return;
		limpiarEstado();
		irA(typeof n === 'number' ? n : 1);
	});

	// Campos obligatorios de un paso (o de todos) que no están bien.
	// (El enlace es opcional, pero si se escribe debe ser una dirección https://.)
	const invalidosEn = (raiz: ParentNode) =>
		[...raiz.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required], input[type="url"]')].filter((c) => !c.checkValidity());

	function revisarPaso(n: number): boolean {
		const paso = pasos[n - 1];
		for (const c of paso.querySelectorAll('[required], input[type="url"]')) c.removeAttribute('aria-invalid');
		const malos = invalidosEn(paso);
		if (!malos.length) return true;
		for (const c of malos) c.setAttribute('aria-invalid', 'true');
		if (n === 2) mostrar(malos[0].name === 'enlace' ? 'enlace' : 'mensaje');
		else mostrar(malos.length === 1 && malos[0].name === 'consentimiento' ? 'consentimiento' : 'personales');
		malos[0].focus();
		return false;
	}

	siguiente.addEventListener('click', () => {
		if (!revisarPaso(actual)) return;
		limpiarEstado();
		avanzar(actual + 1);
	});
	atras.addEventListener('click', () => {
		limpiarEstado();
		if (history.state?.paso === actual && actual > 1) history.back();
		else irA(actual - 1);
	});
	for (const li of marcas) {
		li.querySelector('button')!.addEventListener('click', () => {
			const n = Number(li.dataset.i);
			if (n >= actual) return;
			limpiarEstado();
			// Volver varios pasos de una vez: se retrocede en el historial lo mismo.
			if (history.state?.paso === actual) history.go(n - actual);
			else irA(n);
		});
	}
	// Al quitar la marca roja cuando la persona corrige.
	form.addEventListener('input', (e) => {
		const c = e.target as HTMLElement;
		if (c.getAttribute('aria-invalid') === 'true' && (c as HTMLInputElement).checkValidity?.()) c.removeAttribute('aria-invalid');
	});

	const params = new URLSearchParams(location.search);
	// "Cotizar …" desde la ficha de un servicio (MosaicoServicios) llega con ?servicio=slug.
	const pedido = params.get('servicio');
	const opcionServicio = pedido ? form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${CSS.escape(pedido)}"]`) : null;
	if (opcionServicio) opcionServicio.checked = true;

	// Resultado del envío sin JavaScript (redirección con ?enviado / ?error).
	if (params.has('enviado')) mostrar('enviado', true);
	else if (params.has('error')) noEnviada(params.get('error')!);

	// Planos, modelos, fotos o documentos: máximo 5, de MAX_MB cada uno; las fotos pesadas se
	// achican al elegirlas (src/scripts/adjuntos.ts). El servidor vuelve a revisarlo.
	const archivos = form.querySelector<HTMLInputElement>('#f-archivos')!;
	const adjuntos = prepararAdjuntos(archivos, {
		extensiones: extCotizacion,
		maxArchivos: 5,
		noRecibido: 'no es un formato que recibamos. Si es de otro programa (o un RAR o 7z), póngalo en un ZIP o pegue un enlace más abajo.',
		correo: archivos.dataset.correo ?? '',
	});
	archivos.addEventListener('change', () => {
		if (estado.dataset.tipo === 'error') limpiarEstado();
	});

	// Paso en que vive un campo (para llevar a la persona al error que devuelve el servidor).
	const pasoDe = (el: Element | null) => (el ? pasos.findIndex((p) => p.contains(el)) + 1 || 1 : 1);

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		// Enter en un campo de un paso intermedio = Siguiente.
		if (actual < TOTAL) {
			siguiente.click();
			return;
		}
		// Por si algo de un paso anterior quedó mal (p. ej., al volver con Atrás y borrar).
		for (let n = 1; n <= TOTAL; n++) {
			const malos = invalidosEn(pasos[n - 1]);
			if (malos.length) {
				if (n !== actual) irA(n);
				revisarPaso(n);
				estado.textContent = `Aún no se envía su solicitud. ${estado.textContent}`;
				return;
			}
		}
		enviar.disabled = true;
		delete estado.dataset.tipo;
		// Si una foto se está achicando, se espera a que termine.
		estado.textContent = 'Preparando los archivos…';
		await adjuntos.listo();
		estado.textContent = 'Enviando…';
		try {
			const cuerpo = new FormData(form);
			adjuntos.ponerEn(cuerpo);
			const r = await fetch(form.action, { method: 'POST', body: cuerpo, headers: { Accept: 'application/json' } });
			const datos = await r.json().catch(() => ({ ok: false, error: 'otro' }));
			if (datos.ok) {
				form.reset();
				adjuntos.vaciar();
				limpiarEstado();
				form.classList.add('enviado');
				gracias.hidden = false;
				gracias.focus({ preventScroll: true });
				if (form.getBoundingClientRect().top < 0) form.scrollIntoView({ block: 'start' });
			} else {
				const error = datos.error ?? 'otro';
				const campo =
					error === 'archivos' || error === 'zip'
						? archivos
						: error === 'enlace'
							? form.querySelector('#f-enlace')
							: error === 'consentimiento'
								? form.querySelector('#f-consentimiento')
								: null;
				if (campo && pasoDe(campo) !== actual) irA(pasoDe(campo));
				noEnviada(error);
			}
		} catch {
			noEnviada('red');
		} finally {
			enviar.disabled = false;
		}
	});

	form.querySelector('[data-otra]')!.addEventListener('click', () => {
		form.classList.remove('enviado');
		gracias.hidden = true;
		(form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now());
		history.replaceState({ paso: 1 }, '');
		irA(1);
	});

	// Al cargar: paso 1 (o el de un error que volvió sin JavaScript).
	history.replaceState({ paso: 1 }, '');
	const errorInicial = params.get('error');
	irA(['archivos', 'zip', 'enlace'].includes(errorInicial ?? '') ? 2 : errorInicial === 'datos' || errorInicial === 'consentimiento' ? 3 : 1, { enfocar: false });
</script>

<style>
	/* Los campos comparten estilos con la postulación: src/styles/formulario.css. */
	.cotiza {
		scroll-margin-top: 6rem;
		/* El paso que entra desde el lado no debe ensanchar la página en el celular: se recorta a
		   lo ancho, con 0,5 rem de aire para que el contorno de foco de los botones no se corte. */
		overflow-x: clip;
		margin-inline: -0.5rem;
		padding-inline: 0.5rem;
	}
	.paso {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.paso:focus {
		outline: none;
	}
	/* La leyenda lleva la línea de arriba (el borde del fieldset la cortaría). */
	.paso > legend {
		width: 100%;
		margin-bottom: 1.25rem;
		padding: 1.25rem 0 0;
		border-top: 1px solid var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.ayuda-paso {
		margin: 0;
		font-size: 0.9rem;
		color: var(--gris-medio);
	}

	/* Sin JavaScript: los tres pasos seguidos y solo el botón Enviar. */
	.avance,
	.atras,
	[data-siguiente],
	.ayuda-paso {
		display: none;
	}

	/* ─── Con JavaScript: por pasos ─── */
	:global(.cotiza-js) .avance {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0 0 0.25rem;
		padding: 0;
		list-style: none;
	}
	:global(.cotiza-js) .ayuda-paso {
		display: block;
	}
	:global(.cotiza-js) .paso > legend {
		/* La barra de avance ya hace de separador: la leyenda queda como título del paso. */
		padding-top: 0;
		border-top: 0;
