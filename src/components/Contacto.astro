---
// Cierre de página (nivel 1): una frase y el botón. Teléfono, correo y dirección están en el
// pie, justo debajo, y en la barra de contacto del celular; el formulario, en /contacto/.
import EjesPlano from './EjesPlano.astro';

interface Props {
	titulo?: string;
}
const { titulo = 'Hablemos de su proyecto' } = Astro.props;
---

<section class="seccion oscura plano contacto">
	<EjesPlano filas={3} />
	<div class="contenedor fila">
		<h2>{titulo}</h2>
		<a href="/contacto/" class="boton">Solicitar cotización</a>
	</div>
</section>

<style>
	.fila {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}
	h2 {
		max-width: 14ch;
		margin: 0;
		font-size: clamp(2.25rem, 5.5vw, 4.5rem);
	}
</style>
