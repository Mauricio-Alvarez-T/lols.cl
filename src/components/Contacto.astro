---
// Cierre de página (nivel 1): una frase y el botón. Teléfono, correo y dirección están en el
// pie, justo debajo, y en la barra de contacto del celular; el formulario, en /cotizar/.
// Centrado, la frase arriba y el botón abajo (Marcos, 20-10-2026).
import EjesPlano from './EjesPlano.astro';

interface Props {
	titulo?: string;
}
const { titulo = 'Hablemos de su proyecto' } = Astro.props;
---

<section class="seccion oscura plano contacto">
	<EjesPlano filas={3} />
	<div class="contenedor fila">
		<h2>{titulo}</h2>
		<a href="/cotizar/" class="boton">Solicitar cotización</a>
	</div>
</section>

<style>
	.fila {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
	}
	h2 {
		max-width: 14ch;
		margin: 0;
		text-wrap: balance;
		font-size: clamp(2.25rem, 5.5vw, 4.5rem);
	}
</style>
