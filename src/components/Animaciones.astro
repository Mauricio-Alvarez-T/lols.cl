---
// Movimiento con JS mínimo (estilos en src/styles/animaciones.css): solo la sombra del
// encabezado al bajar. El momento de carga de la portada y las transiciones entre páginas
// son CSS puro. Si este script no corre, Base.astro quita html.anim a los 3 s.
---

<script>
	declare global {
		interface Window {
			__animaciones?: boolean;
		}
	}
	window.__animaciones = true;

	// Encabezado: transparente sobre la cabecera con imagen de cada página (se integra a la obra
	// en vez de verse como una barra aparte) y sólido al bajar. Solo con JS: sin él queda sólido.
	// Un solo listener pasivo, sin trabajo por cada píxel.
	const encabezado = document.querySelector('.encabezado');
	if (encabezado) {
		document.documentElement.classList.add('encabezado-flotante');
		let pendiente = false;
		const actualizar = () => {
			encabezado.classList.toggle('con-sombra', window.scrollY > 8);
			pendiente = false;
		};
		window.addEventListener(
			'scroll',
			() => {
				if (!pendiente) {
					pendiente = true;
					requestAnimationFrame(actualizar);
				}
			},
			{ passive: true },
		);
		actualizar();
	}
</script>
