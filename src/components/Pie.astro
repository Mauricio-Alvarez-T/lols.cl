---
// Pie como sección diseñada: datos de contacto en columnas, rutas del sitio y de otros
// públicos y datos legales (la columna de Seguridad se sacó el 20-10-2026, con la página). Todo sobre el verde
// de LOLS, para que cada página termine con la marca (como el pie rojo de Arup). La frase de
// cierre la pone el bloque Contacto, justo antes.
// El teléfono se abre con tres opciones: llamar, escribir por WhatsApp o guardarlo en los contactos
// del equipo (Marcos, 11-11-2026); por eso ya no va la línea suelta «WhatsApp». Es un <details>:
// funciona sin JavaScript y con teclado.
import Pendiente from './Pendiente.astro';
import { empresa, navegacion, telefonoHref, whatsappHref, contactoVcardHref, fundacion } from '../data/empresa';

const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor columnas">
		<div>
			<h2>Contacto</h2>
			<address>
				<p>{empresa.direccion.valor}</p>
				<details class="telefono">
					<summary>
						<span>{empresa.telefono.valor}</span>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
					</summary>
					{empresa.telefono.pendiente && <Pendiente texto={empresa.telefono.pendiente} />}
					<ul class="opciones">
						<li><a href={telefonoHref(empresa.telefono.valor)}>Llamar</a></li>
						<li><a href={whatsappHref()} target="_blank" rel="noopener">Escribir por WhatsApp</a></li>
						<li><a href={contactoVcardHref()} download="LOLS Ingenieria.vcf">Guardar en mis contactos</a></li>
					</ul>
				</details>
				<p><a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a></p>
				<p>{empresa.horario}</p>
			</address>
		</div>
		<nav aria-label="Sitio">
			<h2>Sitio</h2>
			<ul>
				{navegacion.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
			</ul>
		</nav>
		<nav aria-label="Otros públicos">
			<h2>También</h2>
			<ul>
				<li><a href="/privacidad/">Política de privacidad</a></li>
			</ul>
		</nav>
	</div>

	<div class="contenedor legal">
		<p>© {anio} {empresa.razonSocial} · Desde {fundacion}</p>
		<p>RUT {empresa.rut}</p>
	</div>
</footer>

<style>
	.pie {
		background: var(--lols-verde-oscuro);
		color: var(--lols-blanco);
		font-size: 0.95rem;
	}
	.columnas {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 2.5rem;
		padding-block: clamp(3rem, 6vw, 4.5rem) 2.5rem;
	}
	h2 {
		margin-bottom: 1rem;
		font-family: var(--fuente-datos);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0;
		color: rgb(255 255 255 / 0.8);
	}
	address {
		font-style: normal;
	}
	address p {
		margin: 0 0 0.4rem;
	}
	.telefono {
		margin: 0 0 0.4rem;
	}
	.telefono summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		cursor: pointer;
		list-style: none;
	}
	.telefono summary::-webkit-details-marker {
		display: none;
	}
	.telefono summary:hover {
		color: var(--lols-lima);
	}
	.telefono svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.2s var(--suave);
	}
	.telefono[open] svg {
		transform: rotate(180deg);
	}
	.opciones {
		gap: 0;
		margin: 0.5rem 0 0.25rem;
		border-left: 2px solid rgb(255 255 255 / 0.35);
	}
	.opciones a {
		display: flex;
		align-items: center;
		min-height: 2.25rem;
		padding-left: 0.85rem;
		background: none;
	}
	.opciones a:hover {
		background: rgb(255 255 255 / 0.08);
	}
	/* Celular: cada opción con al menos 44 px de alto para el dedo. */
	@media (pointer: coarse) {
		.telefono summary {
			min-height: 44px;
		}
		.opciones a {
			min-height: 44px;
		}
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	a {
		color: var(--lols-blanco);
		text-decoration: none;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
		transition: background-size 0.25s var(--suave);
	}
	a:hover {
		color: var(--lols-lima);
		background-size: 100% 1px;
	}
	.legal {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-block: 1.25rem;
		font-size: 0.85rem;
		color: rgb(255 255 255 / 0.8);
		border-top: 1px solid rgb(255 255 255 / 0.18);
	}
	.legal p {
		margin: 0;
	}
	@media (max-width: 860px) {
		.columnas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 480px) {
		.columnas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
