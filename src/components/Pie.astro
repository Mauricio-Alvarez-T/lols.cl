---
import Logo from './Logo.astro';
import Pendiente from './Pendiente.astro';
import { empresa, navegacion, servicios, telefonoHref } from '../data/empresa';

const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor grilla">
		<div class="col-marca">
			<Logo class="logo" />
			<p class="lema">{empresa.lema}</p>
		</div>
		<div>
			<h2>Servicios</h2>
			<ul>
				{servicios.map((s) => <li><a href={`/servicios/${s.slug}/`}>{s.nombre}</a></li>)}
			</ul>
		</div>
		<div>
			<h2>Sitio</h2>
			<ul>
				{navegacion.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
			</ul>
		</div>
		<div>
			<h2>Contacto</h2>
			<address>
				<p>
					<Pendiente revisar={empresa.direccion.revisar}>{empresa.direccion.valor}</Pendiente>
				</p>
				<p>
					<Pendiente revisar={empresa.telefono.revisar}>
						<a href={telefonoHref(empresa.telefono.valor)}>{empresa.telefono.valor}</a>
					</Pendiente>
				</p>
				<p>
					<Pendiente revisar={empresa.correo.revisar}>
						<a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a>
					</Pendiente>
				</p>
			</address>
		</div>
	</div>
	<div class="contenedor legal">
		<p>© {anio} {empresa.razonSocial}</p>
		<a href="/privacidad/">Política de privacidad</a>
	</div>
</footer>

<style>
	.pie {
		background: var(--lols-carbon);
		color: #d6d6d6;
		padding-top: clamp(3rem, 7vw, 4.5rem);
		font-size: 0.95rem;
	}
	.grilla {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 2.5rem;
	}
	.col-marca :global(.logo) {
		width: 10rem;
		height: auto;
		color: var(--lols-blanco);
	}
	.lema {
		margin-top: 1rem;
		color: var(--lols-lima);
		font-family: var(--fuente-titulos);
		font-weight: 600;
	}
	h2 {
		margin-bottom: 1rem;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--lols-blanco);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	address {
		font-style: normal;
	}
	address p {
		margin-bottom: 0.5rem;
	}
	a {
		color: #d6d6d6;
		text-decoration: none;
	}
	a:hover {
		color: var(--lols-blanco);
		text-decoration: underline;
	}
	.legal {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 3rem;
		padding-block: 1.5rem;
		border-top: 1px solid #2e2e2e;
		font-size: 0.85rem;
		color: #a3a3a3;
	}
	.legal p {
		margin: 0;
	}
	@media (max-width: 860px) {
		.grilla {
			grid-template-columns: 1fr 1fr;
		}
		.col-marca {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.grilla {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
