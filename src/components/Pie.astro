---
// Pie mínimo (patrón Heatherwick): marca, datos de contacto y lo legal.
import Logo from './Logo.astro';
import Pendiente from './Pendiente.astro';
import { empresa, navegacion, otrosPublicos, telefonoHref } from '../data/empresa';

const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor fila">
		<a href="/" class="marca" aria-label="LOLS Ingeniería, inicio"><Logo class="logo" /></a>
		<nav aria-label="Pie de página">
			<ul>
				{navegacion.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
			</ul>
			<ul class="secundario">
				{otrosPublicos.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
			</ul>
		</nav>
		<address>
			<Pendiente revisar={empresa.direccion.revisar}>{empresa.direccion.valor}</Pendiente><br />
			<Pendiente revisar={empresa.telefono.revisar}>
				<a href={telefonoHref(empresa.telefono.valor)}>{empresa.telefono.valor}</a>
			</Pendiente>
			·
			<Pendiente revisar={empresa.correo.revisar}>
				<a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a>
			</Pendiente>
		</address>
	</div>
	<div class="contenedor legal">
		<p>© {anio} {empresa.razonSocial}</p>
		<a href="/privacidad/">Política de privacidad</a>
	</div>
</footer>

<style>
	.pie {
		border-top: 1px solid var(--linea);
		font-size: 0.95rem;
	}
	.fila {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: start;
		gap: 2.5rem;
		padding-block: 3rem;
	}
	.marca {
		color: var(--lols-verde);
	}
	.marca :global(.logo) {
		width: 8rem;
		height: auto;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
	}
	nav a {
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--lols-verde-oscuro);
	}
	.secundario {
		margin-top: 0.75rem;
	}
	.secundario a {
		font-family: var(--fuente-texto);
		font-weight: 500;
		color: var(--lols-gris);
	}
	address {
		font-style: normal;
		text-align: right;
		line-height: 1.8;
		color: var(--lols-gris);
	}
	.legal {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-block: 1.25rem;
		border-top: 1px solid var(--linea);
		font-size: 0.85rem;
		color: var(--gris-medio);
	}
	.legal p {
		margin: 0;
	}
	.legal a {
		color: var(--gris-medio);
	}
	@media (max-width: 860px) {
		.fila {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.75rem;
		}
		address {
			text-align: left;
		}
	}
</style>
