---
// Tarjeta de proyecto (nivel 1 de la divulgación progresiva, docs/estructura.md § Mostrar, no
// contar): foto, pictograma del tipo de obra (como BIG), nombre y comuna. Nada más: el tipo,
// la superficie, las fechas y la dirección están en la ficha, a un clic. Toda la tarjeta es el
// enlace. Al hacer clic, su foto viaja a la portada de la ficha (view transition).
import Pendiente from './Pendiente.astro';
import Pictograma from './Pictograma.astro';
import { plantilla, estados, pictogramaDeTipo, fotoPrincipal, type Estado, type Proyecto } from '../data/proyectos';
import type { ImagenReferencial } from '../data/referencia';
import Referencial from './Referencial.astro';

interface Props {
	proyecto?: Proyecto; // sin proyecto = tarjeta de muestra
	referencia?: ImagenReferencial; // foto y datos de ejemplo para la tarjeta de muestra
	estado?: Estado; // estado de la tarjeta de muestra (las reales lo traen en el proyecto)
	lamina?: number; // (sin uso en la tarjeta; se conserva por compatibilidad)
	destacada?: boolean;
}
const { proyecto, referencia, lamina, destacada = false } = Astro.props;
const estado = proyecto?.estado ?? Astro.props.estado ?? 'terminado';
const enObra = estado === 'en-curso';
const foto = proyecto ? fotoPrincipal(proyecto) : undefined;
// Las tarjetas de muestra llevan a la ficha de ejemplo mientras no haya proyectos reales.
const href = `/proyectos/${proyecto?.slug ?? plantilla.slug}/`;
const ej = referencia?.ejemplo;
const tipo = proyecto?.tipo ?? ej?.tipo;
---

<article class:list={['tarjeta', { destacada, 'en-obra': enObra }]} data-estado={estado}>
	<a href={href} class="vinculo">
		<div class="foto marco">
			{foto && 'origen' in foto ? <Referencial imagen={foto} /> : foto ? <img src={foto.src} alt={foto.alt} loading="lazy" /> : referencia ? <Referencial imagen={referencia} /> : <Pendiente bloque texto="foto" />}
			{enObra && <span class="sello">{estados['en-curso']}</span>}
		</div>
		<div class="titulo">
			<span class="picto" title={tipo ?? undefined}>
				<Pictograma nombre={pictogramaDeTipo(tipo)} />
			</span>
			<div>
				<h3>{proyecto?.nombre ?? <Pendiente texto="nombre del proyecto">{ej?.nombre}</Pendiente>}</h3>
				<p class="ubicacion">{proyecto?.comuna ?? <Pendiente texto="comuna">{ej?.comuna}</Pendiente>}</p>
			</div>
		</div>
	</a>
</article>

<script>
	// Transición entre páginas: solo la foto de la tarjeta clicada se llama "foto-proyecto",
	// igual que la portada de la ficha, para que el navegador la haga viajar.
	for (const a of document.querySelectorAll<HTMLAnchorElement>('.tarjeta .vinculo')) {
		a.addEventListener('click', () => {
			const foto = a.querySelector<HTMLElement>('.foto');
			if (foto) foto.style.viewTransitionName = 'foto-proyecto';
		});
	}
	// Al volver con "atrás", limpiar el nombre para que no quede duplicado.
	addEventListener('pageshow', () => {
		for (const f of document.querySelectorAll<HTMLElement>('.tarjeta .foto')) f.style.viewTransitionName = '';
	});
</script>

<style>
	.vinculo {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	.destacada .foto {
		aspect-ratio: 16 / 10;
	}
	.foto :global(img) {
		transition: transform 0.4s var(--suave);
	}
	.vinculo:hover .foto :global(img) {
		transform: scale(1.03);
	}
	h3 {
		margin-bottom: 0.25rem;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
		width: fit-content;
		transition: background-size 0.25s var(--suave);
	}
	.vinculo:hover h3 {
		color: var(--lols-verde-oscuro);
		background-size: 100% 2px;
	}
	.titulo {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.85rem;
		align-items: start;
	}
	/* Pictograma del tipo de obra: zócalo verde del isotipo con el dibujo en blanco. */
	.picto {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		background: var(--lols-verde);
		color: var(--lols-blanco);
		transition: background-color 0.2s;
	}
	.picto :global(.pictograma) {
		width: 1.7rem;
		height: 1.7rem;
	}
	.vinculo:hover .picto {
		background: var(--lols-verde-oscuro);
	}
	.destacada .picto {
		width: 3.25rem;
		height: 3.25rem;
	}
	.destacada .picto :global(.pictograma) {
		width: 2rem;
		height: 2rem;
	}
	.ubicacion {
		margin: 0 0 0.75rem;
		color: var(--gris-medio);
		font-size: 0.95rem;
	}
	/* Sello "En construcción" sobre la foto: punto verde + texto, como el rótulo de estado de
	   una lámina vigente. */
	.foto {
		position: relative;
	}
	.sello {
		grid-area: 1 / 1;
		align-self: start;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.75rem;
		padding: 0.3rem 0.65rem 0.3rem 0.55rem;
		background: var(--lols-blanco);
		color: var(--lols-carbon);
		font: 600 0.8rem/1.2 var(--fuente-datos);
		z-index: 1;
	}
	.sello::before {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--lols-verde);
	}
	.destacada h3 {
		font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
	}

</style>
