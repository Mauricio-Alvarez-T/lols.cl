---
// Tarjeta de proyecto: foto + nombre + rótulo de lámina con los mismos campos en todas
// (patrón BIG + convención del cuadro de rótulo de un plano). Campos según la reunión con
// don Luis: tipo de obra, superficie, comuna y, en las obras en construcción, la dirección y
// desde cuándo. Junto al nombre, el pictograma LOLS del tipo de obra (como los íconos de
// proyecto de BIG). `destacada` la agranda para dar jerarquía en la grilla. Al hacer clic,
// su foto viaja a la portada de la ficha (view transition).
import Pendiente from './Pendiente.astro';
import Pictograma from './Pictograma.astro';
import { plantilla, estados, pictogramaDeTipo, type Estado, type Proyecto } from '../data/proyectos';
import type { ImagenReferencial } from '../data/referencia';
import Referencial from './Referencial.astro';

interface Props {
	proyecto?: Proyecto; // sin proyecto = tarjeta de muestra
	referencia?: ImagenReferencial; // foto y datos de ejemplo para la tarjeta de muestra
	estado?: Estado; // estado de la tarjeta de muestra (las reales lo traen en el proyecto)
	lamina?: number; // número correlativo en la grilla
	destacada?: boolean;
}
const { proyecto, referencia, lamina, destacada = false } = Astro.props;
const estado = proyecto?.estado ?? Astro.props.estado ?? 'terminado';
const enObra = estado === 'en-curso';
const foto = proyecto?.fotos[0];
// Las tarjetas de muestra llevan a la ficha de ejemplo mientras no haya proyectos reales.
const href = `/proyectos/${proyecto?.slug ?? plantilla.slug}/`;
const ej = referencia?.ejemplo;
const tipo = proyecto?.tipo ?? ej?.tipo;
const numero = lamina ? `L-${String(lamina).padStart(2, '0')}` : null;
// Última celda: en una obra terminada importa el año; en una en construcción, desde cuándo.
const fecha = enObra
	? { titulo: 'Inicio', valor: proyecto?.inicio, pendiente: 'mes y año de inicio', ejemplo: ej?.inicio }
	: { titulo: 'Año', valor: proyecto?.anio, pendiente: 'año de término', ejemplo: ej?.anio };
---

<article class:list={['tarjeta', { destacada, 'en-obra': enObra }]} data-estado={estado}>
	<a href={href} class="vinculo">
		<div class="foto marco">
			{foto ? <img src={foto.src} alt={foto.alt} loading="lazy" /> : referencia ? <Referencial imagen={referencia} /> : <Pendiente bloque texto="foto" />}
			{enObra && <span class="sello">{estados['en-curso']}</span>}
		</div>
		<div class="titulo">
			<span class="picto" title={tipo ?? undefined}>
				<Pictograma nombre={pictogramaDeTipo(tipo)} />
			</span>
			<div>
				<h3>{proyecto?.nombre ?? <Pendiente texto="nombre del proyecto">{ej?.nombre}</Pendiente>}</h3>
				<p class="ubicacion">
					{proyecto?.comuna ?? <Pendiente texto="comuna">{ej?.comuna}</Pendiente>}
					{enObra && (
						<>
							{' · '}
							{proyecto?.direccion ?? <Pendiente texto="dirección (confirmar si se puede publicar)">{ej?.direccion}</Pendiente>}
						</>
					)}
				</p>
			</div>
		</div>
		<dl class="rotulo">
			<div>
				<dt>Tipo</dt>
				<dd>{proyecto?.tipo ?? <Pendiente texto="tipo de obra">{ej?.tipo}</Pendiente>}</dd>
			</div>
			<div>
				<dt>Superficie</dt>
				<dd>{proyecto?.superficie ?? <Pendiente texto="m² construidos">{ej?.superficie}</Pendiente>}</dd>
			</div>
			<div>
				<dt>{fecha.titulo}</dt>
				<dd>{fecha.valor ?? <Pendiente texto={fecha.pendiente}>{fecha.ejemplo}</Pendiente>}</dd>
			</div>
			{
				numero && (
					<div class="lamina">
						<dt>Lámina</dt>
						<dd>{numero}</dd>
					</div>
				)
			}
		</dl>
	</a>
</article>

<script>
	// Transición entre páginas: solo la foto de la tarjeta clicada se llama "foto-proyecto",
	// igual que la portada de la ficha, para que el navegador la haga viajar.
	for (const a of document.querySelectorAll<HTMLAnchorElement>('.tarjeta .vinculo')) {
		a.addEventListener('click', () => {
			const foto = a.querySelector<HTMLElement>('.foto');
			if (foto) foto.style.viewTransitionName = 'foto-proyecto';
		});
	}
	// Al volver con "atrás", limpiar el nombre para que no quede duplicado.
	addEventListener('pageshow', () => {
		for (const f of document.querySelectorAll<HTMLElement>('.tarjeta .foto')) f.style.viewTransitionName = '';
	});
</script>

<style>
	.vinculo {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	.destacada .foto {
		aspect-ratio: 16 / 10;
	}
	.foto :global(img) {
		transition: transform 0.4s var(--suave);
	}
	.vinculo:hover .foto :global(img) {
		transform: scale(1.03);
	}
	h3 {
		margin-bottom: 0.25rem;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
		width: fit-content;
		transition: background-size 0.25s var(--suave);
	}
	.vinculo:hover h3 {
		color: var(--lols-verde-oscuro);
		background-size: 100% 2px;
	}
	.titulo {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.85rem;
		align-items: start;
	}
	/* Pictograma del tipo de obra: zócalo verde del isotipo con el dibujo en blanco. */
	.picto {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		background: var(--lols-verde);
		color: var(--lols-blanco);
		transition: background-color 0.2s;
	}
	.picto :global(.pictograma) {
		width: 1.7rem;
		height: 1.7rem;
	}
	.vinculo:hover .picto {
		background: var(--lols-verde-oscuro);
	}
	.destacada .picto {
		width: 3.25rem;
		height: 3.25rem;
	}
	.destacada .picto :global(.pictograma) {
		width: 2rem;
		height: 2rem;
	}
	.ubicacion {
		margin: 0 0 0.75rem;
		color: var(--gris-medio);
		font-size: 0.95rem;
	}
	/* Sello "En construcción" sobre la foto: punto verde + texto, como el rótulo de estado de
	   una lámina vigente. */
	.foto {
		position: relative;
	}
	.sello {
		grid-area: 1 / 1;
		align-self: start;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.75rem;
		padding: 0.3rem 0.65rem 0.3rem 0.55rem;
		background: var(--lols-blanco);
		color: var(--lols-carbon);
		font: 600 0.8rem/1.2 var(--fuente-datos);
		z-index: 1;
	}
	.sello::before {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--lols-verde);
	}
	.destacada h3 {
		font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
	}

	/* Rótulo de lámina: celdas con línea de dibujo, etiqueta condensada. */
	.rotulo {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
		margin: 0;
		border-top: 1px solid var(--lols-carbon);
	}
	.rotulo > div {
		padding: 0.45rem 0.6rem 0.5rem 0;
		border-bottom: 1px solid var(--linea);
	}
	.rotulo > div + div {
		padding-left: 0.6rem;
		border-left: 1px solid var(--linea);
	}
	.rotulo dt {
		font-family: var(--fuente-datos);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--gris-medio);
	}
	.rotulo dd {
		margin: 0.1rem 0 0;
		font-size: 0.92rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.lamina dd {
		font-family: var(--fuente-datos);
		font-weight: 600;
		color: var(--lols-verde-oscuro);
	}
</style>
