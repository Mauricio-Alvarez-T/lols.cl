---
// Tarjeta de proyecto: foto + nombre + rótulo de lámina con los mismos campos en todas
// (patrón BIG + convención del cuadro de rótulo de un plano). `destacada` la agranda para dar
// jerarquía en la grilla. Al hacer clic, su foto viaja a la portada de la ficha (view transition).
import Pendiente from './Pendiente.astro';
import { servicioPorSlug } from '../data/empresa';
import { plantilla, type Proyecto } from '../data/proyectos';
import type { ImagenReferencial } from '../data/referencia';
import Referencial from './Referencial.astro';

interface Props {
	proyecto?: Proyecto; // sin proyecto = tarjeta de muestra
	referencia?: ImagenReferencial; // foto y datos de ejemplo para la tarjeta de muestra
	lamina?: number; // número correlativo en la grilla
	destacada?: boolean;
}
const { proyecto, referencia, lamina, destacada = false } = Astro.props;
const foto = proyecto?.fotos[0];
const servicio = proyecto?.servicios[0] ? servicioPorSlug(proyecto.servicios[0]).nombre : null;
// Las tarjetas de muestra llevan a la ficha de ejemplo mientras no haya proyectos reales.
const href = `/proyectos/${proyecto?.slug ?? plantilla.slug}/`;
const ej = referencia?.ejemplo;
const numero = lamina ? `L-${String(lamina).padStart(2, '0')}` : null;
---

<article class:list={['tarjeta', { destacada }]} data-servicios={proyecto?.servicios.join(' ')} data-estado={proyecto?.estado}>
	<a href={href} class="vinculo">
		<div class="foto marco">
			{foto ? <img src={foto.src} alt={foto.alt} loading="lazy" /> : referencia ? <Referencial imagen={referencia} /> : <Pendiente bloque texto="foto" />}
		</div>
		<h3>{proyecto?.nombre ?? <Pendiente texto="nombre del proyecto">{ej?.nombre}</Pendiente>}</h3>
		<dl class="rotulo">
			<div>
				<dt>Servicio</dt>
				<dd>{servicio ?? <Pendiente texto="servicio">{ej?.servicio}</Pendiente>}</dd>
			</div>
			<div>
				<dt>Comuna</dt>
				<dd>{proyecto?.comuna ?? <Pendiente texto="comuna">{ej?.comuna}</Pendiente>}</dd>
			</div>
			<div>
				<dt>Año</dt>
				<dd>{proyecto?.anio ?? <Pendiente texto="año">{ej?.anio}</Pendiente>}</dd>
			</div>
			{
				numero && (
					<div class="lamina">
						<dt>Lámina</dt>
						<dd>{numero}</dd>
					</div>
				)
			}
		</dl>
	</a>
</article>

<script>
	// Transición entre páginas: solo la foto de la tarjeta clicada se llama "foto-proyecto",
	// igual que la portada de la ficha, para que el navegador la haga viajar.
	for (const a of document.querySelectorAll<HTMLAnchorElement>('.tarjeta .vinculo')) {
		a.addEventListener('click', () => {
			const foto = a.querySelector<HTMLElement>('.foto');
			if (foto) foto.style.viewTransitionName = 'foto-proyecto';
		});
	}
	// Al volver con "atrás", limpiar el nombre para que no quede duplicado.
	addEventListener('pageshow', () => {
		for (const f of document.querySelectorAll<HTMLElement>('.tarjeta .foto')) f.style.viewTransitionName = '';
	});
</script>

<style>
	.vinculo {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	.destacada .foto {
		aspect-ratio: 16 / 10;
	}
	.foto :global(img) {
		transition: transform 0.4s var(--suave);
	}
	.vinculo:hover .foto :global(img) {
		transform: scale(1.03);
	}
	h3 {
		margin-bottom: 0.75rem;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
		width: fit-content;
		transition: background-size 0.25s var(--suave);
	}
	.vinculo:hover h3 {
		color: var(--lols-verde-oscuro);
		background-size: 100% 2px;
	}
	.destacada h3 {
		font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
	}

	/* Rótulo de lámina: celdas con línea de dibujo, etiqueta condensada. */
	.rotulo {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
		margin: 0;
		border-top: 1px solid var(--lols-carbon);
	}
	.rotulo > div {
		padding: 0.45rem 0.6rem 0.5rem 0;
		border-bottom: 1px solid var(--linea);
	}
	.rotulo > div + div {
		padding-left: 0.6rem;
		border-left: 1px solid var(--linea);
	}
	.rotulo dt {
		font-family: var(--fuente-datos);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--gris-medio);
	}
	.rotulo dd {
		margin: 0.1rem 0 0;
		font-size: 0.92rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.lamina dd {
		font-family: var(--fuente-datos);
		font-weight: 600;
		color: var(--lols-verde-oscuro);
	}
</style>
