---
// Ícono de servicio: pictograma LOLS (Pictograma.astro), dibujado con la geometría del isotipo.
import Pictograma from './Pictograma.astro';
import type { Servicio } from '../data/empresa';

interface Props {
	nombre: Servicio['icono'];
}
const { nombre } = Astro.props;
---

<Pictograma nombre={nombre} class="icono" />
