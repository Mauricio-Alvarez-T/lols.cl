---
// Ficha de servicio (nivel 2): el problema que resuelve, cómo y obras donde se ha hecho. Se
// despliega bajo la fila del mosaico (MosaicoServicios). Sin el detalle de especialidades
// ("qué hacemos / para quién"): don Luis pidió no especificarlas (08-10-2026).
import Pendiente from './Pendiente.astro';
import Pictograma from './Pictograma.astro';
import Referencial from './Referencial.astro';
import type { Servicio } from '../data/empresa';
import { proyectos } from '../data/proyectos';
import { obras2018 } from '../data/referencia';
import { ejemplosServicio } from '../data/ejemplos';

interface Props {
	servicio: Servicio;
	titulo: 'h3' | 'h4';
	sub: 'h4' | 'h5';
}
const { servicio: s, titulo: Titulo, sub: Sub } = Astro.props;
const ej = ejemplosServicio[s.slug];
const fotos = proyectos
	.filter((p) => p.servicios.includes(s.slug) && p.fotos[0])
	.slice(0, 3)
	.map((p) => p.fotos[0]);
---

<div class="ficha-servicio en-panel">
	<header class="cabeza">
		<p class="nombre">
			<Pictograma nombre={s.icono} />
			{s.nombre}
		</p>
		<Titulo class="titulo-ficha" tabindex="-1">
			{s.problema ?? <Pendiente texto="el problema del cliente que este servicio resuelve, como titular">{ej.problema}</Pendiente>}
		</Titulo>
		<p class="resumen">{s.resumen ?? <Pendiente texto="cómo lo resuelve LOLS, en dos líneas">{ej.resumen}</Pendiente>}</p>
	</header>

	<div>
		<Sub class="sr-only">En obra</Sub>
		<div class="fotos">
			{
				fotos.length
					? fotos.map((f) => (
							<div class="marco">
								<img src={f.src} alt={f.alt} loading="lazy" />
							</div>
						))
					: obras2018.slice(0, 3).map((f) => (
							<div class="marco">
								<Referencial imagen={f} sizes="(max-width: 640px) 50vw, 25vw" />
							</div>
						))
			}
		</div>
	</div>
</div>

<style>
	.ficha-servicio {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}
	.nombre {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.75rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--lols-verde-oscuro);
	}
	.nombre :global(.pictograma) {
		width: 1.5rem;
		height: 1.5rem;
		color: var(--lols-verde);
	}
	.titulo-ficha {
		max-width: 28ch;
		margin: 0 0 1rem;
		font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.5rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-wrap: balance;
	}
	.titulo-ficha:focus {
		outline: none;
	}
	.resumen {
		max-width: 60ch;
		margin: 0;
		font-size: 1.15rem;
		color: var(--lols-gris);
	}
	.fotos {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.fotos .marco {
		aspect-ratio: 4 / 3;
	}
</style>
