---
// Seguridad en la portada (nivel 1): la obra en video, un título y dos datos cortos, que es lo
// que un mandante mira primero al precalificar (docs/investigacion-secciones.md). Don Luis
// (08-10-2026): sin indicadores ni ISO; la mutual y la Política de Seguridad y Salud en el
// Trabajo (DS 44), que están en /seguridad/.
import VideoFondo from './VideoFondo.astro';
import EjesPlano from './EjesPlano.astro';
import { empresa } from '../data/empresa';
import { videos } from '../data/referencia';
---

<section class="seccion oscura plano seguridad">
	<EjesPlano />
	<div class="contenedor grilla">
		<div class="texto">
			<p class="etiqueta">Seguridad y calidad</p>
			<h2>Listos para su precalificación</h2>
			<dl class="datos-cortos">
				<div>
					<dt>Mutual</dt>
					<dd>Adheridos a la {empresa.mutual}</dd>
				</div>
				<div>
					<dt>DS 44</dt>
					<dd>Política de Seguridad y Salud en el Trabajo</dd>
				</div>
			</dl>
			<a href="/seguridad/" class="enlace-flecha">Ver la política y la mutualidad</a>
		</div>
		<VideoFondo video={videos.seguridad} clase="video-seguridad" />
	</div>
</section>

<style>
	.grilla {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	h2 {
		margin-bottom: 2rem;
	}
	.datos-cortos {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0 0 2rem;
	}
	.datos-cortos > div {
		padding-top: 1rem;
		border-top: 2px solid var(--lols-verde);
	}
	dt {
		font-family: var(--fuente-titulos);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
		margin-bottom: 0.4rem;
	}
	dd {
		margin: 0;
		color: #c8cfca;
		font-size: 0.95rem;
	}
	.grilla > :global(.video-seguridad) {
		aspect-ratio: 4 / 3;
	}
	@media (max-width: 860px) {
		.grilla {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
