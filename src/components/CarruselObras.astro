---
// Carrusel de obras: réplica del carrusel de destacados de ramboll.com (pedido del usuario:
// "exacto lo mismo"), con código propio y el verde de LOLS. Medido en su sitio a 1440 px:
//   - franja gris desde el borde izquierdo hasta el 45 % del ancho, detrás del texto;
//   - barra de avance arriba, ligada al scroll de la sección (a mitad de recorrido, ~53 %);
//   - encabezado: rótulo en mayúsculas con barra vertical de color y "ver todos" a la derecha;
//   - columna de texto (34 %): categoría, título en peso normal, párrafo liviano. Al cambiar,
//     el texto saliente se va 218 px a la izquierda desvaneciéndose (transform 0,5 s,
//     opacity 0,3 s) y el entrante llega desde la derecha; el título pasa de gris a oscuro;
//   - columna de fotos (66 %, 16:9): la fila se desplaza (transform 0,6 s); las fotos ya
//     pasadas se desvanecen (0,4 s) al cruzar la franja; la siguiente asoma hasta el borde;
//   - flechas en cuadrados de 60 px con borde fino, alineadas a la derecha bajo la foto (en
//     Ramboll son círculos; Marcos pidió cuadrados el 20-10-2026, como el resto del sitio).
// Sin avance automático. Vuelve al principio después de la última. Se puede deslizar con el
// dedo. Sin JavaScript se ve la primera obra y cada título sigue siendo un enlace a su página.
//
// Ficha en el lugar (pedido del usuario: no salir de la página para ver el detalle): con
// "Ver ficha", el título o la foto, la ficha completa (FichaObra) se despliega bajo el
// carrusel; las flechas, de arriba o de la barra de la ficha, cambian la obra y la ficha con
// ella. Atrás, Esc o "Cerrar" la pliegan (src/scripts/despliegue.ts).
//
// Sin ficha (obras sin `ficha` ni `href`, como "Han confiado en nosotros": solo foto y
// dirección, por pedido de don Luis): mismo carrusel, sin "Ver ficha", sin panel y sin enlaces;
// tocar una foto que asoma lleva a esa obra.
//
// Editor visual (docs/editor-visual.md): las obras reales llevan marcas data-ed-* en el texto, la
// foto y la ficha, y la sección dice qué lista es (`lista`). El comportamiento está en
// src/scripts/carrusel.ts, que también atiende a lols:refrescar y lols:ir. Mantener las marcas
// al cambiar el marcado.
import Pendiente from './Pendiente.astro';
import Referencial from './Referencial.astro';
import FichaObra from './FichaObra.astro';
import type { EjemploTarjeta, ImagenReferencial } from '../data/referencia';
import type { FotoObra, Proyecto } from '../data/proyectos';
import type { Regla } from '../data/selecciones';
import { lineaResumen } from '../data/vistaObra';

export interface ObraCarrusel {
	id: string | null; // slug; las muestras reciben uno según su posición
	ed?: string; // obra de la Bóveda (`obras/<slug>`): lleva las marcas del editor visual
	href: string | null; // null: sin página propia (el título y la foto no son enlaces)
	imagen: ImagenReferencial | FotoObra;
	tipo: string | null;
	nombre: string | null;
	comuna: string | null;
	superficie: string | null;
	anio?: string | null; // terminadas: año de término (el portafolio va una obra por año)
	ejemplo?: boolean; // datos de muestra: se marcan con Pendiente
	ficha?: { proyecto: Proyecto; muestra?: EjemploTarjeta }; // sin ficha: el carrusel no la ofrece
}

interface Props {
	obras: ObraCarrusel[];
	titulo: string;
	id?: string;
	enlace?: { href: string; texto: string };
	nota?: string;
	lista?: Regla; // regla de src/data/selecciones.ts que eligió las obras (data-ed-lista)
}
const { obras, titulo, id, enlace, nota, lista } = Astro.props;
const esReferencial = (i: ObraCarrusel['imagen']): i is ImagenReferencial => 'origen' in i;
const seccion = id ?? titulo.toLowerCase().replace(/[^a-z]+/g, '-');
const idTitulo = `carrusel-${seccion}`;
const idPanel = `ficha-${seccion}`;
const idFicha = (o: ObraCarrusel, i: number) => `obra-${o.id ?? `${seccion}-${i + 1}`}`;
const conFicha = obras.every((o) => o.ficha);
---

<section class="carrusel" id={id} aria-labelledby={idTitulo} aria-roledescription="carrusel" data-carrusel data-panel={conFicha ? idPanel : undefined} data-ed-lista={lista} data-ed-vista={lista && 'carrusel'}>
	<div class="avance" aria-hidden="true"><span></span></div>
	<div class="franja" aria-hidden="true"></div>

	<div class="contenedor interior">
		<header class="encabezado-carrusel">
			<h2 id={idTitulo}>{titulo}</h2>
			{nota && <p class="nota">{nota}</p>}
			{
				enlace && (
					<a href={enlace.href} class="ver-todos">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
						{enlace.texto}
					</a>
				)
			}
		</header>
		<slot />

		<div class="cuerpo">
			<div class="textos">
				{
					obras.map((o, i) => (
						<article class:list={['texto', i === 0 ? 'activo' : 'despues']} inert={i === 0 ? undefined : true} data-indice={i} data-ed-item={o.ed}>
							<p class="categoria" data-ed-derivado={o.ed && '/tipo'}>{o.ejemplo ? <Pendiente texto="tipo de obra">{o.tipo}</Pendiente> : o.tipo}</p>
							<h3>
								{o.href ? <a href={o.href} data-ed-campo={o.ed && '/nombre'}>{o.ejemplo ? <Pendiente texto="nombre del proyecto">{o.nombre}</Pendiente> : o.nombre}</a> : o.nombre}
							</h3>
							{o.ejemplo ? (
								<p class="resumen">
									{<Pendiente texto="comuna">{o.comuna}</Pendiente>}
									{o.superficie && (
										<>
											{' · '}
											<Pendiente texto="m² construidos">{o.superficie}</Pendiente>
										</>
									)}
									{o.anio && (
										<>
											{' · '}
											<Pendiente texto="año">{o.anio}</Pendiente>
										</>
									)}
								</p>
							) : (
								<p class="resumen" data-ed-linea={o.ed && 'resumen'}>{lineaResumen(o.comuna, o.superficie, o.anio ?? null)}</p>
							)}
							{conFicha && (
								<button type="button" class="ver-ficha" aria-expanded="false" aria-controls={idPanel} hidden>
									<span>Ver ficha</span>
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
								</button>
							)}
						</article>
					))
				}
			</div>

			<div class="fotos">
				<ul class="pista" style="--i: 0">
					{
						obras.map((o, i) => (
							<li class:list={['foto', { futura: i > 0 }]} aria-hidden={i === 0 ? undefined : 'true'} data-ed-item={o.ed}>
								{o.href ? (
									<a href={o.href} tabindex="-1" class="marco" data-ed-foto={o.ed && '/fotos/0'}>
										{esReferencial(o.imagen) ? (
											<Referencial imagen={o.imagen} sizes="(max-width: 760px) 88vw, 60vw" />
										) : (
											<img src={o.imagen.src} srcset={o.imagen.srcset} sizes={o.imagen.srcset && '(max-width: 760px) 88vw, 60vw'} width={o.imagen.width} height={o.imagen.height} alt={o.imagen.alt} loading="lazy" />
										)}
									</a>
								) : (
									<div class="marco" data-ed-foto={o.ed && '/fotos/0'}>
										{esReferencial(o.imagen) ? (
											<Referencial imagen={o.imagen} sizes="(max-width: 760px) 88vw, 60vw" />
										) : (
											<img src={o.imagen.src} srcset={o.imagen.srcset} sizes={o.imagen.srcset && '(max-width: 760px) 88vw, 60vw'} width={o.imagen.width} height={o.imagen.height} alt={o.imagen.alt} loading="lazy" />
										)}
									</div>
								)}
							</li>
						))
					}
				</ul>
				<div class="controles">
					<button type="button" class="flecha anterior" aria-label="Obra anterior">
						<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 7l-9 9 9 9M7.5 16h18" /></svg>
					</button>
					<button type="button" class="flecha siguiente" aria-label="Obra siguiente">
						<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 7l9 9-9 9M24.5 16h-18" /></svg>
					</button>
				</div>
				<p class="sr-only" aria-live="polite" data-anuncio></p>
			</div>
		</div>
	</div>
</section>

{conFicha && (
<div class="ficha-panel ficha-obras" id={idPanel} role="region" aria-label={`Ficha de obra: ${titulo}`} hidden>
	<div class="ficha-dentro">
		<div class="contenedor">
			<div class="ficha-barra">
				<p class="ficha-rotulo"><span class="rotulo-largo">Ficha de obra</span> <span data-posicion>1 de {obras.length}</span></p>
				<div class="ficha-acciones">
					{
						obras.length > 1 && (
							<>
								<button type="button" class="ficha-boton icono-solo" data-paso="-1" aria-label="Obra anterior">
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
								</button>
								<button type="button" class="ficha-boton icono-solo" data-paso="1" aria-label="Obra siguiente">
									<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
								</button>
							</>
						)
					}
					<button type="button" class="ficha-boton" data-cerrar>
						Cerrar
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
					</button>
				</div>
			</div>
			<div class="fichas">
				{
					obras.map((o, i) => (
						<div data-ficha={idFicha(o, i)} hidden>
							<FichaObra proyecto={o.ficha!.proyecto} muestra={o.ficha!.muestra} nivel={3} />
						</div>
					))
				}
			</div>
			<div class="ficha-pie">
				<a href="/cotizar/" class="boton">Cotizar un proyecto parecido</a>
				<button type="button" class="ficha-boton" data-cerrar>
					Cerrar ficha
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" /></svg>
				</button>
			</div>
		</div>
	</div>
</div>
)}

<script>
	// Flechas, teclado, deslizar y la ficha en el lugar: src/scripts/carrusel.ts.
	import '../scripts/carrusel';
</script>

<style>
	.carrusel {
		--col-texto: 34%;
		--separacion: 40px;
		position: relative;
		overflow: hidden;
		padding-block: 0 4rem;
		view-timeline-name: --carrusel;
		scroll-margin-top: 4.5rem;
	}

	/* Barra de avance ligada al scroll de la sección. */
	.avance {
		position: relative;
		z-index: 2;
		height: 5px;
	}
	.avance span {
		display: block;
		height: 100%;
		background: var(--lols-verde);
		transform-origin: left;
		transform: scaleX(0.5);
	}
	@supports (animation-timeline: view()) {
		.avance span {
			animation: llenar linear both;
			animation-timeline: --carrusel;
			animation-range: cover 0% cover 100%;
		}
	}
	@keyframes llenar {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* Franja gris: desde el borde izquierdo hasta el 45 % del ancho, toda la altura. */
	.franja {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		background: var(--lols-gris-claro);
	}

	.interior {
		position: relative;
		z-index: 1;
	}

	.encabezado-carrusel {
		display: flex;
		align-items: center;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		padding-block: 2.25rem 2.75rem;
	}
	.encabezado-carrusel h2 {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		font-family: var(--fuente-titulos);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.3;
		text-transform: uppercase;
	}
	.encabezado-carrusel h2::before {
		content: '';
		width: 2px;
		height: 1.25rem;
		background: var(--lols-verde);
	}
	.nota {
		margin: 0;
		color: var(--gris-medio);
		font-size: 0.95rem;
	}
	.ver-todos {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-left: auto;
		color: var(--lols-verde-oscuro);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.3s;
	}
	.ver-todos svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		transition: transform 0.5s ease-in-out;
	}
	.ver-todos:hover svg {
		transform: translateX(3px);
	}

	.cuerpo {
		display: grid;
		grid-template-columns: var(--col-texto) minmax(0, 1fr);
	}

	/* Textos apilados en el mismo lugar; solo el activo es visible. */
	.textos {
		position: relative;
		padding-right: 5rem;
	}
	.texto {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(100% - 5rem);
		opacity: 0;
		transition:
			transform 0.5s,
			opacity 0.3s;
	}
	.texto.antes {
		transform: translateX(-218px);
	}
	.texto.despues {
		transform: translateX(218px);
	}
	.texto.activo {
		position: relative;
		width: 100%;
		opacity: 1;
		transform: none;
	}
	.categoria {
		margin: 0 0 1.1rem;
		font-size: 0.95rem;
		color: var(--lols-gris);
	}
	h3 {
		margin: 0 0 1.75rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.6rem, 1.1rem + 1.1vw, 1.9rem);
		font-weight: 450;
		line-height: 1.33;
		letter-spacing: -0.01em;
		color: #7a857f;
		transition: color 0.3s ease-in-out;
	}
	.texto.activo h3 {
		color: var(--lols-carbon);
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--lols-verde-oscuro);
	}
	.resumen {
		margin: 0 0 1.25rem;
		font-size: clamp(1.15rem, 1rem + 0.4vw, 1.3rem);
		font-weight: 300;
		line-height: 1.35;
		color: var(--lols-carbon);
	}

	/* Botón de la ficha: texto visible (no solo al pasar el mouse), como el "ver todos". */
	.ver-ficha {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.75rem;
		padding: 0;
		border: 0;
		border-bottom: 2px solid var(--lols-verde);
		background: none;
		color: var(--lols-verde-oscuro);
		font: 600 1rem var(--fuente-titulos);
		cursor: pointer;
	}
	.ver-ficha[hidden] {
		display: none;
	}
	.ver-ficha svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		transition: transform 0.35s var(--suave);
	}
	.ver-ficha[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.foto .marco {
		cursor: pointer;
	}
	/* Con la ficha abierta, la foto activa queda marcada con una losa verde abajo. */
	.foto .marco::after {
		content: '';
		grid-area: 1 / 1;
		align-self: end;
		height: 6px;
		position: relative; /* encima de la foto (con filter se pinta como posicionada) */
		z-index: 1;
		background: var(--lols-verde);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s var(--suave);
	}
	.con-ficha .foto:not(.futura, .pasada) .marco::after {
		transform: none;
	}

	/* Panel de la ficha (base en global.css). */
	.ficha-obras {
		border-bottom: 1px solid var(--linea);
	}
	.fichas {
		padding-top: clamp(1.75rem, 4vw, 2.75rem);
	}
	.ficha-obras:not(.con-flechas) [data-paso] {
		display: none;
	}
	.ficha-obras.con-flechas [data-paso] {
		animation: flechas-entran 0.3s var(--suave);
	}
	@keyframes flechas-entran {
		from {
			opacity: 0;
			transform: scale(0.85);
		}
	}

	/* Fotos: la fila se desplaza de a una; la siguiente asoma hasta el borde de la pantalla. */
	.fotos {
		min-width: 0;
	}
	.pista {
		display: flex;
		gap: var(--separacion);
		margin: 0;
		padding: 0;
		list-style: none;
		transform: translateX(calc(var(--i) * (-100% - var(--separacion))));
		transition: transform 0.6s;
		touch-action: pan-y;
		/* La fila corrida pasa por encima de la columna de texto: solo las fotos reciben clics. */
		pointer-events: none;
	}
	.foto {
		flex: 0 0 100%;
		opacity: 1;
		pointer-events: auto;
		transition: opacity 0.8s;
	}
	/* Las que vienen, difuminadas (pedido del usuario): la activa queda nítida al llegar. */
	.foto .marco :global(img) {
		transition:
			filter 0.6s,
			transform 0.6s;
	}
	.foto.futura .marco :global(img) {
		filter: saturate(0.88) contrast(1.04) blur(6px);
		transform: scale(1.04); /* que el difuminado no deje borde claro */
	}
	/* Las pasadas quedan invisibles encima de la columna de texto: que no le roben el clic. */
	.foto.pasada {
		pointer-events: none;
		opacity: 0;
		transition-duration: 0.4s;
	}
	.foto .marco {
		display: grid;
		aspect-ratio: 16 / 9;
	}

	.controles {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 22px;
	}
	.flecha {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		padding: 0;
		border: 1px solid #273943;
		border-radius: 0;
		background: transparent;
		color: #273943;
		cursor: pointer;
	}
	.flecha svg {
		width: 32px;
		height: 32px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.flecha:hover {
		border-color: var(--lols-verde-oscuro);
		color: var(--lols-verde-oscuro);
	}

	@media (max-width: 860px) {
		.franja {
			display: none;
		}
		.cuerpo {
			grid-template-columns: minmax(0, 1fr);
		}
		.fotos {
			order: -1;
			margin-bottom: 1.5rem;
		}
		.pista {
			--separacion: 16px;
		}
		.foto {
			flex-basis: 88%;
		}
		.pista {
			transform: translateX(calc(var(--i) * (-88% - var(--separacion))));
		}
		.textos {
			padding-right: 0;
		}
		.texto {
			width: 100%;
		}
		.controles {
			margin-top: 1rem;
		}
		.flecha {
			width: 52px;
			height: 52px;
		}
	}
</style>
