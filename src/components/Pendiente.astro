---
// Contenido faltante o sin confirmar (docs/brief.md: "no inventes contenido").
//
//   <Pendiente texto="mandante">Inmobiliaria Ejemplo</Pendiente>
//       Falta el dato. Se muestra el contenido de ejemplo con el estilo final (modo propuesta).
//   <Pendiente bloque texto="alcance"><ul>…</ul></Pendiente>
//       Igual, para un bloque entero.
//   <Pendiente texto="mapa" bloque />
//       Sin ejemplo: se muestra el marcador amarillo.
//   <Pendiente revisar="confirmar vigencia">dato real</Pendiente>
//       Dato en uso pero sin confirmar.
//
// Los marcadores ([PENDIENTE…], [REVISAR…]) quedan ocultos y aparecen con el botón
// "Ver marcadores" del aviso de propuesta (AvisoPropuesta.astro, clase html.ver-marcadores).
// El build de producción (site = lols.cl) falla si queda alguno.
interface Props {
	texto?: string;
	revisar?: string;
	bloque?: boolean;
}
const { texto, revisar, bloque = false } = Astro.props;

if (Astro.site?.hostname === 'lols.cl') {
	throw new Error(`Marcador sin resolver en ${Astro.url.pathname}: ${texto ?? revisar}`);
}
const tieneEjemplo = Astro.slots.has('default');
const marca = `[PENDIENTE: ${texto}]`;
---

{
	revisar ? (
		<span class="revisar">
			<slot />
			<small class="marcador">[REVISAR: {revisar}]</small>
		</span>
	) : tieneEjemplo ? (
		bloque ? (
			<div class="ejemplo" data-pendiente={marca}>
				<slot />
			</div>
		) : (
			<span class="ejemplo" data-pendiente={marca}>
				<slot />
			</span>
		)
	) : bloque ? (
		<div class="bloque">
			<span class="pendiente">{marca}</span>
		</div>
	) : (
		<span class="pendiente solo-marcador">{marca}</span>
	)
}

<style>
	.pendiente {
		font-family: var(--fuente-texto);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: normal;
		line-height: 1.4;
		text-transform: none;
		color: #7a4a00;
		background: #fff4d6;
		border: 1px dashed #c98a00;
		border-radius: 4px;
		padding: 0.1em 0.45em;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}
	/* Dentro de un .marco (display grid) se estira a todo el marco. */
	.bloque {
		display: grid;
		place-items: center;
		min-height: 6rem;
		padding: 0.75rem;
		text-align: center;
		border: 1px dashed rgb(128 128 128 / 0.45);
	}
	.bloque .pendiente {
		max-width: 36rem;
	}
	.marcador {
		margin-left: 0.4em;
		font-family: var(--fuente-texto);
		font-size: 0.75em;
		font-weight: 600;
		letter-spacing: normal;
		color: #7a4a00;
		background: #fff4d6;
		border-radius: 3px;
		padding: 0 0.3em;
		overflow-wrap: anywhere;
	}
</style>
