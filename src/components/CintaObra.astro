---
// Cinta de especialidades bajo la portada: la losa verde del logo hecha banda, con las
// especialidades en letra de letrero de obra y el isotipo como separador (idea de la cinta
// gigante de Mott MacDonald con su forma de marca entre palabras).
// Se desplaza con el scroll (animation-timeline), no sola: no hay movimiento que pausar
// (WCAG 2.2.2) ni costo cuando no se mira. Sin soporte o con "reducir movimiento", queda fija.
import { servicios, fundacion } from '../data/empresa';

const items = [...servicios.map((s) => s.nombre), `Desde ${fundacion}`];
const vueltas = [...items, ...items, ...items];
---

<section class="cinta" aria-label="Especialidades de LOLS">
	<!-- El isotipo se dibuja una vez y cada separador lo reutiliza (mismas medidas que el
	     pictograma "construccion" de Pictograma.astro). -->
	<svg class="defs" aria-hidden="true" focusable="false">
		<symbol id="isotipo-cinta" viewBox="0 0 24 24">
			<g fill="currentColor">
				<rect x="3" y="1.75" width="18" height="1.5" />
				<rect x="3" y="20.75" width="18" height="1.5" />
				<rect x="3" y="4.75" width="7.5" height="14.5" />
				<rect x="12.25" y="15.25" width="8.75" height="4" />
			</g>
			<g fill="none" stroke="currentColor" stroke-width="1.5">
				<rect x="13.25" y="5.75" width="7" height="2.25" />
				<rect x="13.25" y="11" width="7" height="2.25" />
			</g>
		</symbol>
	</svg>
	<ul class="pista">
		{
			vueltas.map((t, i) => (
				<li aria-hidden={i >= items.length ? 'true' : undefined}>
					<svg class="sep" aria-hidden="true" focusable="false"><use href="#isotipo-cinta" /></svg>
					{t}
				</li>
			))
		}
	</ul>
</section>

<style>
	.cinta {
		overflow: hidden;
		background: var(--lols-verde);
		color: var(--lols-blanco);
		border-bottom: 6px solid var(--lols-verde-oscuro);
	}
	.pista {
		display: flex;
		width: max-content;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2vw, 1.75rem);
		padding: clamp(1rem, 2.2vw, 1.6rem) clamp(1rem, 2vw, 1.75rem);
		font-family: var(--fuente-datos);
		font-size: clamp(1.6rem, 1rem + 2.6vw, 3.1rem);
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.defs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}
	.sep {
		width: 0.8em;
		height: 0.8em;
		flex-shrink: 0;
		color: var(--lols-verde-oscuro);
	}
	@supports (animation-timeline: view()) {
		.pista {
			animation: correr linear both;
			animation-timeline: view();
			animation-range: cover 0% cover 100%;
		}
	}
	@keyframes correr {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-33.333%);
		}
	}
</style>
