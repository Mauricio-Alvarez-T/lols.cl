---
// Equipamiento propio: un mosaico con una foto por categoría y, encima, la cifra en grande
// (mostrar, no contar: el número es la imagen). Al pinchar, el detalle de la categoría se
// despliega bajo su fila, como los servicios (src/scripts/mosaico.ts). Categorías e ítems del
// inventario de la Bóveda y de la reunión con don Luis (src/data/empresa.ts); las fotos son de
// muestra hasta tener las reales.
import Pendiente from './Pendiente.astro';
import Referencial from './Referencial.astro';
import Pictograma from './Pictograma.astro';
import CifraEquipo from './CifraEquipo.astro';
import { equipamiento } from '../data/empresa';
import { fotosEquipamiento } from '../data/referencia';

const idPanel = 'ficha-equipamiento';
const notaAprox = 'cifra aproximada del inventario de la Bóveda (mar-2026); confirmar que es equipo propio y que sigue vigente';
---

<div class="equipamiento">
	<div class="cabecera">
		<h2>Equipamiento propio</h2>
	</div>
	<Pendiente texto="fotos reales del equipamiento; cantidades de vehículos y de EPP" />

	<ul class="mosaico" data-mosaico>
		{
			equipamiento.map((c) => (
				<li class="item">
					<a href={`#equipo-${c.clave}`} data-abre={`equipo-${c.clave}`}>
						<div class="foto marco marco-mosaico">
							<Referencial imagen={fotosEquipamiento[c.clave]} sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw" />
							<p class="cifra">
								<span class="valor">
									<CifraEquipo c={c} nota={notaAprox} />
								</span>
								<span class="unidad">{c.cifra.unidad}</span>
							</p>
						</div>
						<h3 class="nombre">
							<Pictograma nombre={c.pictograma} />
							{c.titulo}
						</h3>
					</a>
				</li>
			))
		}
		<li class="ficha-panel en-mosaico" id={idPanel} role="region" aria-label="Detalle del equipamiento" hidden>
			<div class="ficha-dentro">
				<div class="interior">
					<div class="ficha-barra">
						<p class="ficha-rotulo">Equipamiento propio</p>
						<div class="ficha-acciones">
							<button type="button" class="ficha-boton" data-cerrar>
								Cerrar
								<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
							</button>
						</div>
					</div>
					{
						equipamiento.map((c) => (
							<div data-ficha={`equipo-${c.clave}`} hidden>
								<div class="detalle">
									<div class="resumen">
										<p class="titulo-categoria">
											<Pictograma nombre={c.pictograma} />
											{c.titulo}
										</p>
										<h4 class="titulo-ficha" tabindex="-1">
											<span class="grande">
												<CifraEquipo c={c} nota={notaAprox} />
											</span>
											<span class="unidad-grande">{c.cifra.unidad}</span>
										</h4>
										{c.cifra.estado === 'aprox' && <p class="nota">Cifra aproximada.</p>}
									</div>
									<ul class="lista">
										{c.items.map((i) => (
											<li>{i}</li>
										))}
									</ul>
								</div>
								<div class="ficha-pie">
									<a href="/contacto/" class="boton">Cotizar un proyecto</a>
									<button type="button" class="ficha-boton" data-cerrar>
										Cerrar
										<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" /></svg>
									</button>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</li>
	</ul>
</div>

<script>
	import '../scripts/mosaico';
</script>

<style>
	.mosaico {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
	}
	.item > a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 0.9rem;
	}
	.foto :global(img) {
		transition: transform 0.4s var(--suave);
	}
	.item > a:hover .foto :global(img) {
		transform: scale(1.03);
	}
	/* La cifra sobre la foto, abajo a la izquierda, con un degradado para que se lea. */
	.cifra {
		grid-area: 1 / 1;
		align-self: end;
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 3.5rem 1.1rem 1rem;
		background: linear-gradient(to top, rgb(16 20 17 / 0.82), rgb(16 20 17 / 0));
		color: var(--lols-blanco);
		pointer-events: none;
	}
	.valor {
		font-family: var(--fuente-titulos);
		font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.unidad {
		margin-top: 0.3rem;
		font-family: var(--fuente-datos);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.nombre {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-size: clamp(1.2rem, 1rem + 0.6vw, 1.5rem);
		letter-spacing: -0.02em;
	}
	.nombre :global(.pictograma),
	.titulo-categoria :global(.pictograma) {
		flex-shrink: 0;
		width: 1.6rem;
		height: 1.6rem;
		color: var(--lols-verde);
	}
	.item > a:hover .nombre,
	.abierta .nombre {
		color: var(--lols-verde-oscuro);
	}

	/* Detalle: la cifra en grande a la izquierda y qué incluye a la derecha. */
	.detalle {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
	}
	.titulo-categoria {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1rem;
		font-family: var(--fuente-titulos);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--lols-verde-oscuro);
	}
	.titulo-ficha {
		display: flex;
		flex-direction: column;
		margin: 0;
	}
	.titulo-ficha:focus {
		outline: none;
	}
	.grande {
		font-family: var(--fuente-titulos);
		font-size: clamp(3.5rem, 2rem + 5vw, 6rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 0.95;
		font-variant-numeric: tabular-nums;
	}
	.unidad-grande {
		margin-top: 0.5rem;
		font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.nota {
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
		color: var(--gris-medio);
	}
	.lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1.5rem;
		border-top: 2px solid var(--lols-carbon);
	}
	.lista li {
		position: relative;
		padding: 0.8rem 0 0.8rem 1.4rem;
		border-bottom: 1px solid var(--linea);
		font-size: 1.05rem;
	}
	.lista li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.3rem;
		width: 0.55rem;
		height: 0.55rem;
		background: var(--lols-verde);
	}

	@media (max-width: 960px) {
		.mosaico {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.detalle {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.lista {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 480px) {
		.mosaico {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
