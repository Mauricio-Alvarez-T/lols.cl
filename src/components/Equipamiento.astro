---
// Equipamiento propio (reunión con don Luis, docs/reunion-inicial.md): una foto por categoría
// con su nombre y, debajo, qué incluye en una línea. Las categorías e ítems son los que se
// nombraron en la reunión; las cantidades y las fotos son de muestra hasta tener las reales.
import Pendiente from './Pendiente.astro';
import Referencial from './Referencial.astro';
import { equipamiento } from '../data/empresa';
import { fotosEquipamiento } from '../data/referencia';
import { ejemplosEquipamiento } from '../data/ejemplos';
---

<div class="equipamiento">
	<div class="cabecera">
		<h2>Equipamiento propio</h2>
	</div>
	<Pendiente texto="cantidades y fotos reales del equipamiento (la lista sigue: la reunión dice «etc.»)" />
	<ul class="categorias">
		{
			equipamiento.map((c) => (
				<li>
					<div class="foto marco">
						<Referencial imagen={fotosEquipamiento[c.clave]} sizes="(max-width: 760px) 100vw, 33vw" />
					</div>
					<h3>{c.titulo}</h3>
					<p class="items">{c.items.join(' · ')}</p>
					<p class="cantidad">
						<Pendiente texto="cantidad">{ejemplosEquipamiento[c.clave]}</Pendiente>
					</p>
				</li>
			))
		}
	</ul>
</div>

<style>
	.categorias {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	h3 {
		font-size: clamp(1.3rem, 2.2vw, 1.6rem);
		letter-spacing: -0.03em;
		margin-bottom: 0.3rem;
	}
	.items {
		margin: 0 0 0.2rem;
		color: var(--lols-gris);
	}
	.cantidad {
		margin: 0;
		font-family: var(--fuente-datos);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--lols-verde-oscuro);
	}
	@media (max-width: 760px) {
		.categorias {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
