---
// Equipamiento propio: un mosaico con una foto por categoría. Al pinchar, el detalle de la
// categoría se despliega bajo su fila, como los servicios (src/scripts/mosaico.ts). Categorías e
// ítems del inventario de la Bóveda y de la reunión con don Luis (src/data/empresa.ts); las
// fotos son de muestra hasta tener las reales. Sin cantidades (don Luis, 08-10-2026).
import Pendiente from './Pendiente.astro';
import Referencial from './Referencial.astro';
import Pictograma from './Pictograma.astro';
import { equipamiento } from '../data/empresa';
import { fotosEquipamiento, fotosAndamios } from '../data/referencia';

const idPanel = 'ficha-equipamiento';
---

<div class="equipamiento">
	<div class="cabecera">
		<h2>Equipamiento propio</h2>
	</div>
	<Pendiente texto="fotos reales del equipamiento" />

	<ul class="mosaico" data-mosaico>
		{
			equipamiento.map((c) => (
				<li class="item">
					<a href={`#equipo-${c.clave}`} data-abre={`equipo-${c.clave}`}>
						<div class="foto marco marco-mosaico">
							<Referencial imagen={fotosEquipamiento[c.clave]} sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw" />
						</div>
						<h3 class="nombre">
							<Pictograma nombre={c.pictograma} />
							{c.titulo}
						</h3>
					</a>
				</li>
			))
		}
		<li class="ficha-panel en-mosaico" id={idPanel} role="region" aria-label="Detalle del equipamiento" hidden>
			<div class="ficha-dentro">
				<div class="interior">
					<div class="ficha-barra">
						<p class="ficha-rotulo">Qué incluye</p>
						<div class="ficha-acciones">
							<button type="button" class="ficha-boton" data-cerrar>
								Cerrar
								<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
							</button>
						</div>
					</div>
					{
						equipamiento.map((c) => (
							<div data-ficha={`equipo-${c.clave}`} hidden>
								<div class="detalle">
									<div class="resumen">
										<h4 class="titulo-ficha" tabindex="-1">
											<Pictograma nombre={c.pictograma} />
											{c.titulo}
										</h4>
									</div>
									<ul class="lista">
										{c.items.map((i) => (
											<li>{typeof i === 'string' ? i : <Pendiente revisar={i.revisar}>{i.texto}</Pendiente>}</li>
										))}
									</ul>
								</div>
								{c.tipos && (
									<ul class="tipos">
										{c.tipos.map((t) => (
											<li>
												<div class="marco foto-tipo">
													<Referencial imagen={fotosAndamios[t.clave]} sizes="(max-width: 640px) 100vw, 33vw" />
												</div>
												<p class="tipo-nombre">{t.nombre}</p>
												<p class="tipo-texto">{t.texto}</p>
											</li>
										))}
									</ul>
								)}
								<div class="ficha-pie">
									<a href="/contacto/" class="boton">Cotizar un proyecto</a>
									<button type="button" class="ficha-boton" data-cerrar>
										Cerrar
										<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" /></svg>
									</button>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</li>
	</ul>
</div>

<script>
	import '../scripts/mosaico';
</script>

<style>
	.mosaico {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
	}
	.item > a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 0.9rem;
	}
	.foto :global(img) {
		transition: transform 0.4s var(--suave);
	}
	.item > a:hover .foto :global(img) {
		transform: scale(1.03);
	}
	.nombre {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-size: clamp(1.2rem, 1rem + 0.6vw, 1.5rem);
		letter-spacing: -0.02em;
	}
	.nombre :global(.pictograma),
	.titulo-categoria :global(.pictograma) {
		flex-shrink: 0;
		width: 1.6rem;
		height: 1.6rem;
		color: var(--lols-verde);
	}
	.item > a:hover .nombre,
	.abierta .nombre {
		color: var(--lols-verde-oscuro);
	}

	/* Detalle: la categoría en grande a la izquierda y qué incluye a la derecha. */
	.detalle {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
	}
	.titulo-ficha {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		font-family: var(--fuente-titulos);
		font-size: clamp(2rem, 1.4rem + 2.5vw, 3.25rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
	.titulo-ficha :global(.pictograma) {
		flex-shrink: 0;
		width: 0.9em;
		height: 0.9em;
		color: var(--lols-verde);
	}
	.titulo-ficha:focus {
		outline: none;
	}
	.lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1.5rem;
		border-top: 2px solid var(--lols-carbon);
	}
	.lista li {
		position: relative;
		padding: 0.8rem 0 0.8rem 1.4rem;
		border-bottom: 1px solid var(--linea);
		font-size: 1.05rem;
	}
	.lista li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.3rem;
		width: 0.55rem;
		height: 0.55rem;
		background: var(--lols-verde);
	}

	/* Tipos (andamios): foto de ejemplo, nombre y para qué sirve. */
	.tipos {
		list-style: none;
		margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
	}
	.foto-tipo {
		aspect-ratio: 4 / 3;
		margin-bottom: 0.75rem;
	}
	.tipo-nombre {
		margin: 0 0 0.25rem;
		font-family: var(--fuente-titulos);
		font-size: 1.2rem;
		font-weight: 700;
	}
	.tipo-texto {
		margin: 0;
		color: var(--lols-gris);
	}

	@media (max-width: 960px) {
		.mosaico {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.detalle {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.lista,
		.tipos {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 480px) {
		.mosaico {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
