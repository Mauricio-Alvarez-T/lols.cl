---
import Logo from './Logo.astro';
import { navegacion, fundacion } from '../data/empresa';

const ruta = Astro.url.pathname;
---

<!--
	PRUEBA TEMPORAL (Marcos, 19-10-2026): cuatro formas de abrir el menú en celular para elegir una,
	copiadas de sitios grandes. Se elige con ?menu= y queda guardada mientras se navega:
	  completo  = pantalla completa con letras grandes (Apple, Siemens, Skanska)
	  lateral   = panel que entra desde la derecha, con la página oscurecida detrás (Amazon, Nike)
	  abajo     = hoja que sube desde abajo, cerca del dedo, como en una app (Airbnb, Google Maps)
	  pestanas  = sin botón: secciones siempre a la vista en una fila deslizable (The Guardian)
	Sin ?menu= (o con ?menu=actual) queda el menú de siempre. Al elegir, dejar solo esa y borrar
	esto. Va antes del encabezado para que la de pestañas no salte al cargar.
-->
<script is:inline>
	(function () {
		var m = new URLSearchParams(location.search).get('menu');
		try {
			if (m) sessionStorage.setItem('lols-menu', m);
			else m = sessionStorage.getItem('lols-menu');
		} catch (e) {}
		if (['completo', 'lateral', 'abajo', 'pestanas'].indexOf(m) >= 0) document.documentElement.dataset.menu = m;
	})();
</script>

<header class="encabezado">
	<div class="contenedor fila">
		<a href="/" class="marca" aria-label={`LOLS Ingeniería, desde ${fundacion}, inicio`}>
			<Logo class="logo" />
			<span class="desde" aria-hidden="true">desde<br />{fundacion}</span>
		</a>
		<button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu">
			<span class="sr-only">Menú</span>
			<span class="barras" aria-hidden="true"></span>
		</button>
		<nav id="menu" aria-label="Principal">
			<ul>
				{
					navegacion.map((item) => (
						<li>
							<a href={item.href} aria-current={ruta.startsWith(item.href) ? 'page' : undefined}>
								{item.texto}
							</a>
						</li>
					))
				}
			</ul>
			<a href="/contacto/" class="boton">Cotizar</a>
		</nav>
	</div>
</header>

<script>
	const boton = document.querySelector<HTMLButtonElement>('.menu-boton')!;
	const encabezado = document.querySelector<HTMLElement>('.encabezado')!;
	const abrir = (si: boolean) => boton.setAttribute('aria-expanded', String(si));
	boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
	// Cerrar tocando la parte oscurecida (es el ::after del encabezado) o con Escape.
	encabezado.addEventListener('click', (e) => {
		if (e.target === encabezado) abrir(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
			abrir(false);
			boton.focus();
		}
	});
	// Pestañas: la sección actual queda a la vista en la fila deslizable.
	if (document.documentElement.dataset.menu === 'pestanas') {
		const fila = encabezado.querySelector<HTMLElement>('nav ul');
		const actual = fila?.querySelector<HTMLElement>('[aria-current="page"]');
		if (fila && actual) fila.scrollLeft = actual.offsetLeft - fila.offsetLeft - 16;
	}
</script>

<style>
	.encabezado {
		position: sticky;
		top: 0;
		z-index: 10;
		view-transition-name: encabezado;
		background: var(--fondo);
		/* La losa de arriba del logo, a todo el ancho. */
		border-top: 4px solid var(--lols-verde);
		border-bottom: 1px solid var(--linea);
	}
	.fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 4.5rem;
	}
	.marca {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--lols-verde);
		text-decoration: none;
		flex-shrink: 0;
	}
	/* Trayectoria junto a la marca (como el "80 years" de Arup bajo su logo). */
	.desde {
		padding-left: 0.85rem;
		border-left: 1px solid var(--linea);
		color: var(--lols-carbon);
		font-family: var(--fuente-datos);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.15;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.marca :global(.logo) {
		width: 8.5rem;
		height: auto;
	}
	nav,
	nav ul {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav ul a {
		position: relative;
		display: block;
		padding-block: 0.5rem;
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	nav ul a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		background: var(--lols-verde);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s;
	}
	nav ul a:hover::after,
	nav ul a[aria-current='page']::after {
		transform: scaleX(1);
	}
	.menu-boton {
		display: none;
	}

	/* Flotante (con JS): sobre la imagen de la cabecera, sin fondo, logo y menú en blanco, con un
	   degradado arriba para que se lea sobre cualquier foto. Al bajar (.con-sombra) o con el menú
	   del celular abierto vuelve a ser sólido. El contenido sube por debajo (margen negativo). */
	:global(.encabezado-flotante) .encabezado {
		transition:
			background-color 0.3s,
			border-color 0.3s,
			box-shadow 0.25s;
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) {
		/* no-repeat + border-box: si no, el degradado se repite en el borde de 1 px de abajo y
		   deja una línea oscura. */
		background: linear-gradient(to bottom, rgb(20 20 20 / 0.55), rgb(20 20 20 / 0)) border-box no-repeat;
		border-bottom-color: transparent;
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .marca {
		color: var(--lols-blanco);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .desde {
		color: var(--lols-blanco);
		border-left-color: rgb(255 255 255 / 0.35);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) nav ul a {
		color: var(--lols-blanco);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras,
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras::before,
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras::after {
		background: var(--lols-blanco);
	}
	.marca,
	.desde,
	nav ul a {
		transition: color 0.3s;
	}
	:global(.encabezado-flotante main) {
		margin-top: calc(-4.5rem - 5px);
	}
	:global(.encabezado-flotante section.hero-obra .fondo-hero .pausa) {
		margin-top: 5.5rem;
	}

	@media (max-width: 360px) {
		.desde {
			display: none;
		}
	}
	/* Menú de celular (botón con 3 rayas) hasta 1200 px: con Trabaja con nosotros arriba (19-10-2026)
	   el menú completo mide unos 860 px y, junto al logo, no cabe en una línea en tablets ni en
	   notebooks chicos; antes de eso se cortaba en dos líneas o la página se movía de lado. */
	@media (max-width: 1200px) {
		.menu-boton {
			display: grid;
			place-items: center;
			width: 3rem;
			height: 3rem;
			margin-right: -0.5rem;
			border: 0;
			background: none;
			cursor: pointer;
		}
		.barras,
		.barras::before,
		.barras::after {
			display: block;
			width: 1.5rem;
			height: 2px;
			background: var(--lols-carbon);
			transition: transform 0.2s, opacity 0.2s;
		}
		.barras {
			position: relative;
		}
		.barras::before,
		.barras::after {
			content: '';
			position: absolute;
			left: 0;
		}
		.barras::before {
			top: -7px;
		}
		.barras::after {
			top: 7px;
		}
		[aria-expanded='true'] .barras {
			background: transparent;
		}
		[aria-expanded='true'] .barras::before {
			transform: translateY(7px) rotate(45deg);
		}
		[aria-expanded='true'] .barras::after {
			transform: translateY(-7px) rotate(-45deg);
		}

		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
			padding: 1rem var(--gutter) 1.5rem;
			background: var(--fondo);
			border-bottom: 1px solid var(--linea);
			box-shadow: 0 12px 24px rgb(0 0 0 / 0.08);
		}
		.menu-boton[aria-expanded='true'] + nav {
			display: flex;
		}
		nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		nav ul a {
			padding-block: 0.85rem;
			border-bottom: 1px solid var(--lols-gris-claro);
		}
		nav ul a::after {
			display: none;
		}
		nav ul a[aria-current='page'] {
			color: var(--lols-verde-oscuro);
		}

		/* ---------- PRUEBA TEMPORAL de menús (ver el comentario de arriba del encabezado) ----------
		   Completo, lateral y abajo: el menú siempre está armado y se muestra/oculta con
		   transform y opacity (fluido en celular); con el menú abierto la página no se mueve. */
		:global(html[data-menu='completo']:has(.menu-boton[aria-expanded='true'])),
		:global(html[data-menu='lateral']:has(.menu-boton[aria-expanded='true'])),
		:global(html[data-menu='abajo']:has(.menu-boton[aria-expanded='true'])) {
			overflow: hidden;
		}
		:global(html[data-menu='completo']) .encabezado:has([aria-expanded='true']),
		:global(html[data-menu='lateral']) .encabezado:has([aria-expanded='true']),
		:global(html[data-menu='abajo']) .encabezado:has([aria-expanded='true']) {
			z-index: 40; /* sobre la barra Llamar/WhatsApp/Cotizar */
		}
		:global(html[data-menu='completo']) nav,
		:global(html[data-menu='lateral']) nav,
		:global(html[data-menu='abajo']) nav {
			display: flex;
			position: fixed;
			visibility: hidden;
			overflow-y: auto;
			overscroll-behavior: contain;
			background: var(--fondo);
			border-bottom: 0;
		}
		:global(html[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav,
		:global(html[data-menu='lateral']) .menu-boton[aria-expanded='true'] + nav,
		:global(html[data-menu='abajo']) .menu-boton[aria-expanded='true'] + nav {
			visibility: visible;
			opacity: 1;
			transform: none;
		}
		:global(html.anim[data-menu='completo']) nav,
		:global(html.anim[data-menu='lateral']) nav,
		:global(html.anim[data-menu='abajo']) nav {
			transition:
				transform 0.35s var(--suave),
				opacity 0.25s,
				visibility 0s 0.35s;
		}
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav,
		:global(html.anim[data-menu='lateral']) .menu-boton[aria-expanded='true'] + nav,
		:global(html.anim[data-menu='abajo']) .menu-boton[aria-expanded='true'] + nav {
			transition:
				transform 0.35s var(--suave),
				opacity 0.25s;
		}
		/* Lateral y abajo: la página queda oscurecida detrás; tocarla cierra el menú. */
		:global(html[data-menu='lateral']) .encabezado::after,
		:global(html[data-menu='abajo']) .encabezado::after {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 1;
			background: rgb(20 20 20 / 0.5);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity 0.3s,
				visibility 0s 0.3s;
		}
		:global(html[data-menu='lateral']) .encabezado:has([aria-expanded='true'])::after,
		:global(html[data-menu='abajo']) .encabezado:has([aria-expanded='true'])::after {
			opacity: 1;
			visibility: visible;
			transition: opacity 0.3s;
		}
		:global(html[data-menu='lateral']) nav,
		:global(html[data-menu='abajo']) nav {
			z-index: 2;
		}
		:global(html[data-menu='lateral']) .menu-boton,
		:global(html[data-menu='abajo']) .menu-boton {
			position: relative;
			z-index: 3;
		}

		/* 1. Pantalla completa (Apple, Siemens, Skanska): letras grandes que entran una tras otra;
		   el logo y la X quedan arriba (el menú va por debajo de ellos, z-index -1). */
		:global(html[data-menu='completo']) nav {
			inset: 0;
			z-index: -1;
			gap: 2rem;
			padding: calc(4.5rem + 5px + 1.25rem) var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
			border-top: 4px solid var(--lols-verde);
			box-shadow: none;
			opacity: 0;
		}
		:global(html[data-menu='completo']) nav ul a {
			padding-block: 0.45rem;
			border-bottom: 0;
			font-size: clamp(1.75rem, 8vw, 2.4rem);
			font-weight: 700;
			letter-spacing: -0.02em;
		}
		:global(html[data-menu='completo']) nav .boton {
			margin-top: auto;
		}
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li {
			animation: menu-linea 0.4s var(--suave) both;
		}
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li:nth-child(2) { animation-delay: 0.04s; }
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li:nth-child(3) { animation-delay: 0.08s; }
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li:nth-child(4) { animation-delay: 0.12s; }
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li:nth-child(5) { animation-delay: 0.16s; }
		:global(html.anim[data-menu='completo']) .menu-boton[aria-expanded='true'] + nav li:nth-child(6) { animation-delay: 0.2s; }

		/* 2. Panel lateral (Amazon, Nike): entra desde la derecha y deja ver la página a la izquierda. */
		:global(html[data-menu='lateral']) nav {
			top: 0;
			right: 0;
			bottom: 0;
			left: auto;
			width: min(86vw, 24rem);
			padding: calc(4.5rem + 5px + 0.5rem) 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
			border-top: 4px solid var(--lols-verde);
			box-shadow: -12px 0 32px rgb(0 0 0 / 0.18);
			transform: translateX(100%);
		}
		:global(html[data-menu='lateral']) nav .boton {
			margin-top: auto;
		}

		/* 3. Desde abajo (Airbnb, Google Maps): una hoja con esquinas redondeadas, al alcance del
		   pulgar; arriba se sigue viendo la página. La X queda en un círculo claro para leerse. */
		:global(html[data-menu='abajo']) nav {
			top: auto;
			left: 0;
			right: 0;
			bottom: 0;
			max-height: 85svh;
			padding: 2rem var(--gutter) calc(1.25rem + env(safe-area-inset-bottom));
			border-radius: 1.25rem 1.25rem 0 0;
			box-shadow: 0 -12px 32px rgb(0 0 0 / 0.18);
			transform: translateY(100%);
		}
		:global(html[data-menu='abajo']) nav::before {
			content: '';
			position: absolute;
			top: 0.65rem;
			left: calc(50% - 1.25rem);
			width: 2.5rem;
			height: 4px;
			border-radius: 2px;
			background: var(--linea);
		}
		:global(html[data-menu='abajo']) .menu-boton[aria-expanded='true'] {
			background: var(--fondo);
			border-radius: 50%;
		}

		/* 4. Pestañas (The Guardian): sin botón; una segunda fila con todas las secciones que se
		   desliza de lado (el borde derecho se desvanece para que se note que hay más). La fila
		   mide 2.75rem: lo que se acomoda bajo el encabezado suma esa altura. */
		:global(html[data-menu='pestanas']) .menu-boton {
			display: none;
		}
		:global(html[data-menu='pestanas']) .fila {
			flex-wrap: wrap;
			row-gap: 0;
		}
		:global(html[data-menu='pestanas']) nav {
			display: flex;
			position: static;
			flex-direction: row;
			align-items: center;
			/* De borde a borde de la pantalla; min-width 0 para que la fila se deslice en vez de
			   ensanchar el encabezado. */
			flex-basis: calc(100% + 2 * var(--gutter));
			min-width: 0;
			gap: 1rem;
			margin-inline: calc(-1 * var(--gutter));
			padding: 0 var(--gutter) 0 0;
			background: none;
			border: 0;
			box-shadow: none;
		}
		:global(html[data-menu='pestanas']) nav ul {
			flex: 1;
			flex-direction: row;
			gap: 1.4rem;
			min-width: 0;
			padding-inline: var(--gutter);
			overflow-x: auto;
			scrollbar-width: none;
			-webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
			mask-image: linear-gradient(to right, #000 85%, transparent);
		}
		:global(html[data-menu='pestanas']) nav ul::-webkit-scrollbar {
			display: none;
		}
		:global(html[data-menu='pestanas']) nav ul a {
			padding-block: 0.65rem;
			line-height: 1.45rem;
			border-bottom: 0;
			font-size: 0.95rem;
		}
		:global(html[data-menu='pestanas']) nav ul a::after {
			display: block;
		}
		:global(html[data-menu='pestanas']) nav .boton {
			flex-shrink: 0;
			min-height: 2.75rem;
			padding: 0.4rem 1rem;
			font-size: 0.9rem;
		}
		:global(html[data-menu='pestanas'].encabezado-flotante main) {
			margin-top: calc(-7.25rem - 5px);
		}
		:global(html[data-menu='pestanas'] .ficha-barra) {
			top: calc(7.25rem + 5px);
		}
		:global(html[data-menu='pestanas'].encabezado-flotante section.hero-obra .fondo-hero .pausa) {
			margin-top: 8.25rem;
		}
	}
	/* Pestañas en celular: Cotizar ya está en la barra de abajo. */
	@media (max-width: 767px) {
		:global(html[data-menu='pestanas']) nav {
			padding-right: 0;
		}
		:global(html[data-menu='pestanas']) nav .boton {
			display: none;
		}
	}
	@keyframes menu-linea {
		from {
			opacity: 0;
			transform: translateY(0.6rem);
		}
	}
</style>
