---
import Logo from './Logo.astro';
import { navegacion, fundacion } from '../data/empresa';

const ruta = Astro.url.pathname;
---

<header class="encabezado">
	<div class="contenedor fila">
		<a href="/" class="marca" aria-label={`LOLS Ingeniería, desde ${fundacion}, inicio`}>
			<Logo class="logo" />
			<span class="desde" aria-hidden="true">desde<br />{fundacion}</span>
		</a>
		<button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu">
			<span class="sr-only">Menú</span>
			<span class="barras" aria-hidden="true"></span>
		</button>
		<nav id="menu" aria-label="Principal">
			<ul>
				{
					navegacion.map((item) => (
						<li>
							<a href={item.href} aria-current={ruta.startsWith(item.href) ? 'page' : undefined}>
								{item.texto}
							</a>
						</li>
					))
				}
			</ul>
			<a href="/cotizar/" class="boton" aria-current={ruta.startsWith('/cotizar/') ? 'page' : undefined}>Cotizar</a>
		</nav>
	</div>
</header>

<script>
	const boton = document.querySelector<HTMLButtonElement>('.menu-boton')!;
	const encabezado = document.querySelector<HTMLElement>('.encabezado')!;
	const abrir = (si: boolean) => boton.setAttribute('aria-expanded', String(si));
	boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));
	// Cerrar tocando la parte oscurecida (es el ::after del encabezado) o con Escape.
	encabezado.addEventListener('click', (e) => {
		if (e.target === encabezado) abrir(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
			abrir(false);
			boton.focus();
		}
	});
	// Al volver con "atrás" el navegador puede restaurar la página tal como quedó: con el panel
	// abierto. Se cierra.
	window.addEventListener('pageshow', (e) => {
		if (e.persisted) abrir(false);
	});
</script>

<style>
	.encabezado {
		position: sticky;
		top: 0;
		z-index: 10;
		view-transition-name: encabezado;
		background: var(--fondo);
		/* La losa de arriba del logo, a todo el ancho. */
		border-top: 4px solid var(--lols-verde);
		border-bottom: 1px solid var(--linea);
	}
	.fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 4.5rem;
	}
	.marca {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--lols-verde);
		text-decoration: none;
		flex-shrink: 0;
	}
	/* Trayectoria junto a la marca (como el "80 years" de Arup bajo su logo). */
	.desde {
		padding-left: 0.85rem;
		border-left: 1px solid var(--linea);
		color: var(--lols-carbon);
		font-family: var(--fuente-datos);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.15;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.marca :global(.logo) {
		width: 8.5rem;
		height: auto;
	}
	nav,
	nav ul {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav ul a {
		position: relative;
		display: block;
		padding-block: 0.5rem;
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	nav ul a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		background: var(--lols-verde);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s;
	}
	nav ul a:hover::after,
	nav ul a[aria-current='page']::after {
		transform: scaleX(1);
	}
	.menu-boton {
		display: none;
	}

	/* Flotante (con JS): sobre la imagen de la cabecera, sin fondo, logo y menú en blanco, con un
	   degradado arriba para que se lea sobre cualquier foto. Al bajar (.con-sombra) o con el menú
	   del celular abierto vuelve a ser sólido. El contenido sube por debajo (margen negativo). */
	:global(.encabezado-flotante) .encabezado {
		transition:
			background-color 0.3s,
			border-color 0.3s,
			box-shadow 0.25s;
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) {
		/* no-repeat + border-box: si no, el degradado se repite en el borde de 1 px de abajo y
		   deja una línea oscura. */
		background: linear-gradient(to bottom, rgb(20 20 20 / 0.55), rgb(20 20 20 / 0)) border-box no-repeat;
		border-bottom-color: transparent;
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .marca {
		color: var(--lols-blanco);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .desde {
		color: var(--lols-blanco);
		border-left-color: rgb(255 255 255 / 0.35);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) nav ul a {
		color: var(--lols-blanco);
	}
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras,
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras::before,
	:global(.encabezado-flotante) .encabezado:not(:global(.con-sombra)):not(:has([aria-expanded='true'])) .barras::after {
		background: var(--lols-blanco);
	}
	.marca,
	.desde,
	nav ul a {
		transition: color 0.3s;
	}
	:global(.encabezado-flotante main) {
		margin-top: calc(-4.5rem - 5px);
	}
	:global(.encabezado-flotante section.hero-obra .fondo-hero .pausa) {
		margin-top: 5.5rem;
	}

	@media (max-width: 360px) {
		.desde {
			display: none;
		}
	}
	/* Menú de celular (botón con 3 rayas) hasta 1080 px: el menú completo (5 secciones + Cotizar,
	   desde que se sacó Seguridad el 20-10-2026) mide unos 745 px y, junto al logo, necesita
	   ~1050 px; más angosto se cortaba en dos líneas o la página se movía de lado. */
	@media (max-width: 1080px) {
		.menu-boton {
			display: grid;
			place-items: center;
			width: 3rem;
			height: 3rem;
			margin-right: -0.5rem;
			border: 0;
			background: none;
			cursor: pointer;
		}
		.barras,
		.barras::before,
		.barras::after {
			display: block;
			width: 1.5rem;
			height: 2px;
			background: var(--lols-carbon);
			transition: transform 0.2s, opacity 0.2s;
		}
		.barras {
			position: relative;
		}
		.barras::before,
		.barras::after {
			content: '';
			position: absolute;
			left: 0;
		}
		.barras::before {
			top: -7px;
		}
		.barras::after {
			top: 7px;
		}
		[aria-expanded='true'] .barras {
			background: transparent;
		}
		[aria-expanded='true'] .barras::before {
			transform: translateY(7px) rotate(45deg);
		}
		[aria-expanded='true'] .barras::after {
			transform: translateY(-7px) rotate(-45deg);
		}

		/* Panel lateral (Marcos lo eligió el 19-10-2026 entre cuatro pruebas; como Amazon o Nike):
		   entra desde la derecha y deja ver la página oscurecida a la izquierda, sin taparla
		   entera. Tocar lo oscurecido o Escape lo cierra (script de arriba). Siempre está armado y
		   se muestra con transform (fluido en celular); abierto, la página de atrás no se mueve. */
		:global(html:has(.menu-boton[aria-expanded='true'])) {
			overflow: hidden;
		}
		.encabezado:has([aria-expanded='true']) {
			z-index: 40; /* sobre la barra Llamar/WhatsApp/Cotizar */
		}
		nav {
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			z-index: 2;
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
			width: min(86vw, 24rem);
			padding: calc(4.5rem + 5px + 0.5rem) 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
			overflow-y: auto;
			overscroll-behavior: contain;
			background: var(--fondo);
			border-top: 4px solid var(--lols-verde);
			box-shadow: -12px 0 32px rgb(0 0 0 / 0.18);
			visibility: hidden;
			transform: translateX(100%);
		}
		.menu-boton[aria-expanded='true'] + nav {
			visibility: visible;
			transform: none;
		}
		:global(.anim) nav {
			transition:
				transform 0.35s var(--suave),
				visibility 0s 0.35s;
		}
		:global(.anim) .menu-boton[aria-expanded='true'] + nav {
			transition: transform 0.35s var(--suave);
		}
		/* La página oscurecida detrás del panel; la X queda encima de todo. */
		.encabezado::after {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 1;
			background: rgb(20 20 20 / 0.5);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity 0.3s,
				visibility 0s 0.3s;
		}
		.encabezado:has([aria-expanded='true'])::after {
			opacity: 1;
			visibility: visible;
			transition: opacity 0.3s;
		}
		.menu-boton {
			position: relative;
			z-index: 3;
		}
		nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		nav ul a {
			padding-block: 0.85rem;
			border-bottom: 1px solid var(--lols-gris-claro);
		}
		nav ul a::after {
			display: none;
		}
		nav ul a[aria-current='page'] {
			color: var(--lols-verde-oscuro);
		}
		nav .boton {
			margin-top: auto;
		}
	}
</style>
