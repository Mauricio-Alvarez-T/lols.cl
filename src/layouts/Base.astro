---
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/animaciones.css';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import AvisoPropuesta from '../components/AvisoPropuesta.astro';
import Animaciones from '../components/Animaciones.astro';

interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
// Fuera del dominio definitivo (nuevo.lols.cl, localhost) no se indexa.
const indexable = Astro.site?.hostname === 'lols.cl';
const titulo = title === 'LOLS Ingeniería' ? title : `${title} · LOLS Ingeniería`;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#006739" />
		{description && <meta name="description" content={description} />}
		{!indexable && <meta name="robots" content="noindex, nofollow" />}
		<title>{titulo}</title>
		<script is:inline>
			// Animaciones solo si no se pidió reducir movimiento. Si el script de Animaciones.astro
			// no corre en 3 s, se quita html.anim para que nada quede oculto.
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
				document.documentElement.classList.add("anim");
				setTimeout(function () {
					if (!window.__animaciones) document.documentElement.classList.remove("anim");
				}, 3000);
			}
		</script>
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		<Encabezado />
		<main id="contenido">
			<slot />
		</main>
		<Pie />
		<Animaciones />
		{!indexable && <AvisoPropuesta />}
	</body>
</html>

<style>
	.saltar {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 20;
		padding: 0.5rem 1rem;
		background: var(--lols-verde-oscuro);
		color: var(--lols-blanco);
		border-radius: var(--radio);
	}
	.saltar:focus {
		top: 1rem;
	}
</style>
