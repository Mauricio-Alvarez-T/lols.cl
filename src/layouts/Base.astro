---
interface Props {
	title: string;
}
const { title } = Astro.props;
// Fuera del dominio definitivo (nuevo.lols.cl, localhost) no se indexa.
const indexable = Astro.site?.hostname === 'lols.cl';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{!indexable && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
