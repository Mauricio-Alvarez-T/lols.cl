---
// Seguridad y calidad: responde lo que pregunta un mandante al precalificar a un contratista.
// Don Luis (08-10-2026): sin indicadores ni certificado de la mutual, sin certificaciones ISO
// (LOLS no las tiene) y sin registros de contratistas: solo la mutual. Sí va la Política de
// Seguridad y Salud en el Trabajo, que exige el Decreto Supremo 44 desde febrero de 2025, sin
// documento para descargar (Marcos, 08-10-2026: no hacer ningún documento de la política).
// Casi ningún sitio del rubro lo muestra: es el diferenciador (docs/investigacion-secciones.md).
import Base from '../layouts/Base.astro';
import ObraPortada from '../components/ObraPortada.astro';
import Contacto from '../components/Contacto.astro';
import { empresa } from '../data/empresa';
import { videos } from '../data/referencia';
---

<Base title="Seguridad y calidad" description="Política de Seguridad y Salud en el Trabajo y mutualidad de LOLS Ingeniería.">
	<ObraPortada video={videos.seguridad}>
		<p class="etiqueta">Seguridad y calidad</p>
		<h1 class="display">Cada faena, con las personas primero<span class="punto">.</span></h1>
		<p class="bajada">Lo que su área de contratos necesita para precalificar a LOLS, sin perseguir documentos.</p>
	</ObraPortada>

	<section id="politica" class="seccion contenedor ancla">
		<div class="cabecera"><h2>Política de Seguridad y Salud en el Trabajo</h2></div>
		<p class="politica">La política que guía la seguridad de cada obra de LOLS, según el Decreto Supremo 44.</p>
	</section>

	<section class="seccion gris">
		<div class="contenedor">
			<div class="cabecera"><h2>Mutualidad</h2></div>
			<ul class="registros"><li>{empresa.mutual}</li></ul>
		</div>
	</section>

	<section class="seccion contenedor documentos">
		<div>
			<h2>¿Necesita la documentación para precalificar?</h2>
		</div>
		<a href="/contacto/?asunto=precalificacion#formulario" class="boton">Solicitar documentación</a>
	</section>

	<Contacto />
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}
	.ancla {
		scroll-margin-top: 5rem;
	}
	.politica {
		margin: 0;
		max-width: 40rem;
		font-size: 1.15rem;
		color: var(--lols-gris);
	}
	.registros {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.registros li {
		padding: 0.9rem 1.25rem;
		border: 1px solid var(--linea);
		border-top: 4px solid var(--lols-verde);
		background: var(--lols-blanco);
		font-family: var(--fuente-titulos);
		font-size: 1.15rem;
		font-weight: 700;
	}
	.documentos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-block: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid var(--linea);
	}
	.documentos h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin-bottom: 0.4rem;
	}
</style>
