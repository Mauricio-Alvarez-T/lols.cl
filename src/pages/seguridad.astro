---
// Seguridad y calidad: responde lo que pregunta un mandante al precalificar a un contratista.
// Don Luis (08-10-2026): sin indicadores ni certificado de la mutual, sin certificaciones ISO
// (LOLS no las tiene) y sin registros de contratistas: solo la mutual. Sí va la Política de
// Seguridad y Salud en el Trabajo, que exige el Decreto Supremo 44 desde febrero de 2025: texto de
// ejemplo en la página (ejemplos.ts), sin documento para descargar, hasta tener el real.
// Casi ningún sitio del rubro lo muestra: es el diferenciador (docs/investigacion-secciones.md).
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import ObraPortada from '../components/ObraPortada.astro';
import Contacto from '../components/Contacto.astro';
import { empresa } from '../data/empresa';
import { videos } from '../data/referencia';
import { ejemploPoliticaSST as politica } from '../data/ejemplos';
---

<Base title="Seguridad y calidad" description="Política de Seguridad y Salud en el Trabajo y mutualidad de LOLS Ingeniería.">
	<ObraPortada video={videos.seguridad}>
		<p class="etiqueta">Seguridad y calidad</p>
		<h1 class="display">Cada faena, con las personas primero<span class="punto">.</span></h1>
		<p class="bajada">Lo que su área de contratos necesita para precalificar a LOLS, sin perseguir documentos.</p>
	</ObraPortada>

	<section id="politica" class="seccion contenedor ancla">
		<div class="cabecera"><h2>Política de Seguridad y Salud en el Trabajo</h2></div>
		<Pendiente bloque texto="texto real de la política de LOLS (este es de ejemplo)">
			<div class="politica">
				<div class="intro">
					<p>{politica.intro}</p>
					<p class="firma">{politica.firma}</p>
				</div>
				<div>
					<h3 class="compromisos-titulo">Nuestros compromisos</h3>
					<ol class="compromisos">{politica.compromisos.map((c) => <li>{c}</li>)}</ol>
				</div>
			</div>
		</Pendiente>
	</section>

	<section class="seccion gris">
		<div class="contenedor">
			<div class="cabecera"><h2>Mutualidad</h2></div>
			<ul class="registros"><li>{empresa.mutual}</li></ul>
		</div>
	</section>

	<section class="seccion contenedor documentos">
		<div>
			<h2>¿Necesita la documentación para precalificar?</h2>
		</div>
		<a href="/contacto/?asunto=precalificacion#formulario" class="boton">Solicitar documentación</a>
	</section>

	<Contacto />
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}
	.ancla {
		scroll-margin-top: 5rem;
	}
	.politica {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.intro p {
		margin: 0;
		font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
		line-height: 1.5;
		color: var(--lols-carbon);
	}
	.intro .firma {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 2px solid var(--lols-verde);
		font-family: var(--fuente-datos);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--gris-medio);
	}
	.compromisos-titulo {
		margin: 0 0 1rem;
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}
	.compromisos {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: compromiso;
		border-top: 2px solid var(--lols-carbon);
	}
	.compromisos li {
		counter-increment: compromiso;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 0.75rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--linea);
		font-size: 1.05rem;
	}
	.compromisos li::before {
		content: counter(compromiso, decimal-leading-zero);
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde);
	}
	@media (max-width: 760px) {
		.politica {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.registros {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.registros li {
		padding: 0.9rem 1.25rem;
		border: 1px solid var(--linea);
		border-top: 4px solid var(--lols-verde);
		background: var(--lols-blanco);
		font-family: var(--fuente-titulos);
		font-size: 1.15rem;
		font-weight: 700;
	}
	.documentos {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-block: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid var(--linea);
	}
	.documentos h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin-bottom: 0.4rem;
	}
</style>
