---
// Empresa: propósito en grande (Heatherwick) y equipamiento propio en fotos (reunión con don
// Luis). Mostrar, no contar: los valores y normas en texto se sacaron; la seguridad tiene su
// propia página. Don Luis (08-10-2026): sin línea de tiempo y sin nombres de personas, así que
// salieron la trayectoria por años y "Las personas a cargo".
import Base from '../layouts/Base.astro';
import Contacto from '../components/Contacto.astro';
import { empresa, aniosTrayectoria } from '../data/empresa';
import Equipamiento from '../components/Equipamiento.astro';
import { videos } from '../data/referencia';
import ObraPortada from '../components/ObraPortada.astro';
---

<Base title="Empresa" description={`Quiénes somos: ${empresa.razonSocial}.`}>
	<ObraPortada video={videos.empresa}>
		<p class="etiqueta">Empresa</p>
		<h1 class="display largo">{empresa.directrices.replace(/.$/, '')}<span class="punto">.</span></h1>
		<p class="bajada">
			{aniosTrayectoria} años de experiencia en el área de construcción,
			con compromiso por las normas de seguridad y el respeto por el medio ambiente.
		</p>
	</ObraPortada>

	<section id="equipamiento" class="seccion gris ancla">
		<div class="contenedor">
			<Equipamiento />
		</div>
	</section>

	<Contacto />
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}
	.ancla {
		scroll-margin-top: 5rem;
	}
</style>
