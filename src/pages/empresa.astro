---
// Empresa: propósito en grande (Heatherwick), línea de tiempo (Tecsa / Ingevec), valores,
// seguridad y equipo con nombre (Mott MacDonald).
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import Contacto from '../components/Contacto.astro';
import { empresa, valores } from '../data/empresa';
import Referencial from '../components/Referencial.astro';
import { bandas, retratos } from '../data/referencia';
import { ejemplosEmpresa as ej } from '../data/ejemplos';
---

<Base title="Empresa" description={`Quiénes somos: ${empresa.razonSocial}.`}>
	<header class="portadilla contenedor">
		<p class="etiqueta">Empresa</p>
		<h1>{empresa.directrices}</h1>
		<p class="bajada">
			<Pendiente revisar="recalcular: el texto es de 2018">Más de 20 años de experiencia</Pendiente> en el área de construcción,
			con compromiso por las normas de seguridad y el respeto por el medio ambiente.
		</p>
	</header>

	<div class="banda marco">
		<Referencial imagen={bandas.empresa} carga="eager" />
	</div>

	<section class="seccion contenedor">
		<div class="cabecera"><h2>Nuestra trayectoria</h2></div>
		<ol class="linea">
			{
				ej.hitos.map((h) => (
					<li>
						<p class="anio"><Pendiente texto="año del hito">{h.anio}</Pendiente></p>
						<p><Pendiente texto="hito de la empresa">{h.texto}</Pendiente></p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="seccion gris">
		<div class="contenedor">
			<div class="cabecera">
				<h2>Un esquema basado en el esfuerzo, la creatividad y la responsabilidad</h2>
			</div>
			<div class="valores">
				{
					valores.map((v) => (
						<div>
							<h3>{v.titulo}</h3>
							<p>{v.texto ?? <Pendiente texto="qué significa en la práctica">{ej.valores[v.titulo]}</Pendiente>}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion contenedor dos">
		<div>
			<h2>Compromiso con las normas de seguridad y el medio ambiente</h2>
		</div>
		<Pendiente bloque texto="políticas, certificaciones, mutualidad e indicadores de seguridad">
			<ul class="lista">{ej.seguridad.map((x) => <li>{x}</li>)}</ul>
		</Pendiente>
	</section>

	<section class="seccion contenedor">
		<div class="cabecera"><h2>Las personas a cargo</h2></div>
		<div class="equipo">
			{
				ej.equipo.map((m, i) => (
					<div>
						<div class="retrato marco">
							<Referencial imagen={retratos.equipo[i]} sizes="(max-width: 960px) 50vw, 25vw" />
						</div>
						<p class="persona"><Pendiente texto="nombre">{m.nombre}</Pendiente></p>
						<p class="cargo"><Pendiente texto="cargo">{m.cargo}</Pendiente></p>
					</div>
				))
			}
		</div>
	</section>

	<Contacto />
</Base>

<style>
	.portadilla h1 {
		max-width: 16ch;
	}
	.banda {
		aspect-ratio: 21 / 8;
		background: #2a2a2a;
	}
	.linea {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.linea li {
		position: relative;
		padding-top: 2rem;
		border-top: 2px solid var(--lols-carbon);
	}
	.linea li::before {
		content: '';
		position: absolute;
		top: -0.45rem;
		left: 0;
		width: 0.8rem;
		height: 0.8rem;
		background: var(--lols-verde);
	}
	.anio {
		font-family: var(--fuente-titulos);
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: 0.5rem;
	}
	.valores {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde-oscuro);
	}
	.valores h3 {
		font-size: 1.75rem;
		letter-spacing: -0.03em;
	}
	.dos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.dos h2 {
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
	}
	.equipo {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.retrato {
		aspect-ratio: 4 / 5;
		margin-bottom: 1rem;
	}
	.equipo p {
		margin: 0 0 0.25rem;
	}
	.persona {
		font-family: var(--fuente-titulos);
		font-weight: 700;
	}
	.cargo {
		color: var(--gris-medio);
	}
	.lista {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--linea);
	}
	.lista li {
		padding: 0.85rem 0 0.85rem 1.5rem;
		border-bottom: 1px solid var(--linea);
		position: relative;
		font-size: 1.1rem;
	}
	.lista li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.35rem;
		width: 0.55rem;
		height: 0.55rem;
		background: var(--lols-verde);
	}
	@media (max-width: 960px) {
		.linea,
		.equipo {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 2.5rem;
		}
		.valores,
		.dos {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.banda {
			aspect-ratio: 4 / 3;
		}
		.linea {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
