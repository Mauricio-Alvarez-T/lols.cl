---
// Ruta propia para postulantes: no pasan por el canal comercial (docs/investigacion-secciones.md).
// Aquí el video de faena suma: muestra el trabajo real y la cultura.
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import VideoFondo from '../components/VideoFondo.astro';
import { empresa } from '../data/empresa';
import { videos } from '../data/referencia';
import { ejemplosTrabaja as ej } from '../data/ejemplos';

const asunto = encodeURIComponent('Postulación: [cargo]');
---

<Base title="Trabaja con nosotros" description="Súmate al equipo de LOLS Ingeniería.">
	<header class="portadilla contenedor">
		<p class="etiqueta">Trabaja con nosotros</p>
		<h1>Construye con nosotros</h1>
		<p class="bajada"><Pendiente texto="frase para postulantes">{ej.bajada}</Pendiente></p>
	</header>

	<VideoFondo video={videos.trabaja} clase="banda" eager />

	<section class="seccion contenedor">
		<p class="etiqueta">Por qué LOLS</p>
		<div class="cabecera"><h2>Lo que ofrecemos</h2></div>
		<div class="motivos">
			{
				ej.motivos.map((m, i) => (
					<div>
						<p class="indice">0{i + 1}</p>
						<h3><Pendiente texto="beneficio real">{m.titulo}</Pendiente></h3>
						<p><Pendiente texto="descripción del beneficio">{m.texto}</Pendiente></p>
					</div>
				))
			}
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor dos">
			<div>
				<p class="etiqueta">Perfiles</p>
				<h2>A quiénes buscamos</h2>
				<Pendiente bloque texto="cargos que la empresa busca habitualmente">
					<ul class="perfiles">{ej.perfiles.map((p) => <li>{p}</li>)}</ul>
				</Pendiente>
			</div>
			<div class="postular">
				<h2>Cómo postular</h2>
				<p>
					Envíenos su CV indicando el cargo al que postula en el asunto. Revisamos todas las postulaciones y
					contactamos a quienes calzan con las obras en curso.
				</p>
				<a class="boton" href={`mailto:${empresa.correo.valor}?subject=${asunto}`}>Enviar CV por correo</a>
				<p class="nota">
					<Pendiente texto="correo de postulaciones (¿rrhh@lols.cl?)" />
					Sus datos se usan solo para este proceso de selección. <a href="/privacidad/">Política de privacidad</a>.
				</p>
			</div>
		</div>
	</section>
</Base>

<style>
	.motivos {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde-oscuro);
	}
	.motivos h3 {
		font-size: 1.6rem;
		letter-spacing: -0.03em;
	}
	.motivos p:last-child {
		color: var(--lols-gris);
	}
	.dos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.dos h2 {
		font-size: clamp(1.6rem, 3vw, 2.25rem);
	}
	.perfiles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.perfiles li {
		padding: 0.55rem 1rem;
		background: var(--lols-blanco);
		border: 1px solid var(--linea);
		border-radius: 999px;
		font-family: var(--fuente-titulos);
		font-weight: 600;
	}
	.postular {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		background: var(--lols-blanco);
		border-top: 4px solid var(--lols-verde);
	}
	.postular p {
		color: var(--lols-gris);
	}
	.nota {
		margin: 1.25rem 0 0;
		font-size: 0.85rem;
	}
	@media (max-width: 860px) {
		.motivos,
		.dos {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
