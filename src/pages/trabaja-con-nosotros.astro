---
// Ruta propia para postulantes: no pasan por el canal comercial (docs/investigacion-secciones.md).
// Aquí el video de faena suma: muestra el trabajo real y la cultura. Se postula por cargo, en tres
// pasos (FormularioPostulacion, Marcos 09-10-2026); las postulaciones llegan por correo a
// destinatario_cv (lols@lols.cl según don Luis, hasta que se cree un correo propio).
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import ObraPortada from '../components/ObraPortada.astro';
import FormularioPostulacion from '../components/FormularioPostulacion.astro';
import { videos } from '../data/referencia';
import { ejemplosTrabaja as ej } from '../data/ejemplos';
---

<Base title="Trabaja con nosotros" description="Súmate al equipo de LOLS Ingeniería.">
	<ObraPortada video={videos.trabaja}>
		<p class="etiqueta">Trabaja con nosotros</p>
		<h1 class="display">Construye con nosotros<span class="punto">.</span></h1>
		<p class="bajada"><Pendiente texto="frase para postulantes">{ej.bajada}</Pendiente></p>
	</ObraPortada>


	<section class="seccion contenedor">
		<div class="cabecera"><h2>Lo que ofrecemos</h2></div>
		<div class="motivos">
			{
				ej.motivos.map((m) => (
					<div>
						<h3><Pendiente texto="beneficio real">{m.titulo}</Pendiente></h3>
						<p><Pendiente texto="descripción del beneficio">{m.texto}</Pendiente></p>
					</div>
				))
			}
		</div>
	</section>

	<section class="seccion gris" id="postular">
		<div class="contenedor">
			<div class="cabecera">
				<h2>¿Dónde quiere trabajar?</h2>
			</div>
			<p class="intro">Elija su grupo, vea los cargos y postule al suyo.</p>
			<FormularioPostulacion />
		</div>
	</section>
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}
	.motivos {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde-oscuro);
	}
	.motivos h3 {
		font-size: 1.6rem;
		letter-spacing: -0.03em;
	}
	.motivos p:last-child {
		color: var(--lols-gris);
	}
	.intro {
		margin: 0 0 clamp(1.5rem, 3vw, 2rem);
		font-size: 1.15rem;
		color: var(--lols-gris);
	}
	@media (max-width: 860px) {
		.motivos {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
