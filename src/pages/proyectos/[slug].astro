---
// Página de cada proyecto: enlace directo, respaldo sin JavaScript y lo que indexa Google. En
// el sitio, la misma ficha (FichaObra) se despliega bajo el carrusel sin salir de la página.
// Pirámide invertida, como Heatherwick: la foto primero y después la ficha.
import Base from '../../layouts/Base.astro';
import Pendiente from '../../components/Pendiente.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import Contacto from '../../components/Contacto.astro';
import FichaObra from '../../components/FichaObra.astro';
import { proyectos, plantilla, fotoPrincipal, type Proyecto } from '../../data/proyectos';
import Referencial from '../../components/Referencial.astro';
import { bandas } from '../../data/referencia';
import { ejemploProyecto as ej } from '../../data/ejemplos';

export function getStaticPaths() {
	// La plantilla de ejemplo solo existe fuera de producción.
	const produccion = (process.env.SITE ?? '').includes('://lols.cl');
	const lista = produccion ? proyectos : [...proyectos, plantilla];
	return lista.map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}

const { proyecto: p } = Astro.props as { proyecto: Proyecto };
const esEjemplo = p.slug === plantilla.slug;
const portada = esEjemplo ? p.fotos[0] : fotoPrincipal(p);
const otros = proyectos.filter((o) => o.slug !== p.slug).slice(0, 2);
---

<Base title={p.nombre ?? ej.nombre}>
	<div class="portada marco" style="view-transition-name: foto-proyecto">
		{
			portada && 'origen' in portada ? (
				<Referencial imagen={portada} carga="eager" />
			) : portada ? (
				<img src={portada.src} alt={portada.alt} />
			) : esEjemplo ? (
				<Referencial imagen={bandas.fichaEjemplo} carga="eager" />
			) : (
				<Pendiente bloque texto="foto principal, horizontal, alta resolución" />
			)
		}
	</div>

	<div class="contenedor ficha">
		<p class="etiqueta"><a href="/proyectos/">Proyectos</a></p>
		<FichaObra proyecto={p} />
	</div>

	{
		otros.length > 0 && (
			<section class="seccion contenedor">
				<div class="cabecera">
					<h2>Otros proyectos</h2>
					<a href="/proyectos/" class="enlace-flecha">Todos los proyectos</a>
				</div>
				<div class="otros">
					{otros.map((o) => <TarjetaProyecto proyecto={o} />)}
				</div>
			</section>
		)
	}

	<Contacto titulo="¿Un proyecto parecido?" />
</Base>

<style>
	.etiqueta a {
		color: inherit;
		text-decoration: none;
	}
	.ficha {
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(4rem, 9vw, 7rem);
	}
	.portada {
		aspect-ratio: 21 / 9;
		max-height: 85vh;
		background: #2a2a2a;
	}
	.otros {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}
	@media (max-width: 560px) {
		.portada {
			aspect-ratio: 4 / 3;
		}
		.otros {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
