---
// Ficha de proyecto (patrones Mott MacDonald / Heatherwick / Arup):
//   titular que dice el resultado → recuadro de datos fijo → foto principal →
//   desafío / solución / resultado con una cifra → galería → otros proyectos.
import Base from '../../layouts/Base.astro';
import Pendiente from '../../components/Pendiente.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import Contacto from '../../components/Contacto.astro';
import { servicioPorSlug } from '../../data/empresa';
import { proyectos, plantilla, estados, pictogramaDeTipo, type Proyecto } from '../../data/proyectos';
import Pictograma from '../../components/Pictograma.astro';
import Referencial from '../../components/Referencial.astro';
import { bandas, obras2018 } from '../../data/referencia';
import { ejemploProyecto as ej, ejemploFichaExtra, ejemploTestimonio as testimonio } from '../../data/ejemplos';
import VideoFondo from '../../components/VideoFondo.astro';
import { videos } from '../../data/referencia';

export function getStaticPaths() {
	// La plantilla de ejemplo solo existe fuera de producción.
	const produccion = (process.env.SITE ?? '').includes('://lols.cl');
	const lista = produccion ? proyectos : [...proyectos, plantilla];
	return lista.map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}

const { proyecto: p } = Astro.props as { proyecto: Proyecto };
const [portada, ...galeria] = p.fotos;
const esEjemplo = p.slug === plantilla.slug;
const otros = proyectos.filter((o) => o.slug !== p.slug).slice(0, 2);
const relato = [
	{ titulo: 'Desafío', texto: p.desafio, pendiente: 'qué problema tenía el mandante', ejemplo: ej.desafio },
	{ titulo: 'Solución', texto: p.solucion, pendiente: 'qué hizo LOLS y cómo', ejemplo: ej.solucion },
	{ titulo: 'Resultado', texto: p.resultado, pendiente: 'qué se logró', ejemplo: ej.resultado },
];
---

<Base title={p.nombre ?? ej.nombre}>
	<header class="portadilla contenedor">
		<p class="etiqueta"><a href="/proyectos/">Proyectos</a></p>
		<p class="nombre">{p.nombre ?? <Pendiente texto="nombre del proyecto">{ej.nombre}</Pendiente>}</p>
		<h1>{p.titular ?? <Pendiente texto="el resultado en una frase (no el nombre de la obra)">{ej.titular}</Pendiente>}</h1>
		<dl class="datos">
			<div>
				<dt>Tipo de obra</dt>
				<dd class="con-picto">
					<Pictograma nombre={pictogramaDeTipo(p.tipo ?? ej.tipo)} />
					{p.tipo ?? <Pendiente texto="tipo de obra">{ej.tipo}</Pendiente>}
				</dd>
			</div>
			<div><dt>Mandante</dt><dd>{p.mandante ?? <Pendiente texto="mandante">{ej.mandante}</Pendiente>}</dd></div>
			<div><dt>Comuna</dt><dd>{p.comuna ?? <Pendiente texto="comuna">{ej.comuna}</Pendiente>}</dd></div>
			<div><dt>Dirección</dt><dd>{p.direccion ?? <Pendiente texto="dirección (confirmar si se puede publicar)">{ej.direccion}</Pendiente>}</dd></div>
			<div><dt>Superficie construida</dt><dd>{p.superficie ?? <Pendiente texto="m² construidos">{ej.superficie}</Pendiente>}</dd></div>
			{
				p.estado === 'terminado' || (esEjemplo && !p.estado) ? (
					<div><dt>Año de término</dt><dd>{p.anio ?? <Pendiente texto="año">{ej.anio}</Pendiente>}</dd></div>
				) : (
					<div><dt>{p.estado === 'contratado' ? 'Inicio previsto' : 'Inicio'}</dt><dd>{p.inicio ?? <Pendiente texto="mes y año de inicio">{ej.inicio}</Pendiente>}</dd></div>
				)
			}
			<div><dt>Plazo</dt><dd>{p.plazo ?? <Pendiente texto="plazo de ejecución">{ejemploFichaExtra.plazo}</Pendiente>}</dd></div>
			<div><dt>Rol de LOLS</dt><dd><Pendiente texto="contratista principal o subcontrato">{ejemploFichaExtra.rol}</Pendiente></dd></div>
			<div><dt>Servicios</dt><dd>{p.servicios.map((s) => servicioPorSlug(s).nombre).join(', ')}</dd></div>
			<div><dt>Estado</dt><dd>{p.estado ? estados[p.estado] : <Pendiente texto="estado">{ej.estado}</Pendiente>}</dd></div>
		</dl>
	</header>

	<div class="portada marco" style="view-transition-name: foto-proyecto">
		{
			portada ? (
				<img src={portada.src} alt={portada.alt} />
			) : esEjemplo ? (
				<Referencial imagen={bandas.fichaEjemplo} carga="eager" />
			) : (
				<Pendiente bloque texto="foto principal, horizontal, alta resolución" />
			)
		}
	</div>

	<section class="seccion contenedor relato">
		{
			relato.map((r) => (
				<div class="paso">
					<h2>{r.titulo}</h2>
					<p>{r.texto ?? <Pendiente texto={r.pendiente}>{r.ejemplo}</Pendiente>}</p>
				</div>
			))
		}
		<div class="cifra">
			<p class="numero">{p.cifra?.valor ?? <Pendiente texto="cifra">{ej.cifra.valor}</Pendiente>}</p>
			<p>{p.cifra?.etiqueta ?? <Pendiente texto="qué mide (plazo, m², ahorro…)">{ej.cifra.etiqueta}</Pendiente>}</p>
		</div>
	</section>

	<section class="seccion contenedor testimonio-bloque">
		<Pendiente bloque texto="testimonio real del mandante, con nombre, cargo y empresa">
			<figure class="testimonio">
				<blockquote>“{testimonio.cita}”</blockquote>
				<figcaption><strong>{testimonio.nombre}</strong> · {testimonio.cargo}, {testimonio.empresa}</figcaption>
			</figure>
		</Pendiente>
	</section>

	{
		p.video && (
			<section class="seccion contenedor">
				<h2 class="subtitulo">La obra en video</h2>
				<video class="video-obra" src={p.video.src} poster={p.video.poster} controls playsinline preload="none" />
			</section>
		)
	}

	{
		esEjemplo && (
			<section class="seccion contenedor">
				<h2 class="subtitulo">La obra en un minuto</h2>
				<VideoFondo video={videos.timelapse} modo="clic" clase="timelapse" etiqueta="Ver timelapse de la obra" />
			</section>
		)
	}

	<section class="seccion contenedor">
		<h2 class="sr-only">Galería</h2>
		<div class="galeria">
			{
				galeria.length
					? galeria.map((f) => (
							<div class="marco">
								<img src={f.src} alt={f.alt} loading="lazy" />
							</div>
						))
					: esEjemplo
						? obras2018.slice(3, 6).map((f) => (
								<div class="marco">
									<Referencial imagen={f} />
								</div>
							))
						: [1, 2, 3].map(() => (
								<div class="marco">
									<Pendiente bloque texto="foto de galería" />
								</div>
							))
			}
		</div>
	</section>

	{
		otros.length > 0 && (
			<section class="seccion contenedor">
				<div class="cabecera">
					<h2>Otros proyectos</h2>
					<a href="/proyectos/" class="enlace-flecha">Todos los proyectos</a>
				</div>
				<div class="otros">
					{otros.map((o) => <TarjetaProyecto proyecto={o} />)}
				</div>
			</section>
		)
	}

	<Contacto titulo="¿Un proyecto parecido?" />
</Base>

<style>
	.etiqueta a {
		color: inherit;
		text-decoration: none;
	}
	.nombre {
		margin-bottom: 0.75rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--lols-verde-oscuro);
	}
	.con-picto {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.con-picto :global(.pictograma) {
		flex-shrink: 0;
		width: 1.35rem;
		height: 1.35rem;
		color: var(--lols-verde);
	}
	.portadilla h1 {
		max-width: 20ch;
		font-size: clamp(2.25rem, 5.5vw, 4.5rem);
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	.portada {
		aspect-ratio: 21 / 9;
		max-height: 85vh;
		background: #2a2a2a;
	}
	.relato {
		display: grid;
		grid-template-columns: repeat(3, 1fr) 0.8fr;
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.paso {
		padding-top: 1.25rem;
		border-top: 3px solid var(--lols-carbon);
	}
	.paso h2 {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
	}
	.cifra {
		padding-top: 1.25rem;
		border-top: 3px solid var(--lols-verde);
	}
	.cifra .numero {
		margin-bottom: 0.25rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
	}
	.cifra p:last-child {
		color: var(--gris-medio);
	}
	.testimonio {
		margin: 0;
		max-width: 52rem;
		padding-left: 1.5rem;
		border-left: 4px solid var(--lols-verde);
	}
	.testimonio blockquote {
		margin: 0 0 1rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.4rem, 3vw, 2.1rem);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}
	.testimonio figcaption {
		color: var(--gris-medio);
	}
	.subtitulo {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
		margin-bottom: 1.25rem;
	}
	.contenedor :global(.timelapse),
	.video-obra {
		aspect-ratio: 16 / 9;
	}
	.video-obra {
		width: 100%;
		background: #000;
	}
	.galeria {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 1rem;
	}
	.galeria .marco {
		aspect-ratio: 4 / 3;
	}
	.galeria .marco:first-child {
		grid-row: span 2;
		aspect-ratio: auto;
	}
	.otros {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}
	@media (max-width: 960px) {
		.relato {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 560px) {
		.portada {
			aspect-ratio: 4 / 3;
		}
		.galeria,
		.otros {
			grid-template-columns: minmax(0, 1fr);
		}
		.galeria .marco:first-child {
			grid-row: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>
