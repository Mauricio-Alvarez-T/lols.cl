---
// Portafolio en tres bloques (las obras en construcción y las terminadas, en carrusel como
// los destacados de Ramboll), en el orden que pidió don Luis (docs/reunion-inicial.md):
//   1. En construcción: lo que LOLS está haciendo hoy, con tipo, superficie, comuna y dirección.
//   2. Contratados: obras firmadas que aún no parten (muestran cartera y continuidad), en fichas
//      con el render de lo que se hará (de ejemplo mientras no estén los reales).
//   3. Terminados: el portafolio de siempre.
// Arriba, un índice con la cantidad de cada bloque. Las URLs viejas (?estado=...) saltan al
// bloque que corresponde.
import Base from '../../layouts/Base.astro';
import Pendiente from '../../components/Pendiente.astro';
import CarruselObras from '../../components/CarruselObras.astro';
import { deProyecto, deMuestra } from '../../data/carrusel';
import Contacto from '../../components/Contacto.astro';
import Pictograma from '../../components/Pictograma.astro';
import { proyectosPorEstado, pictogramaDeTipo, fotoPrincipal } from '../../data/proyectos';
import Referencial from '../../components/Referencial.astro';
import { obras2018, obrasEnCurso, obrasEjemplo, rendersContratados } from '../../data/referencia';
import { ejemplosContratados } from '../../data/ejemplos';

const enCurso = proyectosPorEstado('en-curso');
const contratados = proyectosPorEstado('contratado');
const terminados = proyectosPorEstado('terminado');
const hayReales = enCurso.length + contratados.length + terminados.length > 0;
// Las contratadas pueden faltar aunque haya obras reales: mientras tanto, las fichas de muestra.
const contratadosMuestra = contratados.length === 0;
// Fichas de las contratadas: las reales o, mientras no haya, las de muestra con su render de ejemplo.
const fichasContratadas = contratadosMuestra
	? ejemplosContratados.map((c, i) => ({ ...c, imagen: rendersContratados[i], ejemplo: true }))
	: contratados.map((p) => ({ nombre: p.nombre, tipo: p.tipo, comuna: p.comuna, superficie: p.superficie, inicio: p.inicio, imagen: fotoPrincipal(p), ejemplo: false }));
// Terminadas: las reales y, entre medio, las de ejemplo de los años que faltan (2021 a 2025),
// de la más nueva a la más antigua.
const terminadasCarrusel = [
	...terminados.map((p) => ({ anio: p.anio ?? 0, obra: deProyecto(p) })),
	...obrasEjemplo.map((r) => ({ anio: Number(r.ejemplo.anio), obra: deMuestra(r) })),
]
	.sort((a, b) => b.anio - a.anio)
	.map((t) => t.obra);

// Cantidades del índice: las reales, o las de las muestras mientras no haya proyectos.
const cuenta = hayReales
	? { enCurso: enCurso.length, contratados: contratados.length || ejemplosContratados.length, terminados: terminadasCarrusel.length }
	: { enCurso: obrasEnCurso.length, contratados: ejemplosContratados.length, terminados: obras2018.length };
const bloques = [
	{ id: 'en-construccion', estado: 'en-curso', titulo: 'En construcción', n: cuenta.enCurso, muestra: !hayReales },
	{ id: 'contratados', estado: 'contratado', titulo: 'Contratados', n: cuenta.contratados, muestra: contratadosMuestra },
	{ id: 'terminados', estado: 'terminado', titulo: 'Terminados', n: cuenta.terminados, muestra: !hayReales || obrasEjemplo.length > 0 },
];
import ObraPortada from '../../components/ObraPortada.astro';
import { bandas } from '../../data/referencia';
---

<Base title="Proyectos" description="Obras en construcción, contratadas y terminadas de LOLS Ingeniería.">
	<ObraPortada imagen={bandas.proyectos} baja>
		<p class="etiqueta">Proyectos</p>
		<h1 class="display largo">Obras que hablan por nosotros</h1>
		<p class="bajada"><Pendiente texto="una frase sobre el portafolio (tipos de obra, años, regiones)">Edificios de oficinas, centros de bodegas y obras industriales en la Región Metropolitana.</Pendiente></p>
	</ObraPortada>

	<nav class="contenedor bloques" aria-label="Bloques de proyectos">
		<div class="indice">
			{
				bloques.map((b) => (
					<a href={`#${b.id}`} data-estado={b.estado}>
						<span class="n">{b.muestra ? <Pendiente texto="cantidad">{b.n}</Pendiente> : b.n}</span>
						<span>{b.titulo}</span>
					</a>
				))
			}
		</div>
	</nav>

	{
		hayReales ? (
			<CarruselObras id="en-construccion" titulo="En construcción" nota="Obras en ejecución hoy." obras={enCurso.map(deProyecto)}>
				<Pendiente texto="render real (los que se ven son de ejemplo), tipo de obra, superficie e inicio de cada obra en construcción" />
			</CarruselObras>
		) : (
			<CarruselObras id="en-construccion" titulo="En construcción" nota="Obras en ejecución hoy." obras={obrasEnCurso.map(deMuestra)}>
				<Pendiente texto="obras en construcción con superficie, comuna, dirección y tipo; fotos y videos de Rodrigo" />
			</CarruselObras>
		)
	}

	<section id="contratados" class="seccion gris bloque">
		<div class="contenedor">
			<div class="cabecera">
				<h2>Contratados</h2>
				<p class="nota">Obras adjudicadas que parten en los próximos meses.</p>
			</div>
			{contratadosMuestra && <Pendiente texto="obras contratadas que aún no parten, con su render o plano" />}
			<ul class="contratadas">
				{
					fichasContratadas.map((f) => (
						<li>
							<div class="marco foto">
								{'origen' in f.imagen ? (
									<Referencial imagen={f.imagen} sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw" />
								) : (
									<img src={f.imagen.src} alt={f.imagen.alt} loading="lazy" />
								)}
							</div>
							<p class="inicio">
								Inicio previsto: {f.ejemplo ? <Pendiente texto="inicio previsto">{f.inicio}</Pendiente> : (f.inicio ?? <Pendiente texto="inicio" />)}
							</p>
							<h3 class="obra">
								<span class="picto"><Pictograma nombre={pictogramaDeTipo(f.tipo)} /></span>
								{f.ejemplo ? <Pendiente texto="nombre">{f.nombre}</Pendiente> : (f.nombre ?? <Pendiente texto="nombre" />)}
							</h3>
							<p class="datos-obra">
								{f.ejemplo ? <Pendiente texto="tipo">{f.tipo}</Pendiente> : f.tipo}
								{(f.ejemplo || f.comuna) && <> · {f.ejemplo ? <Pendiente texto="comuna">{f.comuna}</Pendiente> : f.comuna}</>}
								{(f.ejemplo || f.superficie) && <> · {f.ejemplo ? <Pendiente texto="m²">{f.superficie}</Pendiente> : f.superficie}</>}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		hayReales ? (
			<CarruselObras id="terminados" titulo="Terminados" nota="Las más recientes y una obra por año de las anteriores." obras={terminadasCarrusel}>
				<Pendiente texto="la obra real de cada año de 2021 a 2025 (las que se ven son de ejemplo) y fotos reales de las terminadas desde 2019" />
			</CarruselObras>
		) : (
			<CarruselObras id="terminados" titulo="Terminados" obras={obras2018.map(deMuestra)}>
				<Pendiente texto="obras terminadas que elija don Luis, con fotos nuevas (las de 2018 salen del sitio)" />
			</CarruselObras>
		)
	}

	<Contacto />
</Base>

<script>
	// URLs viejas del sitio de 2018 (/proyectos-en-construccion/ → ?estado=en-curso): saltar al bloque.
	const estado = new URLSearchParams(location.search).get('estado');
	const destino = estado ? document.querySelector<HTMLAnchorElement>(`.indice a[data-estado="${CSS.escape(estado)}"]`) : null;
	if (destino) {
		history.replaceState(null, '', location.pathname + destino.hash);
		document.querySelector(destino.hash)?.scrollIntoView();
	}
</script>

<style>
	.bloques {
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}
	.indice {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-block: 1px solid var(--lols-carbon);
	}
	.indice a {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 1rem 1rem 1rem 0;
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
	}
	.indice a + a {
		padding-left: 1rem;
		border-left: 1px solid var(--linea);
	}
	.indice a:hover {
		color: var(--lols-verde-oscuro);
	}
	.indice .n {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}
	.bloque {
		scroll-margin-top: 5rem;
	}
	.nota {
		margin: 0;
		color: var(--gris-medio);
	}

	/* Contratadas: fichas con el render de lo que se hará, el inicio y los datos de la obra. */
	.contratadas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
	}
	.contratadas .foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	.inicio {
		margin: 0 0 0.4rem;
		font-family: var(--fuente-datos);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--lols-verde-oscuro);
	}
	.obra {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 0.4rem;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}
	.picto {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border: 1.5px solid var(--lols-verde);
		color: var(--lols-verde);
	}
	.picto :global(.pictograma) {
		width: 1.4rem;
		height: 1.4rem;
	}
	.datos-obra {
		margin: 0;
		color: var(--lols-gris);
	}
	@media (max-width: 960px) {
		.contratadas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.indice {
			grid-template-columns: minmax(0, 1fr);
		}
		.indice a + a {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--linea);
		}
		.contratadas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
