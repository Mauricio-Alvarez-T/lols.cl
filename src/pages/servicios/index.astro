---
// Servicios agrupados por lo que el cliente necesita (patrón Ramboll), cada uno con su
// problema en primer plano (patrón Arup).
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Pendiente from '../../components/Pendiente.astro';
import Contacto from '../../components/Contacto.astro';
import { necesidades, necesidadesRevisar, servicioPorSlug, servicios } from '../../data/empresa';
import { ejemplosServicio } from '../../data/ejemplos';
---

<Base title="Servicios" description={`Servicios de LOLS Ingeniería: ${servicios.map((s) => s.nombre).join(', ')}.`}>
	<header class="portadilla contenedor">
		<p class="etiqueta">Servicios</p>
		<h1>¿Qué necesita?</h1>
		<p class="bajada"><Pendiente texto="una frase que presente los servicios">Seis especialidades para que su proyecto tenga un solo responsable.</Pendiente></p>
		<Pendiente texto={necesidadesRevisar} />
	</header>

	{
		necesidades.map((n, i) => (
			<section class="seccion contenedor bloque">
				<div class="lado">
					<p class="indice">0{i + 1}</p>
					<h2>{n.titulo}</h2>
				</div>
				<ul>
					{n.servicios.map((slug) => {
						const s = servicioPorSlug(slug);
						return (
							<li>
								<a href={`/servicios/${s.slug}/`}>
									<Icono nombre={s.icono} />
									<div>
										<h3>{s.nombre}</h3>
										<p>{s.problema ?? <Pendiente texto="el problema del cliente que resuelve">{ejemplosServicio[s.slug].problema}</Pendiente>}</p>
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		))
	}

	<Contacto />
</Base>

<style>
	.bloque {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: clamp(1.5rem, 5vw, 4rem);
		padding-block: clamp(2.5rem, 6vw, 4rem);
		border-top: 1px solid var(--linea);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde);
	}
	.lado h2 {
		position: sticky;
		top: 6rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	ul a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1.25rem;
		padding: 1.75rem;
		background: var(--lols-gris-claro);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s;
	}
	ul a:hover {
		background: #e6e6e6;
	}
	ul a:hover h3 {
		color: var(--lols-verde-oscuro);
	}
	ul :global(.icono) {
		width: 2.25rem;
		height: 2.25rem;
		color: var(--lols-verde);
	}
	h3 {
		font-size: 1.6rem;
		margin-bottom: 0.4rem;
	}
	ul p {
		margin: 0;
		color: var(--lols-gris);
	}
	@media (max-width: 760px) {
		.bloque {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
