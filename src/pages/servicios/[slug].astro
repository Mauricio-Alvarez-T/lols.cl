---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Pendiente from '../../components/Pendiente.astro';
import { servicios, type Servicio } from '../../data/empresa';

export function getStaticPaths() {
	return servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const { servicio } = Astro.props as { servicio: Servicio };
const otros = servicios.filter((s) => s.slug !== servicio.slug);
---

<Base title={servicio.nombre}>
	<header class="encabezado-pagina">
		<div class="contenedor">
			<p class="antetitulo"><a href="/servicios/">Servicios</a></p>
			<div class="titulo">
				<Icono nombre={servicio.icono} />
				<h1>{servicio.nombre}</h1>
			</div>
			<p>{servicio.resumen ?? <Pendiente texto="descripción breve" />}</p>
		</div>
	</header>

	<section class="seccion">
		<div class="contenedor columnas">
			<div>
				<h2>Qué incluye</h2>
				<Pendiente bloque texto="alcance del servicio" />
			</div>
			<div>
				<h2>Para quién</h2>
				<Pendiente bloque texto="tipo de cliente o industria" />
			</div>
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor">
			<h2>Proyecto de ejemplo</h2>
			<Pendiente bloque texto={`un proyecto de ${servicio.nombre.toLowerCase()} con foto y ficha`} />
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<h2>Otros servicios</h2>
			<ul class="otros">
				{otros.map((s) => <li><a href={`/servicios/${s.slug}/`}>{s.nombre}</a></li>)}
			</ul>
		</div>
	</section>
</Base>

<style>
	.antetitulo a {
		color: inherit;
		text-decoration: none;
	}
	.titulo {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.titulo h1 {
		margin: 0;
	}
	.titulo :global(.icono) {
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		color: var(--lols-verde);
	}
	.encabezado-pagina .titulo + p {
		margin-top: 1rem;
	}
	.columnas {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
	}
	.otros {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.otros a {
		display: block;
		padding: 0.6rem 1.1rem;
		border: 1px solid #d0d0d0;
		border-radius: 999px;
		color: var(--lols-carbon);
		text-decoration: none;
		font-weight: 600;
	}
	.otros a:hover {
		border-color: var(--lols-verde-oscuro);
		color: var(--lols-verde-oscuro);
	}
	@media (max-width: 760px) {
		.columnas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
