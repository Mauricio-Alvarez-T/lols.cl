---
// Página de servicio: parte del problema del cliente (Arup / Ramboll), sigue con lo que hace
// LOLS, lo muestra en proyectos reales y termina con una persona de contacto.
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Pendiente from '../../components/Pendiente.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import Contacto from '../../components/Contacto.astro';
import { servicios, type Servicio } from '../../data/empresa';
import { proyectos } from '../../data/proyectos';
import Referencial from '../../components/Referencial.astro';
import { bandasServicio, obras2018 } from '../../data/referencia';
import { ejemplosServicio } from '../../data/ejemplos';

export function getStaticPaths() {
	return servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const { servicio: s } = Astro.props as { servicio: Servicio };
const relacionados = proyectos.filter((p) => p.servicios.includes(s.slug)).slice(0, 3);
const otros = servicios.filter((o) => o.slug !== s.slug);
const ej = ejemplosServicio[s.slug];
import ObraPortada from '../../components/ObraPortada.astro';
---

<Base title={s.nombre}>
	<ObraPortada imagen={bandasServicio[s.slug]} baja>
		<p class="etiqueta"><a href="/servicios/">Servicios</a></p>
		<div class="nombre"><Icono nombre={s.icono} /><span>{s.nombre}</span></div>
		<h1 class="display largo">{s.problema ?? <Pendiente texto="el problema del cliente que este servicio resuelve, como titular">{ej.problema}</Pendiente>}</h1>
		<p class="bajada">{s.resumen ?? <Pendiente texto="cómo lo resuelve LOLS, en dos líneas">{ej.resumen}</Pendiente>}</p>
	</ObraPortada>

	<section class="seccion contenedor columnas">
		<div>
			<h2>Qué hacemos</h2>
			<Pendiente bloque texto="alcance: lista de trabajos que incluye">
				<ul class="lista">{ej.alcance.map((a) => <li>{a}</li>)}</ul>
			</Pendiente>
		</div>
		<div>
			<h2>Para quién</h2>
			<Pendiente bloque texto="tipos de cliente o industria">
				<ul class="lista">{ej.clientes.map((c) => <li>{c}</li>)}</ul>
			</Pendiente>
		</div>
	</section>

	<section class="seccion contenedor">
		<div class="cabecera">
			<h2>En obra</h2>
			<a href={`/proyectos/?servicio=${s.slug}`} class="enlace-flecha">Proyectos de {s.nombre.toLowerCase()}</a>
		</div>
		<div class="grilla">
			{relacionados.length ? relacionados.map((p) => <TarjetaProyecto proyecto={p} />) : obras2018.slice(0, 3).map((f, i) => <TarjetaProyecto referencia={f} lamina={i + 1} />)}
		</div>
	</section>

	<section class="seccion contenedor otros">
		<h2>Otros servicios</h2>
		<ul>
			{otros.map((o) => <li><a href={`/servicios/${o.slug}/`}>{o.nombre}</a></li>)}
		</ul>
	</section>

	<Contacto titulo={`Cotice ${s.nombre.toLowerCase()}`} />
</Base>

<style>
	.etiqueta a {
		color: inherit;
		text-decoration: none;
	}
	.nombre {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--lols-blanco);
	}
	.nombre :global(.icono) {
		width: 2rem;
		height: 2rem;
		color: var(--lols-lima);
	}
	.columnas {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
	}
	.columnas h2 {
		font-size: 1.75rem;
		letter-spacing: -0.02em;
	}
	.lista {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--linea);
	}
	.lista li {
		padding: 0.85rem 0 0.85rem 1.5rem;
		border-bottom: 1px solid var(--linea);
		position: relative;
		font-size: 1.1rem;
	}
	.lista li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 1.35rem;
		width: 0.55rem;
		height: 0.55rem;
		background: var(--lols-verde);
	}
	.grilla {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}
	.otros h2 {
		font-size: 1.5rem;
		letter-spacing: -0.02em;
		margin-bottom: 1.25rem;
	}
	.otros ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.otros a {
		display: block;
		padding: 0.6rem 1.1rem;
		border: 1px solid var(--linea);
		border-radius: 999px;
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		text-decoration: none;
	}
	.otros a:hover {
		border-color: var(--lols-carbon);
	}
	@media (max-width: 960px) {
		.grilla {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 760px) {
		.columnas,
		.grilla {
			grid-template-columns: minmax(0, 1fr);
		}
		.banda {
			aspect-ratio: 4 / 3;
		}
	}
</style>
