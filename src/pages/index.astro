---
// Portada. Estructura tomada de las referencias (docs/brief.md § 3):
//   frase grande sobre blanco (Heatherwick) → video de obra a todo el ancho (BESIX / Ingevec) →
//   cifras (Skanska) → servicios por necesidad del cliente (Ramboll) →
//   proyecto destacado desafío/solución/resultado (Arup) → obras en construcción hoy y cartera
//   contratada (reunión con don Luis) → equipamiento propio (reunión) → clientes (Tecsa) →
//   seguridad y calidad → cómo trabajamos → contacto con persona.
// Orden y secciones validados con 31 sitios del rubro: docs/investigacion-secciones.md.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Pendiente from '../components/Pendiente.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import Contacto from '../components/Contacto.astro';
import { empresa, necesidades, necesidadesRevisar, servicioPorSlug, aniosTrayectoria, fundacion } from '../data/empresa';
import { proyectosPorEstado } from '../data/proyectos';
import Equipamiento from '../components/Equipamiento.astro';
import Referencial from '../components/Referencial.astro';
import { destacado, obrasEnCurso, logosEjemplo, videos } from '../data/referencia';
import ObraPortada from '../components/ObraPortada.astro';
import BloqueSeguridad from '../components/BloqueSeguridad.astro';
import Proceso from '../components/Proceso.astro';
import { ejemploBajadaHero, ejemplosContratados } from '../data/ejemplos';

const enObra = proyectosPorEstado('en-curso').slice(0, 3);
const contratados = proyectosPorEstado('contratado');
// Años: dato real (fundación 1995). El resto es de ejemplo hasta tener los reales.
const cifras = [
	{ etiqueta: `años de trayectoria, desde ${fundacion}`, valor: String(aniosTrayectoria) },
	{ etiqueta: 'obras ejecutadas', pendiente: 'n.º de obras', ejemplo: '150+' },
	{ etiqueta: 'm² construidos', pendiente: 'm²', ejemplo: '80.000' },
	{ etiqueta: 'personas en el equipo', pendiente: 'dotación', ejemplo: '60' },
];
---

<Base title="LOLS Ingeniería" description={`${empresa.razonSocial}. ${empresa.lema}.`}>
	<ObraPortada video={videos.portada}>
		<h1 class="display">{empresa.lema}<span class="punto">.</span></h1>
		<p class="bajada"><Pendiente texto="una frase: qué hace LOLS, para quién y dónde">{ejemploBajadaHero}</Pendiente></p>
		<div class="acciones">
			<a href="/proyectos/" class="boton">Ver proyectos</a>
			<a href="/contacto/" class="boton secundario">Cotizar</a>
		</div>
	</ObraPortada>

	<section class="cifras contenedor" aria-label="LOLS en cifras">
		{
			cifras.map((c) => (
				<div>
					<p class="numero">{c.valor ?? <Pendiente texto={c.pendiente}>{c.ejemplo}</Pendiente>}</p>
					<p>{c.etiqueta}</p>
				</div>
			))
		}
	</section>

	<section class="seccion">
		<div class="contenedor">
			<p class="etiqueta">Servicios</p>
			<div class="cabecera">
				<h2>¿Qué necesita?</h2>
				<a href="/servicios/" class="enlace-flecha">Todos los servicios</a>
			</div>
			<Pendiente texto={`servicios agrupados por necesidad: ${necesidadesRevisar}`} />
			<div class="necesidades">
				{
					necesidades.map((n) => (
						<div class="necesidad">
							<h3>{n.titulo}</h3>
							<ul>
								{n.servicios.map((slug) => {
									const s = servicioPorSlug(slug);
									return (
										<li>
											<a href={`/servicios/${s.slug}/`}>
												<Icono nombre={s.icono} />
												<span>{s.nombre}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor destacado">
			<div class="destacado-foto marco">
				<Referencial imagen={destacado} />
			</div>
			<div>
				<p class="etiqueta">Proyecto destacado</p>
				<h2 class="titular"><Pendiente texto="el resultado en una frase">Cinco pisos de comercio y oficinas en una esquina de alto tránsito</Pendiente></h2>
				<dl class="datos">
					<div><dt>Mandante</dt><dd><Pendiente texto="mandante">Inmobiliaria Ejemplo</Pendiente></dd></div>
					<div><dt>Ubicación</dt><dd><Pendiente texto="comuna">Santiago</Pendiente></dd></div>
					<div><dt>Año</dt><dd><Pendiente texto="año">2018</Pendiente></dd></div>
				</dl>
				<ol class="relato">
					<li><strong>Desafío</strong> <Pendiente texto="qué problema tenía el mandante">Construir sin interrumpir el comercio de la cuadra.</Pendiente></li>
					<li><strong>Solución</strong> <Pendiente texto="qué hizo LOLS">Obra gruesa, terminaciones e instalaciones con un solo equipo, por etapas.</Pendiente></li>
					<li><strong>Resultado</strong> <Pendiente texto="qué se logró, con un número">Entregado en 14 meses, sin accidentes con tiempo perdido.</Pendiente></li>
				</ol>
				<a href="/proyectos/ejemplo/" class="enlace-flecha">Ver el proyecto</a>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<div class="cabecera">
				<h2>En obra ahora</h2>
				<a href="/proyectos/#en-construccion" class="enlace-flecha">Todos los proyectos</a>
			</div>
			<div class="grilla-proyectos">
				{
					enObra.length
						? enObra.map((p, i) => <TarjetaProyecto proyecto={p} lamina={i + 1} destacada={i === 0} />)
						: obrasEnCurso.map((f, i) => <TarjetaProyecto referencia={f} estado="en-curso" lamina={i + 1} destacada={i === 0} />)
				}
			</div>
			<a href="/proyectos/#contratados" class="cartera">
				<span class="cartera-n">
					{contratados.length || <Pendiente texto="n.º de obras contratadas">{ejemplosContratados.length}</Pendiente>}
				</span>
				<span class="cartera-texto">
					obras contratadas que parten en los próximos meses
					<span class="enlace-flecha">Ver la cartera</span>
				</span>
			</a>
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor">
			<Equipamiento compacto />
		</div>
	</section>

	<section class="seccion clientes">
		<div class="contenedor">
			<h2 class="clientes-titulo">Han confiado en nosotros</h2>
			<Pendiente texto="logos reales de clientes (con su autorización); los actuales son genéricos" />
			<ul class="logos">
				{
					logosEjemplo.map((src) => (
						<li class="logo">
							<img src={src} alt="Logo de cliente (ejemplo)" loading="lazy" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<BloqueSeguridad />

	<section class="seccion">
		<div class="contenedor">
			<Proceso />
		</div>
	</section>

	<Contacto />
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}

	.banda {
		aspect-ratio: 21 / 9;
		max-height: 80vh;
		width: 100%;
		background: #2a2a2a;
	}

	.cifras {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
	}
	.cifras > div {
		padding: 0 1.5rem;
		border-left: 1px solid var(--linea);
	}
	.cifras > div:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.cifras p {
		margin: 0;
		color: var(--gris-medio);
	}
	.cifras .numero {
		min-height: 4.5rem;
		display: flex;
		align-items: center;
		font-family: var(--fuente-titulos);
		font-size: clamp(2.25rem, 5vw, 4.25rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--lols-carbon);
	}

	.nota {
		margin: -1rem 0 2rem;
		font-size: 0.9rem;
	}
	.necesidades {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde);
	}
	.necesidad h3 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.035em;
		margin-bottom: 1.25rem;
	}
	.necesidad ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--linea);
	}
	.necesidad a {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--linea);
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		font-size: 1.1rem;
		text-decoration: none;
	}
	.necesidad a {
		transition: padding-left 0.2s var(--suave), color 0.15s;
	}
	.necesidad a:hover {
		color: var(--lols-verde-oscuro);
		padding-left: 0.4rem;
	}
	.necesidad :global(.icono) {
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		color: var(--lols-verde);
	}

	.destacado {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}
	.destacado-foto {
		aspect-ratio: 4 / 5;
		background: #dcdcd8;
	}
	.titular {
		font-size: clamp(1.9rem, 3.5vw, 2.75rem);
	}
	.destacado .datos {
		margin-block: 1.5rem;
	}
	.relato {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		display: grid;
		gap: 0.85rem;
	}
	.relato strong {
		display: block;
		font-family: var(--fuente-titulos);
	}

	/* Jerarquía: la primera obra ocupa dos columnas y dos filas; las otras dos, apiladas. */
	.grilla-proyectos {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: start;
	}
	.grilla-proyectos > :global(.destacada) {
		grid-row: span 2;
	}

	/* Cartera contratada: una línea que muestra continuidad, con su número grande. */
	.cartera {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-block: 1.25rem;
		border-block: 1px solid var(--lols-carbon);
		color: var(--lols-carbon);
		text-decoration: none;
	}
	.cartera-n {
		font-family: var(--fuente-titulos);
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.cartera-texto {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1.25rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		font-weight: 600;
	}
	.cartera-texto .enlace-flecha {
		font-size: 1rem;
	}

	.clientes-titulo {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		margin-bottom: 2rem;
	}
	.logos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1rem;
	}
	.logos li {
		display: grid;
		place-items: center;
		aspect-ratio: 3 / 2;
		padding: 1rem;
		border: 1px solid var(--linea);
	}
	.logos img {
		width: 100%;
		max-height: 2.5rem;
		object-fit: contain;
		opacity: 0.8;
	}

	@media (max-width: 960px) {
		.cifras {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
		.cifras > div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.necesidades,
		.destacado {
			grid-template-columns: minmax(0, 1fr);
		}
		.destacado-foto {
			aspect-ratio: 4 / 3;
		}
		.grilla-proyectos {
			grid-template-columns: repeat(2, 1fr);
		}
		.logos {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (max-width: 560px) {
		.banda {
			aspect-ratio: 4 / 3;
		}
		.grilla-proyectos {
			grid-template-columns: minmax(0, 1fr);
		}
		.logos {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
