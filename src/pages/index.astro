---
// Portada. Estructura tomada de las referencias (docs/brief.md § 3):
//   frase grande sobre blanco (Heatherwick) → obra a todo el ancho (BESIX / Ingevec) →
//   cifras (Skanska) → servicios por necesidad del cliente (Ramboll) →
//   proyecto destacado desafío/solución/resultado (Arup) → grilla de proyectos (BIG) →
//   clientes (Tecsa) → contacto con persona (Arup / Mott MacDonald).
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Pendiente from '../components/Pendiente.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import Contacto from '../components/Contacto.astro';
import { empresa, necesidades, necesidadesRevisar, servicioPorSlug } from '../data/empresa';
import { proyectos } from '../data/proyectos';
import Referencial from '../components/Referencial.astro';
import { bandas, destacado, obras2018 } from '../data/referencia';

const recientes = proyectos.slice(0, 3);
const cifras = [
	{ etiqueta: 'años de trayectoria', pendiente: 'años exactos' },
	{ etiqueta: 'obras ejecutadas', pendiente: 'n.º de obras' },
	{ etiqueta: 'm² construidos', pendiente: 'm²' },
	{ etiqueta: 'personas en el equipo', pendiente: 'dotación' },
];
---

<Base title="LOLS Ingeniería" description={`${empresa.razonSocial}. ${empresa.lema}.`}>
	<section class="hero contenedor">
		<h1 class="display">{empresa.lema}<span class="punto">.</span></h1>
		<div class="hero-pie">
			<p class="bajada"><Pendiente texto="una frase: qué hace LOLS y para quién" /></p>
			<div class="acciones">
				<a href="/proyectos/" class="boton">Ver proyectos</a>
				<a href="/contacto/" class="boton secundario">Cotizar</a>
			</div>
		</div>
	</section>

	<div class="banda marco">
		<Referencial imagen={bandas.portada} carga="eager" />
	</div>

	<section class="cifras contenedor" aria-label="LOLS en cifras">
		{
			cifras.map((c) => (
				<div>
					<p class="numero">
						<Pendiente texto={c.pendiente} />
					</p>
					<p>{c.etiqueta}</p>
				</div>
			))
		}
	</section>

	<section class="seccion">
		<div class="contenedor">
			<p class="etiqueta">Servicios</p>
			<div class="cabecera">
				<h2>¿Qué necesita?</h2>
				<a href="/servicios/" class="enlace-flecha">Todos los servicios</a>
			</div>
			<p class="nota"><Pendiente revisar={necesidadesRevisar}>Servicios agrupados por necesidad</Pendiente></p>
			<div class="necesidades">
				{
					necesidades.map((n, i) => (
						<div class="necesidad">
							<p class="indice">0{i + 1}</p>
							<h3>{n.titulo}</h3>
							<ul>
								{n.servicios.map((slug) => {
									const s = servicioPorSlug(slug);
									return (
										<li>
											<a href={`/servicios/${s.slug}/`}>
												<Icono nombre={s.icono} />
												<span>{s.nombre}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor destacado">
			<div class="destacado-foto marco">
				<Referencial imagen={destacado} />
			</div>
			<div>
				<p class="etiqueta">Proyecto destacado</p>
				<h2 class="titular"><Pendiente texto="el resultado en una frase" /></h2>
				<dl class="datos">
					<div><dt>Mandante</dt><dd><Pendiente texto="mandante" /></dd></div>
					<div><dt>Ubicación</dt><dd><Pendiente texto="comuna" /></dd></div>
					<div><dt>Año</dt><dd><Pendiente texto="año" /></dd></div>
				</dl>
				<ol class="relato">
					<li><strong>Desafío</strong> <Pendiente texto="qué problema tenía el mandante" /></li>
					<li><strong>Solución</strong> <Pendiente texto="qué hizo LOLS" /></li>
					<li><strong>Resultado</strong> <Pendiente texto="qué se logró, con un número" /></li>
				</ol>
				<a href="/proyectos/ejemplo/" class="enlace-flecha">Ver el proyecto</a>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<p class="etiqueta">Proyectos</p>
			<div class="cabecera">
				<h2>Obras recientes</h2>
				<a href="/proyectos/" class="enlace-flecha">Todos los proyectos</a>
			</div>
			<div class="grilla-proyectos">
				{recientes.length ? recientes.map((p) => <TarjetaProyecto proyecto={p} />) : obras2018.slice(0, 3).map((f) => <TarjetaProyecto referencia={f} />)}
			</div>
		</div>
	</section>

	<section class="seccion clientes">
		<div class="contenedor">
			<p class="etiqueta">Clientes</p>
			<h2 class="clientes-titulo">Han confiado en nosotros</h2>
			<ul class="logos">
				{
					[1, 2, 3, 4, 5, 6].map(() => (
						<li class="marco">
							<Pendiente bloque texto="logo" />
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Contacto />
</Base>

<style>
	.hero {
		padding-block: clamp(4rem, 12vw, 10rem) clamp(2.5rem, 6vw, 4.5rem);
	}
	.display {
		max-width: 12ch;
	}
	.punto {
		color: var(--lols-verde);
	}
	.hero-pie {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		margin-top: clamp(2rem, 5vw, 3.5rem);
	}
	.hero-pie .bajada {
		margin: 0;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.banda {
		aspect-ratio: 21 / 9;
		max-height: 80vh;
		width: 100%;
		background: #2a2a2a;
	}

	.cifras {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
	}
	.cifras > div {
		padding: 0 1.5rem;
		border-left: 1px solid var(--linea);
	}
	.cifras > div:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.cifras p {
		margin: 0;
		color: var(--gris-medio);
	}
	.cifras .numero {
		min-height: 4.5rem;
		display: flex;
		align-items: center;
		font-family: var(--fuente-titulos);
		font-size: clamp(2.75rem, 5vw, 4.25rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--lols-carbon);
	}

	.nota {
		margin: -1rem 0 2rem;
		font-size: 0.9rem;
	}
	.necesidades {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.indice {
		margin: 0 0 0.5rem;
		font-family: var(--fuente-titulos);
		font-weight: 700;
		color: var(--lols-verde);
	}
	.necesidad h3 {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.035em;
		margin-bottom: 1.25rem;
	}
	.necesidad ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--linea);
	}
	.necesidad a {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--linea);
		color: var(--lols-carbon);
		font-family: var(--fuente-titulos);
		font-weight: 600;
		font-size: 1.1rem;
		text-decoration: none;
	}
	.necesidad a::after {
		content: '→';
		margin-left: auto;
		color: var(--lols-verde-oscuro);
		transition: transform 0.2s;
	}
	.necesidad a:hover {
		color: var(--lols-verde-oscuro);
	}
	.necesidad a:hover::after {
		transform: translateX(4px);
	}
	.necesidad :global(.icono) {
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		color: var(--lols-verde);
	}

	.destacado {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}
	.destacado-foto {
		aspect-ratio: 4 / 5;
		background: #dcdcd8;
	}
	.titular {
		font-size: clamp(1.9rem, 3.5vw, 2.75rem);
	}
	.destacado .datos {
		margin-block: 1.5rem;
	}
	.relato {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		display: grid;
		gap: 0.85rem;
	}
	.relato strong {
		display: block;
		font-family: var(--fuente-titulos);
	}

	.grilla-proyectos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.clientes-titulo {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		margin-bottom: 2rem;
	}
	.logos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1rem;
	}
	.logos li {
		aspect-ratio: 3 / 2;
		background: var(--lols-blanco);
		border: 1px solid var(--linea);
	}

	@media (max-width: 960px) {
		.cifras {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 2rem;
		}
		.cifras > div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.necesidades,
		.destacado {
			grid-template-columns: minmax(0, 1fr);
		}
		.destacado-foto {
			aspect-ratio: 4 / 3;
		}
		.grilla-proyectos {
			grid-template-columns: repeat(2, 1fr);
		}
		.logos {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (max-width: 560px) {
		.banda {
			aspect-ratio: 4 / 3;
		}
		.grilla-proyectos {
			grid-template-columns: minmax(0, 1fr);
		}
		.logos {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
