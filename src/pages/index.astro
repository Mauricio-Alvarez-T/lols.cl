---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icono from '../components/Icono.astro';
import Pendiente from '../components/Pendiente.astro';
import { empresa, servicios } from '../data/empresa';
---

<Base title="LOLS Ingeniería" description={`${empresa.razonSocial}. ${empresa.lema}.`}>
	<section class="hero">
		<Logo simbolo class="hero-fondo" />
		<div class="contenedor hero-grilla">
			<div class="hero-texto">
				<p class="antetitulo">LOLS Ingeniería</p>
				<h1>{empresa.lema}</h1>
				<p class="bajada">
					<Pendiente texto="bajada de 1–2 líneas: qué hace LOLS y para quién" />
				</p>
				<div class="acciones">
					<a href="/contacto/" class="boton claro">Solicitar cotización</a>
					<a href="/proyectos/" class="boton contorno-claro">Ver proyectos</a>
				</div>
			</div>
			<div class="hero-foto marco">
				<Pendiente bloque texto="foto de obra propia, horizontal, alta resolución" />
			</div>
		</div>
	</section>

	<section class="cifras" aria-label="LOLS en cifras">
		<div class="contenedor cifras-grilla">
			<div>
				<p class="cifra"><Pendiente texto="años exactos" /></p>
				<p>años de experiencia</p>
			</div>
			<div>
				<p class="cifra"><Pendiente texto="n.º de obras" /></p>
				<p>obras ejecutadas</p>
			</div>
			<div>
				<p class="cifra">{servicios.length}</p>
				<p>áreas de servicio</p>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<p class="antetitulo">Servicios</p>
			<div class="cabecera">
				<h2>Lo que hacemos</h2>
				<a href="/servicios/">Todos los servicios →</a>
			</div>
			<ul class="servicios">
				{
					servicios.map((s) => (
						<li>
							<a href={`/servicios/${s.slug}/`} class="servicio">
								<Icono nombre={s.icono} />
								<h3>{s.nombre}</h3>
								<p>{s.resumen ?? <Pendiente texto="descripción breve" />}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="seccion gris">
		<div class="contenedor dos-columnas">
			<div class="foto-empresa marco">
				<Pendiente bloque texto="foto del equipo o de faena" />
			</div>
			<div>
				<p class="antetitulo">Empresa</p>
				<h2>{empresa.directrices}</h2>
				<ul class="principios">
					<li>
						<Pendiente revisar="recalcular: el texto es de 2018">Más de 20 años de experiencia</Pendiente> en el área de
						construcción.
					</li>
					<li>Un esquema de trabajo basado en el esfuerzo, la creatividad y la responsabilidad.</li>
					<li>Compromiso con las normas de seguridad y el respeto por el medio ambiente.</li>
				</ul>
				<a href="/empresa/" class="boton secundario">Conocer la empresa</a>
			</div>
		</div>
	</section>

	<section class="seccion">
		<div class="contenedor">
			<p class="antetitulo">Proyectos</p>
			<div class="cabecera">
				<h2>Obras recientes</h2>
				<a href="/proyectos/">Todos los proyectos →</a>
			</div>
			<div class="proyectos">
				{
					[1, 2, 3].map(() => (
						<article class="proyecto">
							<div class="proyecto-foto marco">
								<Pendiente bloque texto="foto" />
							</div>
							<h3>
								<Pendiente texto="nombre del proyecto" />
							</h3>
							<p>
								<Pendiente texto="comuna · año · servicio" />
							</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="contenedor cta-fila">
			<h2>¿Tiene un proyecto en mente?</h2>
			<a href="/contacto/" class="boton claro">Solicitar cotización</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--lols-verde-oscuro);
		color: var(--lols-blanco);
		padding-block: clamp(3.5rem, 9vw, 7rem);
	}
	.hero :global(.hero-fondo) {
		position: absolute;
		right: -6rem;
		top: 50%;
		width: 36rem;
		transform: translateY(-50%);
		color: var(--lols-verde);
		opacity: 0.35;
		pointer-events: none;
	}
	.hero-grilla {
		position: relative;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
	}
	.hero .antetitulo {
		color: var(--lols-lima);
	}
	.hero .antetitulo::before {
		background: var(--lols-lima);
	}
	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4.25rem);
	}
	.bajada {
		font-size: 1.2rem;
		max-width: 34rem;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.hero-foto {
		aspect-ratio: 4 / 3;
		border: 12px solid var(--lols-blanco);
		background: var(--lols-blanco);
		box-shadow: 18px 18px 0 var(--lols-verde);
	}

	.cifras {
		border-bottom: 1px solid #e2e2e2;
	}
	.cifras-grilla {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}
	.cifras-grilla > div {
		padding: 2rem 1.5rem;
		border-left: 1px solid #e2e2e2;
	}
	.cifras-grilla > div:first-child {
		border-left: 0;
		padding-left: 0;
	}
	.cifras p {
		margin: 0;
		color: var(--lols-gris);
	}
	.cifras .cifra {
		min-height: 3.5rem;
		font-family: var(--fuente-titulos);
		font-size: 3rem;
		font-weight: 700;
		line-height: 1.15;
		color: var(--lols-verde);
	}

	.cabecera {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}
	.cabecera h2 {
		margin: 0;
	}
	.cabecera a {
		font-weight: 600;
	}

	.servicios {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}
	.servicio {
		display: block;
		height: 100%;
		padding: 2rem;
		border: 1px solid #e2e2e2;
		border-top: 4px solid var(--lols-verde);
		border-radius: var(--radio);
		color: inherit;
		text-decoration: none;
		transition: box-shadow 0.2s, transform 0.2s;
	}
	.servicio:hover {
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.08);
		transform: translateY(-2px);
	}
	.servicio :global(.icono) {
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 1.25rem;
		color: var(--lols-verde);
	}
	.servicio p {
		margin: 0;
		color: var(--lols-gris);
	}

	.dos-columnas {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
	}
	.foto-empresa {
		aspect-ratio: 4 / 5;
		background: var(--lols-blanco);
	}
	.principios {
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.85rem;
	}
	.principios li {
		padding-left: 1.5rem;
		position: relative;
	}
	.principios li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.6rem;
		height: 0.6rem;
		background: var(--lols-verde);
	}

	.proyectos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.proyecto-foto {
		aspect-ratio: 4 / 3;
		margin-bottom: 1rem;
	}
	.proyecto h3 {
		margin-bottom: 0.25rem;
	}
	.proyecto p {
		color: var(--lols-gris);
	}

	.cta {
		background: var(--lols-verde-oscuro);
		color: var(--lols-blanco);
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}
	.cta-fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.cta h2 {
		margin: 0;
	}

	@media (max-width: 860px) {
		.hero-grilla,
		.dos-columnas {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero :global(.hero-fondo) {
			display: none;
		}
		.hero-foto {
			box-shadow: 10px 10px 0 var(--lols-verde);
			margin-right: 10px;
		}
		.servicios,
		.proyectos {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.servicios,
		.proyectos {
			grid-template-columns: minmax(0, 1fr);
		}
		.cifras-grilla {
			grid-template-columns: minmax(0, 1fr);
		}
		.cifras-grilla > div {
			border-left: 0;
			border-top: 1px solid #e2e2e2;
			padding: 1.5rem 0;
		}
		.cifras-grilla > div:first-child {
			border-top: 0;
		}
	}
</style>
