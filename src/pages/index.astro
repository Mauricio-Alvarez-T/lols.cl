---
// Portada: mostrar, no contar (docs/estructura.md § Mostrar, no contar). Cada sección es
// imagen + título y lleva a su página, donde está el detalle:
//   obra en video con el lema → cifras → servicios en fotos → obras en construcción →
//   seguridad (video + dos datos) → obras de clientes (foto y dirección) → contacto.
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import CarruselObras from '../components/CarruselObras.astro';
import { deProyecto, deMuestra } from '../data/carrusel';
import Contacto from '../components/Contacto.astro';
import { empresa, aniosTrayectoria, fundacion } from '../data/empresa';
import { proyectosPorEstado, obras2018Reales } from '../data/proyectos';
import MosaicoServicios from '../components/MosaicoServicios.astro';
import { obrasEnCurso, videos } from '../data/referencia';
import ObraPortada from '../components/ObraPortada.astro';
import BloqueSeguridad from '../components/BloqueSeguridad.astro';
import { ejemploBajadaHero, ejemplosContratados } from '../data/ejemplos';

const enObra = proyectosPorEstado('en-curso').slice(0, 3);
const contratados = proyectosPorEstado('contratado');
// Datos reales: años (fundación 1995), trabajadores (200, don Luis) y obras ejecutadas (70+,
// Marcos, 08-10-2026). Sin m² construidos: no hay registro (don Luis).
const cifras = [
	{ etiqueta: `años de trayectoria, desde ${fundacion}`, valor: String(aniosTrayectoria) },
	{ etiqueta: 'obras ejecutadas', valor: '70+' },
	{ etiqueta: 'trabajadores', valor: '200' },
];
---

<Base title="LOLS Ingeniería" description={`${empresa.razonSocial}. ${empresa.lema}.`}>
	<ObraPortada video={videos.portada}>
		<h1 class="display">{empresa.lema}<span class="punto">.</span></h1>
		<p class="bajada"><Pendiente texto="una frase: qué hace LOLS, para quién y dónde">{ejemploBajadaHero}</Pendiente></p>
		<div class="acciones">
			<a href="/proyectos/" class="boton">Ver proyectos</a>
			<a href="/contacto/" class="boton secundario">Cotizar</a>
		</div>
	</ObraPortada>

	<section class="cifras contenedor" aria-label="LOLS en cifras">
		{
			cifras.map((c) => (
				<div>
					<p class="numero">{c.valor}</p>
					<p>{c.etiqueta}</p>
				</div>
			))
		}
	</section>

	<section class="seccion">
		<div class="contenedor">
			<div class="cabecera">
				<h2>Servicios</h2>
				<a href="/servicios/" class="enlace-flecha">Todos los servicios</a>
			</div>
			<MosaicoServicios />
		</div>
	</section>

	<CarruselObras
		titulo="En obra ahora"
		enlace={{ href: '/proyectos/#en-construccion', texto: 'Todos los proyectos' }}
		obras={enObra.length ? enObra.map(deProyecto) : obrasEnCurso.map(deMuestra)}
	/>
	<div class="contenedor cartera-fila">
			<a href="/proyectos/#contratados" class="cartera">
				<span class="cartera-n">
					{contratados.length || <Pendiente texto="n.º de obras contratadas">{ejemplosContratados.length}</Pendiente>}
				</span>
				<span class="cartera-texto">
					obras contratadas que parten en los próximos meses
					<span class="enlace-flecha">Ver la cartera</span>
				</span>
			</a>
	</div>

	<BloqueSeguridad />

	<!-- Don Luis (08-10-2026): sin logos ni nombres; la foto del edificio y su dirección. -->
	<section class="seccion clientes">
		<div class="contenedor">
			<h2 class="clientes-titulo">Han confiado en nosotros</h2>
			<ul class="obras-clientes">
				{
					obras2018Reales.map((o) => (
						<li>
							<div class="marco">
								<img src={`/proyectos/${o.slug}/1.jpg`} alt={`Edificio en ${o.direccion}, Santiago`} loading="lazy" width="480" height="360" />
							</div>
							<p>{o.direccion}, Santiago</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Contacto />
</Base>

<style>
	.punto {
		color: var(--lols-verde);
	}

	.banda {
		aspect-ratio: 21 / 9;
		max-height: 80vh;
		width: 100%;
		background: #2a2a2a;
	}

	.cifras {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
	}
	.cifras > div {
		padding: 0 1.5rem;
		border-left: 1px solid var(--linea);
	}
	.cifras > div:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.cifras p {
		margin: 0;
		color: var(--gris-medio);
	}
	.cifras .numero {
		min-height: 4.5rem;
		display: flex;
		align-items: center;
		font-family: var(--fuente-titulos);
		font-size: clamp(2.25rem, 5vw, 4.25rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--lols-carbon);
	}


	.cartera-fila {
		padding-bottom: var(--seccion);
	}
	.cartera-fila .cartera {
		margin-top: 0;
	}
	/* Cartera contratada: una línea que muestra continuidad, con su número grande. */
	.cartera {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-block: 1.25rem;
		border-block: 1px solid var(--lols-carbon);
		color: var(--lols-carbon);
		text-decoration: none;
	}
	.cartera-n {
		font-family: var(--fuente-titulos);
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.cartera-texto {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1.25rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		font-weight: 600;
	}
	.cartera-texto .enlace-flecha {
		font-size: 1rem;
	}

	.clientes-titulo {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		margin-bottom: 2rem;
	}
	.obras-clientes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2rem) clamp(1rem, 2vw, 1.5rem);
	}
	.obras-clientes .marco {
		aspect-ratio: 4 / 3;
		margin-bottom: 0.75rem;
	}
	.obras-clientes img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.obras-clientes p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--lols-gris);
	}

	@media (max-width: 960px) {
		.cifras {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
		.cifras > div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.obras-clientes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.banda {
			aspect-ratio: 4 / 3;
		}
		.obras-clientes {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
