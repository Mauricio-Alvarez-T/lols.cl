---
// Portada: mostrar, no contar (docs/estructura.md § Mostrar, no contar). Cada sección es
// imagen + título y lleva a su página, donde está el detalle:
//   obra en video con el lema → qué hacemos en tres líneas → cifras → servicios en fotos →
//   obras en construcción → la próxima obra en grande y la cartera → seguridad (video + dos
//   datos) → obras de clientes (foto y dirección, en el mismo carrusel de las obras) → contacto.
// Movimiento al estilo de las páginas de producto de Apple (pedido de Marcos, 16-10-2026;
// docs/estructura.md § Dirección visual): la obra se achica a lámina al bajar, el texto se
// enciende por líneas, las cifras suben y la próxima obra se expande. Todo con CSS ligado al
// scroll; sin soporte o con "reducir movimiento" se ve quieto y completo.
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import CarruselObras from '../components/CarruselObras.astro';
import { deProyecto, deMuestra, deConfianza } from '../data/carrusel';
import Contacto from '../components/Contacto.astro';
import { empresa, aniosTrayectoria, fundacion, servicios } from '../data/empresa';
import { proyectos, proyectosPorEstado, obrasConfianza } from '../data/proyectos';
import MosaicoServicios from '../components/MosaicoServicios.astro';
import { obrasEnCurso, videos } from '../data/referencia';
import ObraPortada from '../components/ObraPortada.astro';
import BloqueSeguridad from '../components/BloqueSeguridad.astro';
import { ejemploBajadaHero, ejemplosContratados } from '../data/ejemplos';

const enObra = proyectosPorEstado('en-curso').slice(0, 3);
const contratados = proyectosPorEstado('contratado');
// Datos reales: años (fundación 1995), trabajadores (200, don Luis) y obras ejecutadas (70+,
// Marcos, 08-10-2026). Sin m² construidos: no hay registro (don Luis). Al llegar a ellas cuentan
// desde 0 (Marcos, 19-10-2026; script al final); el HTML ya trae el número final.
const cifras = [
	{ etiqueta: `años de trayectoria, desde ${fundacion}`, valor: aniosTrayectoria, sufijo: '' },
	{ etiqueta: 'obras ejecutadas', valor: 70, sufijo: '+' },
	{ etiqueta: 'trabajadores', valor: 200, sufijo: '' },
];

// "Construcción, montaje industrial y electricidad." con los servicios vigentes.
const nombresServicios = servicios.map((s, i) => (i === 0 ? s.nombre : s.nombre.toLowerCase()));
const queHacemos = `${nombresServicios.slice(0, -1).join(', ')} y ${nombresServicios.at(-1)}.`;

// La próxima obra en grande: la contratada más grande, con su render.
const proxima = proyectos.find((p) => p.slug === 'buzeta-3810');
---

<Base title="LOLS Ingeniería" description={`${empresa.razonSocial}. ${empresa.lema}.`}>
	<div class="portada-fija">
		<ObraPortada video={videos.portada}>
			<h1 class="display">{empresa.lema}<span class="punto">.</span></h1>
			<p class="bajada"><Pendiente texto="una frase: qué hace LOLS, para quién y dónde">{ejemploBajadaHero}</Pendiente></p>
			<div class="acciones">
				<a href="/proyectos/" class="boton">Ver proyectos</a>
				<a href="/contacto/" class="boton secundario">Cotizar</a>
			</div>
		</ObraPortada>
	</div>

	<section class="manifiesto contenedor" aria-label="Qué hacemos">
		<p class="manifiesto-texto">
			<span class="linea">{queHacemos}</span>
			<span class="linea">Desde {fundacion}, en Santiago.</span>
			<span class="linea">Con 200 trabajadores y equipos propios.</span>
		</p>
	</section>

	<section class="seccion oscura cifras-seccion" aria-label="LOLS en cifras">
		<div class="contenedor cifras">
			{
				cifras.map((c) => (
					<div class="cifra">
						<p class="numero">
							<span class="sr-only">{c.valor}{c.sufijo}</span>
							<span aria-hidden="true" data-contar={c.valor} data-sufijo={c.sufijo}>{c.valor}{c.sufijo}</span>
						</p>
						<p class="cifra-texto">{c.etiqueta}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="seccion servicios-portada">
		<div class="contenedor">
			<div class="cabecera">
				<h2>Servicios</h2>
				<a href="/servicios/" class="enlace-flecha">Todos los servicios</a>
			</div>
			<MosaicoServicios />
		</div>
	</section>

	<CarruselObras
		titulo="En obra ahora"
		enlace={{ href: '/proyectos/#en-construccion', texto: 'Todos los proyectos' }}
		obras={enObra.length ? enObra.map(deProyecto) : obrasEnCurso.map(deMuestra)}
	/>

	{
		proxima && (
			<section class="proxima" aria-label="La próxima obra">
				<figure class="proxima-foto marco">
					<img src={`/proyectos/${proxima.slug}/1.jpg`} alt={`Render del ${(proxima.tipo ?? 'proyecto').toLowerCase()} de ${proxima.nombre}`} loading="lazy" />
				</figure>
				<p class="contenedor proxima-pie">
					{[proxima.nombre, proxima.tipo, proxima.comuna, proxima.superficie].filter(Boolean).join(' · ')} · render del proyecto
				</p>
			</section>
		)
	}
	<div class="contenedor cartera-fila">
			<a href="/proyectos/#contratados" class="cartera">
				<span class="cartera-n">
					{contratados.length || <Pendiente texto="n.º de obras contratadas">{ejemplosContratados.length}</Pendiente>}
				</span>
				<span class="cartera-texto">
					obras en proyecto, las próximas en construirse
					<span class="enlace-flecha">Ver cuáles</span>
				</span>
			</a>
	</div>

	<BloqueSeguridad />

	<!-- Don Luis (08-10-2026): sin logos ni nombres; la foto del edificio y su dirección. En el
	     mismo carrusel que "En obra ahora" (Marcos, 20-10-2026: las fotos se ven mejor así). -->
	<CarruselObras titulo="Han confiado en nosotros" id="han-confiado" obras={obrasConfianza.map(deConfianza)} />

	<Contacto />
</Base>

<script>
	// Cifras: cuentan desde 0 hasta su valor cuando aparecen en pantalla, una sola vez por visita
	// (el sufijo "+" llega al final). Sin JS, sin IntersectionObserver o con "reducir movimiento"
	// (sin html.anim) se ve el número final de siempre. Los lectores de pantalla leen el número
	// fijo de al lado (.sr-only), no la cuenta.
	const contadores = document.querySelectorAll<HTMLElement>('[data-contar]');
	if (contadores.length && 'IntersectionObserver' in window && document.documentElement.classList.contains('anim')) {
		const duracion = 1600;
		const contar = (el: HTMLElement) => {
			const final = Number(el.dataset.contar);
			const inicio = performance.now();
			const paso = (ahora: number) => {
				const t = Math.min((ahora - inicio) / duracion, 1);
				// Rápido al principio y se frena al llegar (ease-out cúbico).
				const valor = Math.round(final * (1 - Math.pow(1 - t, 3)));
				el.textContent = t < 1 ? String(valor) : final + (el.dataset.sufijo ?? '');
				if (t < 1) requestAnimationFrame(paso);
			};
			requestAnimationFrame(paso);
		};
		const observador = new IntersectionObserver(
			(entradas) => {
				for (const e of entradas) {
					if (!e.isIntersecting) continue;
					observador.unobserve(e.target);
					contar(e.target as HTMLElement);
				}
			},
			{ threshold: 0.6 },
		);
		for (const el of contadores) {
			el.textContent = '0';
			observador.observe(el);
		}
	}
</script>

<style>
	.punto {
		color: var(--lols-verde);
	}

	/* Qué hacemos: tres líneas grandes, como en las páginas de producto de Apple. Centradas
	   (Marcos, 20-10-2026), en computador y en celular. */
	.manifiesto {
		padding-block: clamp(5rem, 14vw, 10rem);
	}
	.manifiesto-texto {
		margin: 0 auto;
		max-width: 21ch;
		text-align: center;
		font-family: var(--fuente-titulos);
		font-optical-sizing: auto;
		font-size: clamp(2rem, 0.9rem + 4.2vw, 4.5rem);
		font-weight: 750;
		line-height: 1.06;
		letter-spacing: -0.04em;
		text-wrap: balance;
		color: var(--lols-carbon);
	}
	.linea {
		display: block;
		margin-bottom: 0.2em;
	}

	/* Cifras: grandes, sobre carbón, en el verde de la marca. Un solo verde, sin degradado al
	   lima (Marcos, 20-10-2026: "del mismo verde, no de distintos tonos"). */
	.cifras {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.cifra {
		padding: 0 clamp(1rem, 3vw, 2.5rem);
		border-left: 1px solid #343b36;
	}
	.cifra:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.cifras p {
		margin: 0;
	}
	.cifras .numero {
		font-family: var(--fuente-titulos);
		font-optical-sizing: auto;
		font-size: clamp(4rem, 1.5rem + 8vw, 10rem);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.06em;
		font-variant-numeric: tabular-nums;
		color: var(--lols-verde);
	}
	.cifras .cifra-texto {
		margin-top: 0.75rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.4rem);
		font-weight: 600;
		color: #c9cfca;
	}

	/* La próxima obra: la foto entra angosta y se abre a todo el ancho. */
	.proxima {
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}
	.proxima-foto {
		margin: 0;
		height: clamp(18rem, 56vw, 44rem);
	}
	.proxima-pie {
		margin-top: 0.75rem;
		font-family: var(--fuente-datos);
		font-size: 0.95rem;
		color: var(--gris-medio);
	}

	.cartera-fila {
		padding-bottom: var(--seccion);
	}
	.cartera-fila .cartera {
		margin-top: 0;
	}
	/* Cartera contratada: una línea que muestra continuidad, con su número grande. */
	.cartera {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-block: 1.25rem;
		border-block: 1px solid var(--lols-carbon);
		color: var(--lols-carbon);
		text-decoration: none;
	}
	.cartera-n {
		font-family: var(--fuente-titulos);
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.cartera-texto {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1.25rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		font-weight: 600;
	}
	.cartera-texto .enlace-flecha {
		font-size: 1rem;
	}

	@media (max-width: 760px) {
		.cifras {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
		.cifra {
			padding: 2.5rem 0 0;
			border-left: 0;
			border-top: 1px solid #343b36;
		}
		.cifra:first-child {
			padding-top: 0;
			border-top: 0;
		}
	}

	/* ---------- Movimiento ligado al scroll ----------
	   Solo si el navegador lo soporta y no se pidió reducir movimiento (html.anim, Base.astro).
	   Sin eso, todo queda quieto y completo: ningún contenido depende de JS ni de llegar a él
	   para verse. Solo opacity y transform (fluido en celulares modestos). Propiedades sueltas, sin el atajo
	   "animation": el minificador lo junta con animation-timeline y Chrome descarta la línea. */
	@supports (animation-timeline: view()) {
		/* La obra de la portada queda fija y se achica a lámina mientras el texto se va. */
		:global(.anim) .portada-fija {
			height: 175svh;
			view-timeline: --portada block;
		}
		:global(.anim) .portada-fija :global(.hero-obra) {
			position: sticky;
			top: 0;
			/* Mientras queda fija ocupa la pantalla entera: si no, asoma una franja vacía abajo. */
			min-height: 100svh;
			/* Se achica hacia abajo para que el borde de arriba no quede bajo el encabezado. */
			transform-origin: 50% 80%;
			animation-name: portada-achicar;
			animation-timeline: --portada;
			animation-range: contain 0% contain 100%;
		}
		:global(.anim) .portada-fija :global(.hero-obra > .contenido) {
			animation-name: portada-salir;
			animation-timeline: --portada;
			animation-range: contain 0% contain 50%;
		}
		/* En celular la barra de contacto ocupa el borde de abajo: el texto sube sobre ella. */
		@media (max-width: 767px) {
			:global(.anim) .portada-fija :global(.hero-obra > .contenido) {
				padding-bottom: calc(clamp(3rem, 8vw, 5.5rem) + 4.5rem);
			}
		}
		:global(.anim) .portada-fija :global(.hero-obra),
		:global(.anim) .portada-fija :global(.hero-obra > .contenido),
		:global(.anim) .linea,
		:global(.anim) .cifra,
		:global(.anim) .servicios-portada :global(.mosaico > .item),
		:global(.anim) .proxima-foto,
		:global(.anim) .proxima-foto img {
			animation-timing-function: linear;
			animation-fill-mode: both;
		}
		/* Qué hacemos: cada línea pasa de gris a carbón al llegar al centro. */
		:global(.anim) .linea {
			animation-name: encender;
			animation-timeline: view();
			animation-range: entry 40% cover 50%;
		}
		:global(.anim) .cifra,
		:global(.anim) .servicios-portada :global(.mosaico > .item) {
			animation-name: subir-scroll;
			animation-timeline: view();
			animation-range: entry 0% cover 30%;
		}
		:global(.anim) .proxima-foto {
			animation-name: abrir;
			animation-timeline: view();
			animation-range: entry 0% cover 50%;
		}
		:global(.anim) .proxima-foto img {
			animation-name: acomodar;
			animation-timeline: view();
			/* "cover" = de que asoma a que sale (escrito como "entry 0% exit 100%" el
			   minificador lo corta en "exit 0%"). */
			animation-range: cover 0% cover 100%;
		}
	}
	@keyframes portada-achicar {
		to {
			transform: scale(0.86);
		}
	}
	@keyframes portada-salir {
		to {
			opacity: 0;
			transform: translateY(-8vh);
		}
	}
	@keyframes encender {
		from {
			opacity: 0.22;
		}
	}
	@keyframes subir-scroll {
		from {
			opacity: 0;
			transform: translateY(8vh);
		}
	}
	@keyframes abrir {
		from {
			transform: scale(0.78);
		}
	}
	@keyframes acomodar {
		from {
			transform: scale(1.18);
		}
		to {
			transform: scale(1);
		}
	}
</style>
