---
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
---

<Base title="Proyectos">
	<header class="encabezado-pagina">
		<div class="contenedor">
			<p class="antetitulo">Proyectos</p>
			<h1>Nuestras obras</h1>
			<p><Pendiente texto="introducción al portafolio" /></p>
		</div>
	</header>

	<section class="seccion">
		<div class="contenedor">
			<Pendiente
				bloque
				texto="listado de 6 a 12 proyectos con ficha: nombre · mandante · comuna · año · servicios · magnitud · 3–12 fotos · estado"
			/>
		</div>
	</section>
</Base>
