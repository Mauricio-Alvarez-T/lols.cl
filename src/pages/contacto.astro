---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import { empresa, telefonoHref, whatsappHref } from '../data/empresa';
import Proceso from '../components/Proceso.astro';
import ObraPortada from '../components/ObraPortada.astro';
import { bandas } from '../data/referencia';
---

<Base title="Contacto" description="Solicite una cotización a LOLS Ingeniería.">
	<ObraPortada imagen={bandas.contacto} baja>
		<p class="etiqueta">Contacto</p>
		<h1 class="display largo">Hablemos de su proyecto</h1>
		<p class="bajada">Cuéntenos qué necesita: después de recibir su solicitud, nos ponemos en contacto con usted. Si prefiere, escríbanos por WhatsApp.</p>
		<p class="canales">
			<a class="boton" href={whatsappHref()} target="_blank" rel="noopener">Escribir por WhatsApp</a>
			<a class="boton secundario" href={telefonoHref(empresa.telefono.valor)}>Llamar</a>
		</p>
	</ObraPortada>

	<section class="seccion contenedor columnas">
		<div>
			<h2>Solicitar cotización</h2>
			<FormularioContacto />
		</div>
		<aside>
			<dl class="datos vertical">
				<!-- Sin "Quién atiende": no van nombres de personas (don Luis, 08-10-2026). -->
				<div>
					<dt>Teléfono</dt>
					<dd><a href={telefonoHref(empresa.telefono.valor)}>{empresa.telefono.valor}</a></dd>
				</div>
				<div>
					<dt>Correo</dt>
					<dd><a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a></dd>
				</div>
				<div>
					<dt>Horario</dt>
					<dd>{empresa.horario}</dd>
				</div>
				<div>
					<dt>Oficina</dt>
					<dd>{empresa.direccion.valor}</dd>
				</div>
			</dl>
			<div class="despues">
				<Proceso titulo="Qué pasa después" compacto />
			</div>
			<div class="mapa marco">
				<iframe
					title="Mapa: Philippi 36, Santiago"
					src="https://www.openstreetmap.org/export/embed.html?bbox=-70.6813%2C-33.4543%2C-70.6654%2C-33.4463&layer=mapnik&marker=-33.45030%2C-70.67339"
					loading="lazy"
					referrerpolicy="no-referrer"></iframe>
			</div>
			<a class="ver-mapa" href="https://www.openstreetmap.org/?mlat=-33.45030&mlon=-70.67339#map=17/-33.45030/-70.67339">Ver en el mapa</a>
		</aside>
	</section>

	<section class="contenedor derivar">
		<p>¿Busca trabajo? <a href="/trabaja-con-nosotros/">Trabaja con nosotros</a></p>
	</section>
</Base>

<style>
	.columnas {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		padding-top: 0;
	}
	.columnas h2 {
		font-size: 1.75rem;
		letter-spacing: -0.02em;
	}
	.vertical {
		grid-template-columns: minmax(0, 1fr);
		margin-bottom: 2rem;
	}
	.canales {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.despues {
		margin-bottom: 2rem;
	}
	.derivar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.5rem;
		padding-block: 0 var(--seccion);
		color: var(--lols-gris);
	}
	.derivar p {
		margin: 0;
	}
	.derivar a {
		font-weight: 600;
	}
	.mapa {
		aspect-ratio: 4 / 3;
	}
	.mapa iframe {
		width: 100%;
		height: 100%;
		border: 0;
		filter: grayscale(0.6);
	}
	.ver-mapa {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.9rem;
	}
	@media (max-width: 860px) {
		.columnas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
