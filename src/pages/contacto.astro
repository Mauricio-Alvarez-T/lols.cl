---
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import { empresa, telefonoHref } from '../data/empresa';
---

<Base title="Contacto" description="Solicite una cotización a LOLS Ingeniería.">
	<header class="portadilla contenedor">
		<p class="etiqueta">Contacto</p>
		<h1>Hablemos de su proyecto</h1>
	</header>

	<section class="seccion contenedor columnas">
		<div>
			<h2>Solicitar cotización</h2>
			<FormularioContacto />
		</div>
		<aside>
			<dl class="datos vertical">
				<div>
					<dt>Quién atiende</dt>
					<dd><Pendiente texto="nombre y cargo" /></dd>
				</div>
				<div>
					<dt>Teléfono</dt>
					<dd>
						<Pendiente revisar={empresa.telefono.revisar}>
							<a href={telefonoHref(empresa.telefono.valor)}>{empresa.telefono.valor}</a>
						</Pendiente>
					</dd>
				</div>
				<div>
					<dt>Correo</dt>
					<dd>
						<Pendiente revisar={empresa.correo.revisar}>
							<a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a>
						</Pendiente>
					</dd>
				</div>
				<div>
					<dt>Oficina</dt>
					<dd><Pendiente revisar={empresa.direccion.revisar}>{empresa.direccion.valor}</Pendiente></dd>
				</div>
			</dl>
			<div class="mapa marco">
				<Pendiente bloque texto="mapa" />
			</div>
		</aside>
	</section>
</Base>

<style>
	.columnas {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		padding-top: 0;
	}
	.columnas h2 {
		font-size: 1.75rem;
		letter-spacing: -0.02em;
	}
	.vertical {
		grid-template-columns: minmax(0, 1fr);
		margin-bottom: 2rem;
	}
	.mapa {
		aspect-ratio: 4 / 3;
	}
	@media (max-width: 860px) {
		.columnas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
