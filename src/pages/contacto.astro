---
// Contacto (Marcos, 20-10-2026): los datos de la empresa — teléfono, WhatsApp, correo, horario y
// la oficina con su mapa. La solicitud de cotización se fue a /cotizar/: antes estaban juntas, y
// el ítem «Contacto» del menú y el botón «Cotizar» llevaban a la misma página con lo mismo.
// Cierra con «Hablemos de su proyecto», que lleva a /cotizar/.
// Enlaces viejos a la cotización (/contacto/?servicio=…, ?enviado, ?error o #formulario) siguen
// a /cotizar/ con lo que traían.
import Base from '../layouts/Base.astro';
import Contacto from '../components/Contacto.astro';
import ObraPortada from '../components/ObraPortada.astro';
import { empresa, telefonoHref, whatsappHref } from '../data/empresa';
import { bandas } from '../data/referencia';

const horario = empresa.horario.charAt(0).toLowerCase() + empresa.horario.slice(1);
---

<Base title="Contacto" description="Teléfono, WhatsApp, correo, horario y oficina de LOLS Ingeniería en Santiago.">
	<script is:inline>
		(function () {
			var s = location.search, h = location.hash;
			if (!/[?&](servicio|enviado|error)=/.test(s) && h !== '#formulario') return;
			// Sin la transición entre páginas: esta página ni se alcanza a mostrar.
			addEventListener('pageswap', function (e) { if (e.viewTransition) e.viewTransition.skipTransition(); });
			location.replace('/cotizar/' + s + h);
		})();
	</script>
	<ObraPortada imagen={bandas.oficina} baja>
		<p class="etiqueta">Contacto</p>
		<h1 class="display largo">Estamos en Santiago</h1>
		<p class="bajada">Oficina en {empresa.direccion.valor}. Atendemos de {horario}.</p>
		<p class="canales">
			{empresa.whatsapp && <a class="boton" href={whatsappHref()} target="_blank" rel="noopener">Escribir por WhatsApp</a>}
			<a class="boton secundario" href={telefonoHref(empresa.telefono.valor)}>Llamar</a>
		</p>
	</ObraPortada>
	<section class="seccion contenedor columnas">
		<div>
			<h2>Datos de contacto</h2>
			<dl class="datos vertical">
				<div>
					<dt>Teléfono</dt>
					<dd><a href={telefonoHref(empresa.telefono.valor)}>{empresa.telefono.valor}</a></dd>
				</div>
				{
					empresa.whatsapp && (
						<div>
							<dt>WhatsApp</dt>
							<dd><a href={whatsappHref()} target="_blank" rel="noopener">Escribir por WhatsApp</a></dd>
						</div>
					)
				}
				<div>
					<dt>Correo</dt>
					<dd><a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a></dd>
				</div>
				<div>
					<dt>Horario</dt>
					<dd>{empresa.horario}</dd>
				</div>
				<div>
					<dt>Oficina</dt>
					<dd>{empresa.direccion.valor}</dd>
				</div>
				<div>
					<dt>Razón social</dt>
					<dd>{empresa.razonSocial} · RUT {empresa.rut}</dd>
				</div>
			</dl>
		</div>
		<div>
			<h2>Cómo llegar</h2>
			<div class="mapa marco">
				<iframe
					title={`Mapa: ${empresa.direccion.valor}`}
					src="https://www.openstreetmap.org/export/embed.html?bbox=-70.6813%2C-33.4543%2C-70.6654%2C-33.4463&layer=mapnik&marker=-33.45030%2C-70.67339"
					loading="lazy"
					referrerpolicy="no-referrer"></iframe>
			</div>
			<a class="ver-mapa" href="https://www.openstreetmap.org/?mlat=-33.45030&mlon=-70.67339#map=17/-33.45030/-70.67339">Ver en el mapa</a>
		</div>
	</section>
	<section class="contenedor derivar">
		<p>¿Busca trabajo? <a href="/trabaja-con-nosotros/">Trabaja con nosotros</a></p>
	</section>
	<Contacto />
</Base>

<style>
	.columnas {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: clamp(2rem, 6vw, 5rem);
		padding-top: 0;
	}
	.columnas h2 {
		margin-bottom: 1.25rem;
		font-size: 1.75rem;
		letter-spacing: -0.02em;
	}
	.vertical {
		grid-template-columns: minmax(0, 1fr);
	}
	/* Aquí los datos son lo principal: más grandes que en una ficha. */
	.vertical dd {
		font-size: 1.25rem;
		overflow-wrap: anywhere;
	}
	.vertical > div {
		padding-block: 0.9rem 1rem;
	}
	.canales {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.derivar {
		padding-block: 0 var(--seccion);
		color: var(--lols-gris);
	}
	.derivar p {
		margin: 0;
	}
	.derivar a {
		font-weight: 600;
	}
	.mapa {
		aspect-ratio: 4 / 3;
	}
	.mapa iframe {
		width: 100%;
		height: 100%;
		border: 0;
		filter: grayscale(0.6);
	}
	.ver-mapa {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.9rem;
	}
	@media (max-width: 860px) {
		.columnas {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
