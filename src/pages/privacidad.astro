---
import Base from '../layouts/Base.astro';
import Pendiente from '../components/Pendiente.astro';
---

<Base title="Política de privacidad">
	<header class="portadilla contenedor">
		<h1>Política de privacidad</h1>
	</header>

	<section class="seccion contenedor">
		<div class="texto">
			<Pendiente
				bloque
				texto="texto legal (Ley 21.719, vigente desde el 1-dic-2026): finalidad de los datos, plazo de conservación y cómo ejercer los derechos. Lo revisa quien vea lo legal."
			/>
		</div>
	</section>
</Base>

<style>
	.texto {
		max-width: 48rem;
	}
</style>
